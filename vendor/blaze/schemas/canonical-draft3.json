{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tag:sourcemeta.com,2026:canonical:draft3",
  "title": "Canonical JSON Schema Draft 3",
  "description": "Meta-schema that validates whether a given JSON Schema Draft 3 document is in canonical form",
  "examples": [
    {
      "extends": [
        {
          "$ref": "#/definitions/0"
        }
      ],
      "definitions": {
        "0": {
          "enum": [ 1, 2, 3 ]
        }
      }
    }
  ],
  "$ref": "#/$defs/document",
