          "type": "string"
        },
        "extends": {
          "type": "array",
          "maxItems": 1,
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "definitions": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/node"
          }
        }
      },
      "additionalProperties": false
    },
    "edge": {
      "x-lint-exclude": "simple_properties_identifiers",
      "type": "object",
      "required": [ "$ref" ],
      "properties": {
        "$ref": {
          "type": "string",
          "pattern": "^#/definitions/(0|[1-9][0-9]*)$"
        }
