// Invalid CLI arguments
RUN encode STDIN /dev/null IN . INTO result.txt EXPECTING 5

WRITE expected.txt UNTIL EOF
2> error: This command expects a path to a JSON document and an output path
2>
2> For example: jsonschema encode path/to/document.json path/to/output.binpack
EOF

COMPARE result.txt AGAINST expected.txt

// Invalid CLI arguments
RUN encode --json STDIN /dev/null IN . INTO result_json.txt EXPECTING 5

WRITE expected_json.txt UNTIL EOF
1> {
1>   "error": "This command expects a path to a JSON document and an output path"
1> }
EOF

COMPARE result_json.txt AGAINST expected_json.txt
