WRITE document.jsonl UNTIL EOF
{ "count": 1 }
{ "count": 2 }
{ "count": 3 }
{ "count": 4 }
{ "count": 5 }
EOF

RUN encode document.jsonl output.binpack --verbose STDIN /dev/null IN . INTO result.txt EXPECTING 0

REPLACE '\\\\' WITH '/' IN result.txt
REPLACE '\\(?!")' WITH '/' IN result.txt
REPLACE $CWD WITH '[CWD]' IN result.txt

WRITE expected.txt UNTIL EOF
2> original file size: 75 bytes
2> Interpreting input as JSONL: [CWD]/document.jsonl
2> Encoding entry #0
2> Encoding entry #1
2> Encoding entry #2
2> Encoding entry #3
2> Encoding entry #4
2> encoded file size: 24 bytes
2> compression ratio: 32%
EOF

COMPARE result.txt AGAINST expected.txt

// The exact byte layout is not asserted here, so prove the round trip instead
RUN decode output.binpack roundtrip.jsonl STDIN /dev/null IN . INTO decoded.txt EXPECTING 0

WRITE expected_roundtrip.jsonl UNTIL EOF
{
  "count": 1
}
{
  "count": 2
}
{
  "count": 3
}
{
  "count": 4
}
{
  "count": 5
}
EOF

COMPARE roundtrip.jsonl AGAINST expected_roundtrip.jsonl

WRITE expected_decoded.txt UNTIL EOF
EOF

COMPARE decoded.txt AGAINST expected_decoded.txt
