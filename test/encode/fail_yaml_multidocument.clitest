WRITE document.yaml UNTIL EOF
$schema: https://json-schema.org/draft/2020-12/schema
type: string
---
$schema: https://json-schema.org/draft/2020-12/schema
type: integer
EOF

// Not supported
RUN encode document.yaml output.bin STDIN /dev/null IN . INTO result.txt EXPECTING 3

REPLACE $CWD WITH '[CWD]' IN result.txt

WRITE expected_0.txt UNTIL EOF
2> original file size: 139 bytes
2> error: This command does not support input with multiple documents
2>   at file path [CWD]/document.yaml
EOF

COMPARE result.txt AGAINST expected_0.txt

// Not supported
RUN encode document.yaml output.bin --json STDIN /dev/null IN . INTO result_json.txt EXPECTING 3

REPLACE $CWD WITH '[CWD]' IN result_json.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "This command does not support input with multiple documents",
1>   "filePath": "[CWD]/document.yaml"
1> }
2> original file size: 139 bytes
EOF

COMPARE result_json.txt AGAINST expected_1.txt
