// Invalid CLI arguments
RUN codegen STDIN /dev/null IN . INTO result.txt EXPECTING 5

WRITE expected_0.txt UNTIL EOF
2> error: This command expects a path to a schema
2>
2> For example: jsonschema codegen path/to/schema.json --name MyType --target typescript
EOF

COMPARE result.txt AGAINST expected_0.txt

// Invalid CLI arguments
RUN codegen --json STDIN /dev/null IN . INTO result_json.txt EXPECTING 5

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "This command expects a path to a schema"
1> }
EOF

COMPARE result_json.txt AGAINST expected_1.txt
