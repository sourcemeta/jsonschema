WRITE schema.json UNTIL EOF
{
  "type" string
}
EOF

// Other input error
RUN codegen schema.json --target typescript STDIN /dev/null IN . INTO result.txt EXPECTING 6

REPLACE $CWD WITH '[CWD]' IN result.txt

WRITE expected_0.txt UNTIL EOF
2> error: Failed to parse the JSON document
2>   at line 2
2>   at column 10
2>   at file path [CWD]/schema.json
EOF

COMPARE result.txt AGAINST expected_0.txt

// Other input error
RUN codegen schema.json --target typescript --json STDIN /dev/null IN . INTO result_json.txt EXPECTING 6

REPLACE $CWD WITH '[CWD]' IN result_json.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "Failed to parse the JSON document",
1>   "line": 2,
1>   "column": 10,
1>   "filePath": "[CWD]/schema.json"
1> }
EOF

COMPARE result_json.txt AGAINST expected_1.txt
