WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/dangling",
  "$ref": "#/$defs/missing"
}
EOF

// Schema input error
RUN codegen schema.json --target typescript STDIN /dev/null IN . INTO result.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result.txt

WRITE expected_0.txt UNTIL EOF
2> error: Could not resolve schema reference
2>   at identifier https://example.com/dangling#/$defs/missing
2>   at line 4
2>   at column 3
2>   at file path [CWD]/schema.json
2>   at location "/$ref"
EOF

COMPARE result.txt AGAINST expected_0.txt

// Schema input error
RUN codegen schema.json --target typescript --json STDIN /dev/null IN . INTO result_json.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_json.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "Could not resolve schema reference",
1>   "identifier": "https://example.com/dangling#/$defs/missing",
1>   "line": 4,
1>   "column": 3,
1>   "filePath": "[CWD]/schema.json",
1>   "location": "/$ref"
1> }
EOF

COMPARE result_json.txt AGAINST expected_1.txt
