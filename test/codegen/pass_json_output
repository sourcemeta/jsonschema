WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "string"
}
EOF

RUN codegen schema.json --target typescript --json STDIN /dev/null IN . INTO result.txt EXPECTING 0

WRITE expected.txt UNTIL EOF
1> {
1>   "code": "export type Schema = string;\n"
1> }
EOF

COMPARE result.txt AGAINST expected.txt
