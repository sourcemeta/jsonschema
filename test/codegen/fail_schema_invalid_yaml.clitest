WRITE schema.yaml UNTIL EOF
type: string
---
type: integer
EOF

// Other input error
RUN codegen schema.yaml --target typescript STDIN /dev/null IN . INTO result.txt EXPECTING 6
REPLACE '\\\\' WITH '/' IN result.txt
REPLACE '\\(?!")' WITH '/' IN result.txt

REPLACE $CWD WITH '[CWD]' IN result.txt

WRITE expected_0.txt UNTIL EOF
2> error: Unexpected content after document
2>   at line 3
2>   at column 1
2>   at file path [CWD]/schema.yaml
EOF

COMPARE result.txt AGAINST expected_0.txt

// Other input error
RUN codegen schema.yaml --target typescript --json STDIN /dev/null IN . INTO result_json.txt EXPECTING 6
REPLACE '\\\\' WITH '/' IN result_json.txt
REPLACE '\\(?!")' WITH '/' IN result_json.txt

REPLACE $CWD WITH '[CWD]' IN result_json.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "Unexpected content after document",
1>   "line": 3,
1>   "column": 1,
1>   "filePath": "[CWD]/schema.yaml"
1> }
EOF

COMPARE result_json.txt AGAINST expected_1.txt
