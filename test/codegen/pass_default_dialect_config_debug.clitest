WRITE schema.json UNTIL EOF
{
  "type": "string"
}
EOF

WRITE jsonschema.json UNTIL EOF
{
  "defaultDialect": "https://json-schema.org/draft/2020-12/schema"
}
EOF

RUN codegen schema.json --target typescript --debug STDIN /dev/null IN . INTO result.txt EXPECTING 0
REPLACE '\\\\' WITH '/' IN result.txt
REPLACE '\\(?!")' WITH '/' IN result.txt

REPLACE $CWD WITH '[CWD]' IN result.txt

WRITE expected.txt UNTIL EOF
1> export type Schema = string;
2> debug: Using configuration file: [CWD]/jsonschema.json
EOF

COMPARE result.txt AGAINST expected.txt
