WRITE schema.yaml UNTIL EOF
$schema: https://json-schema.org/draft/2020-12/schema
type: string
---
$schema: https://json-schema.org/draft/2020-12/schema
type: integer
EOF

// Not supported
RUN codegen schema.yaml --target typescript STDIN /dev/null IN . INTO result.txt EXPECTING 3

REPLACE $CWD WITH '[CWD]' IN result.txt

WRITE expected_0.txt UNTIL EOF
2> error: This command does not support input with multiple documents
2>   at file path [CWD]/schema.yaml
EOF

COMPARE result.txt AGAINST expected_0.txt

// Not supported
RUN codegen schema.yaml --target typescript --json STDIN /dev/null IN . INTO result_json.txt EXPECTING 3

REPLACE $CWD WITH '[CWD]' IN result_json.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "This command does not support input with multiple documents",
1>   "filePath": "[CWD]/schema.yaml"
1> }
EOF

COMPARE result_json.txt AGAINST expected_1.txt
