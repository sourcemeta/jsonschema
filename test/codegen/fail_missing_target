WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "string"
}
EOF

// Invalid CLI arguments
RUN codegen schema.json STDIN /dev/null IN . INTO result.txt EXPECTING 5

WRITE expected_0.txt UNTIL EOF
2> error: You must pass a target using the `--target/-t` option
EOF

COMPARE result.txt AGAINST expected_0.txt

// Invalid CLI arguments
RUN codegen schema.json --json STDIN /dev/null IN . INTO result_json.txt EXPECTING 5

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "You must pass a target using the `--target/-t` option"
1> }
EOF

COMPARE result_json.txt AGAINST expected_1.txt
