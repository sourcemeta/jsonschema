// A locally supplied embedded identifier written relative to its container
// must be shielded from remote fetching whichever of `$id` or `id` identifies
// that container, even when the container carries the other keyword too with
// an unrelated value. Two `--resolve` documents each embed, under a relative
// identifier, the custom meta-schema that the other one requires, so neither
// can ever be imported. `doc-a` is identified by `$id` next to an `id`
// pointing elsewhere, and `doc-b` the other way around. The run must terminate
// with the local resolution diagnostic and no network round trip. Which of the
// two symmetric participants gets blamed is deliberately not pinned, so the
// identifier and file below are normalized before comparing

ENV SOURCEMETA_CORE_CURL_SO $CWD/does-not-exist.so

WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "string"
}
EOF

WRITE doc-a.json UNTIL EOF
{
  "$schema": "https://example.com/nested/embedded-meta-b",
  "$id": "https://example.com/nested/doc-a",
  "id": "https://example.com/elsewhere/doc-a",
  "$defs": {
    "meta": {
      "$id": "embedded-meta-a",
      "$vocabulary": {
        "https://json-schema.org/draft/2020-12/vocab/core": true,
        "https://json-schema.org/draft/2020-12/vocab/applicator": true,
        "https://json-schema.org/draft/2020-12/vocab/validation": true
      }
    }
  }
}
EOF

WRITE doc-b.json UNTIL EOF
{
  "$schema": "https://example.com/nested/embedded-meta-a",
  "id": "https://example.com/nested/doc-b",
  "$id": "https://example.com/elsewhere/doc-b",
  "definitions": {
    "meta": {
      "id": "embedded-meta-b",
      "$vocabulary": {
        "https://json-schema.org/draft/2020-12/vocab/core": true,
        "https://json-schema.org/draft/2020-12/vocab/applicator": true,
        "https://json-schema.org/draft/2020-12/vocab/validation": true
      }
    }
  }
}
EOF

WRITE instance.json UNTIL EOF
"hello"
EOF

// Schema input error
RUN validate schema.json instance.json --http --resolve doc-a.json --resolve doc-b.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_0.txt
REPLACE 'https://example.com/nested/embedded-meta-a' WITH '[STUCK]' IN result_0.txt
REPLACE 'https://example.com/nested/embedded-meta-b' WITH '[STUCK]' IN result_0.txt
REPLACE '[CWD]/doc-a.json' WITH '[INPUT]' IN result_0.txt
REPLACE '[CWD]/doc-b.json' WITH '[INPUT]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: Could not resolve the metaschema of the schema
2>   at identifier [STUCK]
2>   at file path [INPUT]
2>
2> This is likely because you forgot to import such schema using `--resolve/-r`
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Schema input error
RUN validate schema.json instance.json --http --resolve doc-a.json --resolve doc-b.json --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_1.txt
REPLACE 'https://example.com/nested/embedded-meta-a' WITH '[STUCK]' IN result_1.txt
REPLACE 'https://example.com/nested/embedded-meta-b' WITH '[STUCK]' IN result_1.txt
REPLACE '[CWD]/doc-a.json' WITH '[INPUT]' IN result_1.txt
REPLACE '[CWD]/doc-b.json' WITH '[INPUT]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "Could not resolve the metaschema of the schema",
1>   "identifier": "[STUCK]",
1>   "filePath": "[INPUT]"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
