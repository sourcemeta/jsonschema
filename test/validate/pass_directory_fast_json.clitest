WRITE schema.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Test",
  "description": "Test schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    }
  }
}
EOF

WRITE instances/instance_1.json UNTIL EOF
{ "name": "Alice" }
EOF

WRITE instances/instance_2.json UNTIL EOF
{ "name": "Bob" }
EOF

RUN validate schema.json instances --fast --json STDIN /dev/null IN . INTO result.txt EXPECTING 0

WRITE expected.txt UNTIL EOF
1> {
1>   "valid": true
1> }
1> {
1>   "valid": true
1> }
2> instances/instance_1.json
2> instances/instance_2.json
EOF

COMPARE result.txt AGAINST expected.txt
