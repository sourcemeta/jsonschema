// From 3.2 a description may declare an identity of its own, which is what a
// relative entry point is then resolved against rather than where the file
// was read from.

WRITE openapi.json UNTIL EOF
{
  "openapi": "3.2.0",
  "$self": "https://example.com/api",
  "info": { "title": "Example", "version": "1.0.0" },
  "paths": {},
  "components": { "schemas": { "S": { "type": "string" } } }
}
EOF

WRITE instance.json UNTIL EOF
"hello"
EOF

RUN validate openapi.json instance.json --entrypoint /components/schemas/S --verbose STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

WRITE expected_0.txt UNTIL EOF
2> ok: instance.json
2>
2> 1 validated, 1 passed, 0 failed
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// The declared identity is what the entry point resolves against
RUN validate openapi.json instance.json --entrypoint 'https://example.com/api#/components/schemas/S' --verbose STDIN /dev/null IN . INTO result_1.txt EXPECTING 0

WRITE expected_1.txt UNTIL EOF
2> ok: instance.json
2>
2> 1 validated, 1 passed, 0 failed
EOF

COMPARE result_1.txt AGAINST expected_1.txt
