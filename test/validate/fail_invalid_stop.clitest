MAKE DIRECTORY instances

WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "foo": {
      "type": "string"
    }
  }
}
EOF

WRITE instances/instance_1.json UNTIL EOF
{ "foo": "bar" }
EOF

WRITE instances/instance_2.json UNTIL EOF
{ "foo": 1 }
EOF

// Validation failure
RUN validate schema.json instances --invalid STDIN /dev/null IN . INTO result_0.txt EXPECTING 2

WRITE expected_0.txt UNTIL EOF
2> fail: instances/instance_1.json
2> error: The instance was expected to be invalid
2>
2> 1 validated, 0 passed, 1 failed
2> warning: Stopped at first failure, pass --continue/-c to keep going
EOF

COMPARE result_0.txt AGAINST expected_0.txt
