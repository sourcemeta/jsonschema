WRITE schema.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object"
}
EOF

WRITE instance.jsonl.gz UNTIL EOF
this is not valid gzip data
EOF

// Other input error
RUN validate schema.json instance.jsonl.gz STDIN /dev/null IN . INTO result_0.txt EXPECTING 6

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: Invalid gzip magic bytes
2>   at file path [CWD]/instance.jsonl.gz
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Other input error
RUN validate schema.json instance.jsonl.gz --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 6

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "Invalid gzip magic bytes",
1>   "filePath": "[CWD]/instance.jsonl.gz"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
