// A schema the description reaches for is settled before any of it is
// compiled, so an entry point may name one that arrived from a schema file.

WRITE pet.json UNTIL EOF
{
  "$id": "https://example.com/pet",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "string"
}
EOF

WRITE openapi.json UNTIL EOF
{
  "openapi": "3.1.1",
  "info": { "title": "Example", "version": "1.0.0" },
  "paths": {},
  "components": {
    "schemas": {
      "pet": { "type": "integer" },
      "Uses": { "$ref": "https://example.com/pet" }
    }
  }
}
EOF

WRITE instance.json UNTIL EOF
"hello"
EOF

RUN validate openapi.json instance.json --resolve pet.json --entrypoint https://example.com/pet --verbose STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

WRITE expected_0.txt UNTIL EOF
2> ok: instance.json
2>
2> 1 validated, 1 passed, 0 failed
EOF

COMPARE result_0.txt AGAINST expected_0.txt
