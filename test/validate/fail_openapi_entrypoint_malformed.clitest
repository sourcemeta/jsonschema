// An entry point that is neither a URI nor a JSON Pointer is turned down
// before anything is looked up.

WRITE openapi.json UNTIL EOF
{
  "openapi": "3.1.1",
  "info": { "title": "Example", "version": "1.0.0" },
  "paths": {},
  "components": { "schemas": { "Person": { "type": "string" } } }
}
EOF

WRITE instance.json UNTIL EOF
"hello"
EOF

// Schema input error
RUN validate openapi.json instance.json --entrypoint 'not a uri' STDIN /dev/null IN . INTO result_0.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: The given entry point is not a valid URI or JSON Pointer
2>   at identifier not a uri
2>   at file path [CWD]/openapi.json
2>
2> Use the `inspect` command to find valid schema locations
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Schema input error
RUN validate openapi.json instance.json --entrypoint 'not a uri' --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "The given entry point is not a valid URI or JSON Pointer",
1>   "identifier": "not a uri",
1>   "filePath": "[CWD]/openapi.json"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
