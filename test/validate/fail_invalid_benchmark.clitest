WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "foo": {
      "type": "string"
    }
  }
}
EOF

WRITE instance.json UNTIL EOF
{ "foo": "bar" }
EOF

// Validation failure
RUN validate schema.json instance.json --invalid --benchmark STDIN /dev/null IN . INTO result_0.txt EXPECTING 2

REPLACE MATCHING '[0-9]+\.[0-9]+ \+- [0-9]+\.[0-9]+ us \([0-9]+\.[0-9]+\)' WITH '[TIMING]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
1> instance.json: FAIL [TIMING]
2> fail: instance.json
2> error: The instance was expected to be invalid
EOF

COMPARE result_0.txt AGAINST expected_0.txt
