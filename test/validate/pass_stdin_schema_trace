WRITE instance.json UNTIL EOF
"hello"
EOF

WRITE stdin_0 UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/test-schema",
  "type": "string"
}
EOF

RUN validate - instance.json --trace STDIN stdin_0 IN . INTO result_0.txt EXPECTING 0

WRITE expected_0.txt UNTIL EOF
1> -> (push) "/type" (AssertionTypeStrict)
1>    at instance location "" (line 1, column 1)
1>    at keyword location "https://example.com/test-schema#/type"
1>    at vocabulary "https://json-schema.org/draft/2020-12/vocab/validation"
1>
1> <- (pass) "/type" (AssertionTypeStrict)
1>    at instance location "" (line 1, column 1)
1>    at keyword location "https://example.com/test-schema#/type"
1>    at vocabulary "https://json-schema.org/draft/2020-12/vocab/validation"
EOF

COMPARE result_0.txt AGAINST expected_0.txt
