WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test",
  "description": "Test schema",
  "type": "object",
  "properties": {
    "foo": {
      "type": "string"
    }
  }
}
EOF

WRITE instances.jsonl UNTIL EOF
{ "foo": "bar" }
{ "foo": 1 }
EOF

// Validation failure
RUN validate schema.json instances.jsonl --continue --verbose --color always STDIN /dev/null IN . INTO result_0.txt EXPECTING 2

REPLACE MATCHING '\x1B\[1;31m' WITH '[ANSI_BOLD_RED]' IN result_0.txt
REPLACE MATCHING '\x1B\[1;32m' WITH '[ANSI_BOLD_GREEN]' IN result_0.txt
REPLACE MATCHING '\x1B\[0m' WITH '[ANSI_RESET]' IN result_0.txt
REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> Interpreting input as JSONL: [CWD]/instances.jsonl
2> [ANSI_BOLD_GREEN]✓ ok:[ANSI_RESET] instances.jsonl (entry #1)
2> [ANSI_BOLD_RED]✗ fail:[ANSI_RESET] instances.jsonl (entry #2)
2>
2> {
2>   "foo": 1
2> }
2>
2> error: Schema validation failure
2>   The value was expected to be of type string but it was of type integer
2>     at instance location "/foo"
2>     at evaluate path "/properties/foo/type"
2>   The object value was expected to validate against the single defined property subschema
2>     at instance location ""
2>     at evaluate path "/properties"
2>
2> 2 validated, 1 passed, 1 failed
EOF

COMPARE result_0.txt AGAINST expected_0.txt
