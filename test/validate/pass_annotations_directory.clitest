MAKE DIRECTORY instances

WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test",
  "description": "Test schema",
  "properties": {
    "name": {
      "type": "string"
    },
    "age": {
      "type": "integer"
    }
  }
}
EOF

WRITE instances/instance_1.json UNTIL EOF
{ "name": "Alice", "age": 30 }
EOF

WRITE instances/instance_2.json UNTIL EOF
{ "name": "Bob", "age": 25 }
EOF

RUN validate schema.json instances --annotations STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> ok: [CWD]/instances/instance_1.json
2>   matches [CWD]/schema.json
2> annotation: "Test schema"
2>   at instance location "" (line 1, column 1)
2>   at evaluate path "/description"
2> annotation: "Test"
2>   at instance location "" (line 1, column 1)
2>   at evaluate path "/title"
2> annotation: "age"
2>   at instance location "" (line 1, column 1)
2>   at evaluate path "/properties"
2> annotation: "name"
2>   at instance location "" (line 1, column 1)
2>   at evaluate path "/properties"
2> ok: [CWD]/instances/instance_2.json
2>   matches [CWD]/schema.json
2> annotation: "Test schema"
2>   at instance location "" (line 1, column 1)
2>   at evaluate path "/description"
2> annotation: "Test"
2>   at instance location "" (line 1, column 1)
2>   at evaluate path "/title"
2> annotation: "age"
2>   at instance location "" (line 1, column 1)
2>   at evaluate path "/properties"
2> annotation: "name"
2>   at instance location "" (line 1, column 1)
2>   at evaluate path "/properties"
EOF

COMPARE result_0.txt AGAINST expected_0.txt
