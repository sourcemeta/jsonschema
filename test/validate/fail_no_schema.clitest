// Invalid CLI arguments
RUN validate STDIN /dev/null IN . INTO result_0.txt EXPECTING 5

WRITE expected_0.txt UNTIL EOF
2> error: This command expects a path to a schema and a path to an
2> instance to validate against the schema
2>
2> For example: jsonschema validate path/to/schema.json path/to/instance.json
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Invalid CLI arguments
RUN validate --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 5

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "This command expects a path to a schema and a path to an\ninstance to validate against the schema"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
