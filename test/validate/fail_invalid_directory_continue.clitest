MAKE DIRECTORY instances

WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "foo": {
      "type": "string"
    }
  }
}
EOF

WRITE instances/instance_1.json UNTIL EOF
{ "foo": "bar" }
EOF

WRITE instances/instance_2.json UNTIL EOF
{ "foo": 1 }
EOF

WRITE instances/instance_3.json UNTIL EOF
{ "foo": "baz" }
EOF

// Validation failure
RUN validate schema.json instances --invalid --continue STDIN /dev/null IN . INTO result_0.txt EXPECTING 2

WRITE expected_0.txt UNTIL EOF
2> fail: instances/instance_1.json
2> error: The instance was expected to be invalid
2> fail: instances/instance_3.json
2> error: The instance was expected to be invalid
2>
2> 3 validated, 1 passed, 2 failed
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Validation failure
RUN validate schema.json instances --invalid --continue --verbose STDIN /dev/null IN . INTO result_1.txt EXPECTING 2

WRITE expected_1.txt UNTIL EOF
2> fail: instances/instance_1.json
2> error: The instance was expected to be invalid
2> ok: instances/instance_2.json
2> fail: instances/instance_3.json
2> error: The instance was expected to be invalid
2>
2> 3 validated, 1 passed, 2 failed
EOF

COMPARE result_1.txt AGAINST expected_1.txt

// Validation failure
RUN validate schema.json instances --invalid --continue --json STDIN /dev/null IN . INTO result_2.txt EXPECTING 2

WRITE expected_2.txt UNTIL EOF
1> {
1>   "valid": false
1> }
1> {
1>   "valid": true
1> }
1> {
1>   "valid": false
1> }
2> instances/instance_1.json
2> instances/instance_2.json
2> instances/instance_3.json
EOF

COMPARE result_2.txt AGAINST expected_2.txt
