WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "foo": {
      "type": "string"
    }
  }
}
EOF

WRITE dataset.jsonl UNTIL EOF
{ "foo": 1 }
{ "foo": 2 }
EOF

RUN validate schema.json dataset.jsonl --invalid STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

WRITE expected_0.txt UNTIL EOF
2> 2 validated, 2 passed, 0 failed
EOF

COMPARE result_0.txt AGAINST expected_0.txt
