WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "string"
}
EOF

WRITE instance.json UNTIL EOF
"hello"
EOF

// Validation failure
RUN validate schema.json instance.json --invalid --trace STDIN /dev/null IN . INTO result_0.txt EXPECTING 2

REPLACE $CWD_URI WITH '[CWD_URI]' IN result_0.txt
WRITE expected_0.txt UNTIL EOF
1> -> (push) "/type" (AssertionTypeStrict)
1>    at instance location "" (line 1, column 1)
1>    at keyword location "[CWD_URI]/schema.json#/type"
1>    at vocabulary "https://json-schema.org/draft/2020-12/vocab/validation"
1>
1> <- (pass) "/type" (AssertionTypeStrict)
1>    at instance location "" (line 1, column 1)
1>    at keyword location "[CWD_URI]/schema.json#/type"
1>    at vocabulary "https://json-schema.org/draft/2020-12/vocab/validation"
EOF

COMPARE result_0.txt AGAINST expected_0.txt
