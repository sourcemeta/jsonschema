WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test",
  "description": "Test schema",
  "$ref": "./schemas/other.json"
}
EOF

WRITE instance.json UNTIL EOF
"foo bar"
EOF

// Schema input error
RUN validate schema.json instance.json --verbose STDIN /dev/null IN . INTO result_0.txt EXPECTING 4

REPLACE $CWD_URI WITH '[CWD_URI]' IN result_0.txt
REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: Could not resolve the reference to an external schema
2>   at identifier [CWD_URI]/schemas/other.json
2>   at file path [CWD]/schema.json
2>
2> This is likely because the file does not exist
EOF

COMPARE result_0.txt AGAINST expected_0.txt
