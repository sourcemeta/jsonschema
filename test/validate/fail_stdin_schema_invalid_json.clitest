WRITE instance.json UNTIL EOF
{ "foo": "bar" }
EOF

WRITE stdin_input UNTIL EOF
{ "type" string }
EOF

// Other input error
RUN validate - instance.json STDIN stdin_input IN . INTO result_0.txt EXPECTING 6

WRITE expected_0.txt UNTIL EOF
2> error: Failed to parse the JSON document
2>   at line 1
2>   at column 10
2>   at file path tag:sourcemeta.com,2026:jsonschema/stdin
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Other input error
RUN validate - instance.json --json STDIN stdin_input IN . INTO result_1.txt EXPECTING 6

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "Failed to parse the JSON document",
1>   "line": 1,
1>   "column": 10,
1>   "filePath": "tag:sourcemeta.com,2026:jsonschema/stdin"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
