WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com",
  "properties": true
}
EOF

WRITE instance.json UNTIL EOF
{}
EOF

// Schema input error
RUN validate schema.json instance.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: This keyword was expected to be set to an object whose values are valid schemas
2>   at line 4
2>   at column 3
2>   at file path [CWD]/schema.json
2>   at location "/properties"
2>   at base uri https://example.com
2>
2> Use the `metaschema` command to check the schema against its meta-schema
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Schema input error
RUN validate schema.json instance.json --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "This keyword was expected to be set to an object whose values are valid schemas",
1>   "line": 4,
1>   "column": 3,
1>   "filePath": "[CWD]/schema.json",
1>   "location": "/properties",
1>   "baseURI": "https://example.com"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
