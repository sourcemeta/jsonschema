// A description has no root schema, so leaving the entry point out is the
// invocation being incomplete rather than anything wrong with the file. An
// entry point that names nothing, or names a place that is no schema, is told
// which of the two it is.

WRITE openapi.json UNTIL EOF
{
  "openapi": "3.1.1",
  "info": { "title": "Example", "version": "1.0.0" },
  "paths": {},
  "components": { "schemas": { "Person": { "type": "string" } } }
}
EOF

WRITE instance.json UNTIL EOF
"hello"
EOF

// Invalid CLI arguments
RUN validate openapi.json instance.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 5

WRITE expected_0.txt UNTIL EOF
2> error: You must pass an entry point using the `--entrypoint/-p` option when the input is an OpenAPI description
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Invalid CLI arguments
RUN validate openapi.json instance.json --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 5

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "You must pass an entry point using the `--entrypoint/-p` option when the input is an OpenAPI description"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt

// Schema input error
RUN validate openapi.json instance.json --entrypoint /info/title STDIN /dev/null IN . INTO result_2.txt EXPECTING 4

REPLACE $CWD_URI WITH '[CWD_URI]' IN result_2.txt
REPLACE $CWD WITH '[CWD]' IN result_2.txt

WRITE expected_2.txt UNTIL EOF
2> error: The given entry point URI is not a valid subschema
2>   at identifier [CWD_URI]/openapi.json#/info/title
2>   at file path [CWD]/openapi.json
2>
2> Use the `inspect` command to find valid schema locations
EOF

COMPARE result_2.txt AGAINST expected_2.txt

// Schema input error
RUN validate openapi.json instance.json --entrypoint /nowhere STDIN /dev/null IN . INTO result_3.txt EXPECTING 4

REPLACE $CWD_URI WITH '[CWD_URI]' IN result_3.txt
REPLACE $CWD WITH '[CWD]' IN result_3.txt

WRITE expected_3.txt UNTIL EOF
2> error: The given entry point URI does not exist in the schema
2>   at identifier [CWD_URI]/openapi.json#/nowhere
2>   at file path [CWD]/openapi.json
2>
2> Use the `inspect` command to find valid schema locations
EOF

COMPARE result_3.txt AGAINST expected_3.txt

// Schema input error
RUN validate openapi.json instance.json --entrypoint 'not a uri' STDIN /dev/null IN . INTO result_4.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_4.txt

WRITE expected_4.txt UNTIL EOF
2> error: The given entry point is not a valid URI or JSON Pointer
2>   at identifier not a uri
2>   at file path [CWD]/openapi.json
2>
2> Use the `inspect` command to find valid schema locations
EOF

COMPARE result_4.txt AGAINST expected_4.txt
