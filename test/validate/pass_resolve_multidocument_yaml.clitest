WRITE schemas.yaml UNTIL EOF
$schema: "https://json-schema.org/draft/2020-12/schema"
$id: "https://example.com/first"
type: string
---
$schema: "https://json-schema.org/draft/2020-12/schema"
$id: "https://example.com/second"
type: integer
EOF

WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "https://example.com/second"
}
EOF

WRITE instance.json UNTIL EOF
42
EOF

WRITE expected_0.txt UNTIL EOF
2> 1 validated, 1 passed, 0 failed
EOF

RUN validate schema.json instance.json --resolve schemas.yaml STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

REPLACE $CWD WITH '[CWD]' IN result_0.txt

COMPARE result_0.txt AGAINST expected_0.txt
