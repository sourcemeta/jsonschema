WRITE schema.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object"
}
EOF

// Other input error
RUN validate schema.json nonexistent.jsonl.gz STDIN /dev/null IN . INTO result_0.txt EXPECTING 6
REPLACE '\\\\' WITH '/' IN result_0.txt
REPLACE '\\(?!")' WITH '/' IN result_0.txt

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: No such file or directory
2>   at file path [CWD]/nonexistent.jsonl.gz
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Other input error
RUN validate schema.json nonexistent.jsonl.gz --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 6
REPLACE '\\\\' WITH '/' IN result_1.txt
REPLACE '\\(?!")' WITH '/' IN result_1.txt

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "No such file or directory",
1>   "filePath": "[CWD]/nonexistent.jsonl.gz"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
