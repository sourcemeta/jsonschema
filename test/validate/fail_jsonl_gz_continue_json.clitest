WRITE schema.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Test",
  "description": "Test schema",
  "type": "array"
}
EOF

WRITE instance.jsonl UNTIL EOF
{ "foo": 1 }
{ "foo": 2 }
{ "foo": 3 }
EOF

COMPRESS GZIP instance.jsonl INTO instance.jsonl.gz

// Validation failure
RUN validate schema.json instance.jsonl.gz --json --continue STDIN /dev/null IN . INTO result_0.txt EXPECTING 2

REPLACE '\\\\' WITH '/' IN result_0.txt
REPLACE '\\(?!")' WITH '/' IN result_0.txt
REPLACE $CWD WITH '[CWD]' IN result_0.txt
REPLACE 'file:///\[CWD\]' WITH 'file://[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
1> {
1>   "valid": false,
1>   "errors": [
1>     {
1>       "keywordLocation": "/type",
1>       "absoluteKeywordLocation": "file://[CWD]/schema.json#/type",
1>       "instanceLocation": "",
1>       "error": "The value was expected to be of type array but it was of type object"
1>     }
1>   ]
1> }
1> {
1>   "valid": false,
1>   "errors": [
1>     {
1>       "keywordLocation": "/type",
1>       "absoluteKeywordLocation": "file://[CWD]/schema.json#/type",
1>       "instanceLocation": "",
1>       "error": "The value was expected to be of type array but it was of type object"
1>     }
1>   ]
1> }
1> {
1>   "valid": false,
1>   "errors": [
1>     {
1>       "keywordLocation": "/type",
1>       "absoluteKeywordLocation": "file://[CWD]/schema.json#/type",
1>       "instanceLocation": "",
1>       "error": "The value was expected to be of type array but it was of type object"
1>     }
1>   ]
1> }
EOF

COMPARE result_0.txt AGAINST expected_0.txt
