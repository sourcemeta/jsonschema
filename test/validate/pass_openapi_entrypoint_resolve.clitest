// What a description reaches for is settled before any of it is compiled, so
// an entry point may name a schema that arrived from elsewhere. A standalone
// schema comes in through the schema resolver, while another description's
// schemas arrive with whatever Object an OpenAPI-layer reference pulls in.
// Naming such a schema by its identifier holds even when the name its
// component ends up under is not the one it asked for.

WRITE pet.json UNTIL EOF
{
  "$id": "https://example.com/pet",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "string"
}
EOF

WRITE shared.json UNTIL EOF
{
  "openapi": "3.1.1",
  "info": { "title": "Shared", "version": "1.0.0" },
  "paths": {},
  "components": {
    "responses": {
      "Ok": {
        "description": "OK",
        "content": {
          "application/json": {
            "schema": { "$id": "https://example.com/from-shared", "type": "string" }
          }
        }
      }
    }
  }
}
EOF

WRITE standalone.json UNTIL EOF
{
  "openapi": "3.1.1",
  "info": { "title": "Example", "version": "1.0.0" },
  "paths": {},
  "components": {
    "schemas": {
      "pet": { "type": "integer" },
      "Uses": { "$ref": "https://example.com/pet" }
    }
  }
}
EOF

WRITE layered.json UNTIL EOF
{
  "openapi": "3.1.1",
  "info": { "title": "Example", "version": "1.0.0" },
  "paths": {
    "/p": {
      "get": { "responses": { "200": { "$ref": "shared.json#/components/responses/Ok" } } }
    }
  }
}
EOF

WRITE instance.json UNTIL EOF
"hello"
EOF

WRITE number.json UNTIL EOF
42
EOF

RUN validate standalone.json instance.json --resolve pet.json --entrypoint https://example.com/pet --verbose STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

WRITE expected_0.txt UNTIL EOF
2> ok: instance.json
2>
2> 1 validated, 1 passed, 0 failed
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// The component the entry document already declares keeps its own pointer
RUN validate standalone.json number.json --resolve pet.json --entrypoint /components/schemas/pet --verbose STDIN /dev/null IN . INTO result_1.txt EXPECTING 0

WRITE expected_1.txt UNTIL EOF
2> ok: number.json
2>
2> 1 validated, 1 passed, 0 failed
EOF

COMPARE result_1.txt AGAINST expected_1.txt

RUN validate layered.json instance.json --resolve shared.json --entrypoint https://example.com/from-shared --verbose STDIN /dev/null IN . INTO result_2.txt EXPECTING 0

WRITE expected_2.txt UNTIL EOF
2> ok: instance.json
2>
2> 1 validated, 1 passed, 0 failed
EOF

COMPARE result_2.txt AGAINST expected_2.txt
