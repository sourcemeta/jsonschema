WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object"
}
EOF

WRITE instance.json UNTIL EOF
{}
EOF

// Schema input error
RUN validate schema.json instance.json --entrypoint 'https://example.com/foo bar' STDIN /dev/null IN . INTO result_0.txt EXPECTING 4
REPLACE '\\\\' WITH '/' IN result_0.txt
REPLACE '\\(?!")' WITH '/' IN result_0.txt

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: The given entry point is not a valid URI or JSON Pointer
2>   at identifier https://example.com/foo bar
2>   at file path [CWD]/schema.json
2>
2> Use the `inspect` command to find valid schema locations
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Schema input error
RUN validate schema.json instance.json --entrypoint 'https://example.com/foo bar' --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 4
REPLACE '\\\\' WITH '/' IN result_1.txt
REPLACE '\\(?!")' WITH '/' IN result_1.txt

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "The given entry point is not a valid URI or JSON Pointer",
1>   "identifier": "https://example.com/foo bar",
1>   "filePath": "[CWD]/schema.json"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
