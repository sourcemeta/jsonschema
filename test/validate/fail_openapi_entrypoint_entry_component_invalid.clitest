// A component the entry document declares is the one its own pointer names,
// rather than whatever was brought in beside it.

WRITE pet.json UNTIL EOF
{
  "$id": "https://example.com/pet",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "string"
}
EOF

WRITE openapi.json UNTIL EOF
{
  "openapi": "3.1.1",
  "info": { "title": "Example", "version": "1.0.0" },
  "paths": {},
  "components": {
    "schemas": {
      "pet": { "type": "integer" },
      "Uses": { "$ref": "https://example.com/pet" }
    }
  }
}
EOF

WRITE instance.json UNTIL EOF
"a string"
EOF

// Validation failure
RUN validate openapi.json instance.json --resolve pet.json --entrypoint /components/schemas/pet STDIN /dev/null IN . INTO result_0.txt EXPECTING 2

WRITE expected_0.txt UNTIL EOF
2> fail: instance.json
2> error: Schema validation failure
2>   The value was expected to be of type integer but it was of type string
2>     at instance location "" (line 1, column 1)
2>     at evaluate path "/type"
2>
2> 1 validated, 0 passed, 1 failed
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Validation failure
RUN validate openapi.json instance.json --resolve pet.json --entrypoint /components/schemas/pet --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 2

REPLACE $CWD_URI WITH '[CWD_URI]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "valid": false,
1>   "errors": [
1>     {
1>       "keywordLocation": "/type",
1>       "absoluteKeywordLocation": "[CWD_URI]/openapi.json#/components/schemas/pet/type",
1>       "instanceLocation": "",
1>       "instancePosition": [ 1, 1, 1, 10 ],
1>       "error": "The value was expected to be of type integer but it was of type string"
1>     }
1>   ]
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
