// A description holds many schemas and no root one, so which to validate
// against is named with `--entrypoint/-p`, spelled as a JSON Pointer into it.

WRITE openapi.json UNTIL EOF
{
  "openapi": "3.1.1",
  "info": { "title": "Example", "version": "1.0.0" },
  "paths": {},
  "components": {
    "schemas": {
      "Person": {
        "$id": "https://example.com/person",
        "type": "object",
        "required": [ "name" ],
        "properties": { "name": { "$anchor": "name", "type": "string" } }
      }
    }
  }
}
EOF

WRITE instance.json UNTIL EOF
{ "name": "ok" }
EOF

RUN validate openapi.json instance.json --entrypoint /components/schemas/Person --verbose STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

WRITE expected_0.txt UNTIL EOF
2> ok: instance.json
2>
2> 1 validated, 1 passed, 0 failed
EOF

COMPARE result_0.txt AGAINST expected_0.txt
