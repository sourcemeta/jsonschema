WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "foo": {
      "type": "string"
    }
  }
}
EOF

WRITE instance.json UNTIL EOF
{ "foo": 1 }
EOF

RUN validate schema.json instance.json --invalid --verbose --color always STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

REPLACE MATCHING '\x1B\[1;32m' WITH '[ANSI_BOLD_GREEN]' IN result_0.txt
REPLACE MATCHING '\x1B\[0m' WITH '[ANSI_RESET]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> [ANSI_BOLD_GREEN]✓ ok:[ANSI_RESET] instance.json
2>
2> 1 validated, 1 passed, 0 failed
EOF

COMPARE result_0.txt AGAINST expected_0.txt
