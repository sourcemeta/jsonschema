// A chain of custom meta-schemas whose ultimate meta-schema is genuinely
// missing must terminate with a file-anchored resolution diagnostic instead
// of retrying forever. No entry can ever import: the leaf waits on `meta-c`,
// `meta-c` waits on `meta-b`, and `meta-b` waits on a meta-schema that is
// never supplied. Which stuck entry gets blamed is deliberately not pinned,
// since reporting the first deferred entry and tracing to the genuinely
// absent meta-schema are both acceptable, so the identifier and file below
// are normalized before comparing

WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "string"
}
EOF

WRITE leaf.json UNTIL EOF
{
  "$schema": "https://example.com/meta-c",
  "$id": "https://example.com/leaf",
  "type": "string"
}
EOF

WRITE meta-c.json UNTIL EOF
{
  "$schema": "https://example.com/meta-b",
  "$id": "https://example.com/meta-c",
  "$vocabulary": {
    "https://json-schema.org/draft/2020-12/vocab/core": true,
    "https://json-schema.org/draft/2020-12/vocab/applicator": true,
    "https://json-schema.org/draft/2020-12/vocab/validation": true
  }
}
EOF

WRITE meta-b.json UNTIL EOF
{
  "$schema": "https://example.com/absent-meta-a",
  "$id": "https://example.com/meta-b",
  "$vocabulary": {
    "https://json-schema.org/draft/2020-12/vocab/core": true,
    "https://json-schema.org/draft/2020-12/vocab/applicator": true,
    "https://json-schema.org/draft/2020-12/vocab/validation": true
  }
}
EOF

WRITE instance.json UNTIL EOF
"hello"
EOF

// Schema input error
RUN validate schema.json instance.json --resolve leaf.json --resolve meta-c.json --resolve meta-b.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_0.txt
REPLACE 'https://example.com/meta-c' WITH '[STUCK]' IN result_0.txt
REPLACE 'https://example.com/meta-b' WITH '[STUCK]' IN result_0.txt
REPLACE 'https://example.com/absent-meta-a' WITH '[STUCK]' IN result_0.txt
REPLACE '[CWD]/leaf.json' WITH '[INPUT]' IN result_0.txt
REPLACE '[CWD]/meta-c.json' WITH '[INPUT]' IN result_0.txt
REPLACE '[CWD]/meta-b.json' WITH '[INPUT]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: Could not resolve the metaschema of the schema
2>   at identifier [STUCK]
2>   at file path [INPUT]
2>
2> This is likely because you forgot to import such schema using `--resolve/-r`
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Schema input error
RUN validate schema.json instance.json --resolve leaf.json --resolve meta-c.json --resolve meta-b.json --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_1.txt
REPLACE 'https://example.com/meta-c' WITH '[STUCK]' IN result_1.txt
REPLACE 'https://example.com/meta-b' WITH '[STUCK]' IN result_1.txt
REPLACE 'https://example.com/absent-meta-a' WITH '[STUCK]' IN result_1.txt
REPLACE '[CWD]/leaf.json' WITH '[INPUT]' IN result_1.txt
REPLACE '[CWD]/meta-c.json' WITH '[INPUT]' IN result_1.txt
REPLACE '[CWD]/meta-b.json' WITH '[INPUT]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "Could not resolve the metaschema of the schema",
1>   "identifier": "[STUCK]",
1>   "filePath": "[INPUT]"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
