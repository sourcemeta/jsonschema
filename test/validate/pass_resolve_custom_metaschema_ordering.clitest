WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "https://example.com/my-schema"
}
EOF

WRITE zz-meta.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/my-meta",
  "$vocabulary": {
    "https://json-schema.org/draft/2020-12/vocab/core": true,
    "https://json-schema.org/draft/2020-12/vocab/applicator": true,
    "https://json-schema.org/draft/2020-12/vocab/validation": true
  }
}
EOF

WRITE aa-schema.json UNTIL EOF
{
  "$schema": "https://example.com/my-meta",
  "$id": "https://example.com/my-schema",
  "type": "string"
}
EOF

WRITE instance.json UNTIL EOF
"hello"
EOF

RUN validate schema.json instance.json --resolve zz-meta.json --resolve aa-schema.json --debug STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

REPLACE $CWD_URI WITH '[CWD_URI]' IN result_0.txt
REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> debug: Detecting schema resources from file: [CWD]/zz-meta.json
2> debug: Importing schema into the resolution context: [CWD_URI]/zz-meta.json
2> debug: Importing schema into the resolution context: https://example.com/my-meta
2> debug: Detecting schema resources from file: [CWD]/aa-schema.json
2> debug: Importing schema into the resolution context: [CWD_URI]/aa-schema.json
2> debug: Importing schema into the resolution context: https://example.com/my-schema
2> ok: [CWD]/instance.json
2>   matches [CWD]/schema.json
EOF

COMPARE result_0.txt AGAINST expected_0.txt
