WRITE document.json UNTIL EOF
{ "foo": 1 }
EOF

WRITE instance.json UNTIL EOF
{ "bar": 2 }
EOF

WRITE jsonschema.json UNTIL EOF
{
  "extension": [ ".schema.json" ],
  "defaultDialect": "https://json-schema.org/draft/2020-12/schema"
}
EOF

// Schema input error
RUN validate document.json instance.json --verbose STDIN /dev/null IN . INTO result_0.txt EXPECTING 4
REPLACE '\\\\' WITH '/' IN result_0.txt
REPLACE '\\(?!")' WITH '/' IN result_0.txt

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: Could not determine the base dialect of the schema
2>   at file path [CWD]/document.json
2>
2> Are you sure the input is a valid JSON Schema and its base dialect is known?
2> If the input does not declare the `$schema` keyword, you might want to
2> explicitly declare a default dialect using `--default-dialect/-d`
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Schema input error
RUN validate document.json instance.json --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 4
REPLACE '\\\\' WITH '/' IN result_1.txt
REPLACE '\\(?!")' WITH '/' IN result_1.txt

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "Could not determine the base dialect of the schema",
1>   "filePath": "[CWD]/document.json"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
