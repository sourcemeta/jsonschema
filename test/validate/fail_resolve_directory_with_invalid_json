MAKE DIRECTORY schemas

WRITE schema.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Test",
  "description": "Test schema",
  "type": "string"
}
EOF

WRITE instance.json UNTIL EOF
"foo"
EOF

WRITE schemas/01-valid.json UNTIL EOF
{ "foo": 1 }
EOF

WRITE schemas/02-invalid.json UNTIL EOF
{ xxx }
EOF

// Other input error
RUN validate schema.json instance.json --resolve schemas STDIN /dev/null IN . INTO result_0.txt EXPECTING 6
REPLACE '\\\\' WITH '/' IN result_0.txt
REPLACE '\\(?!")' WITH '/' IN result_0.txt

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: Failed to parse the JSON document
2>   at line 1
2>   at column 3
2>   at file path [CWD]/schemas/02-invalid.json
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Other input error
RUN validate schema.json instance.json --resolve schemas --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 6
REPLACE '\\\\' WITH '/' IN result_1.txt
REPLACE '\\(?!")' WITH '/' IN result_1.txt

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "Failed to parse the JSON document",
1>   "line": 1,
1>   "column": 3,
1>   "filePath": "[CWD]/schemas/02-invalid.json"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
