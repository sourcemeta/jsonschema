// A description written in YAML holds its schemas to the instance the same
// way one written in JSON does.

WRITE openapi.yaml UNTIL EOF
openapi: "3.1.1"
info:
  title: Example
  version: "1.0.0"
paths: {}
components:
  schemas:
    S:
      type: string
EOF

WRITE instance.json UNTIL EOF
42
EOF

// Validation failure
RUN validate openapi.yaml instance.json --entrypoint /components/schemas/S STDIN /dev/null IN . INTO result_0.txt EXPECTING 2

WRITE expected_0.txt UNTIL EOF
2> fail: instance.json
2> error: Schema validation failure
2>   The value was expected to be of type string but it was of type integer
2>     at instance location "" (line 1, column 1)
2>     at evaluate path "/type"
2>
2> 1 validated, 0 passed, 1 failed
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Validation failure
RUN validate openapi.yaml instance.json --entrypoint /components/schemas/S --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 2

REPLACE $CWD_URI WITH '[CWD_URI]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "valid": false,
1>   "errors": [
1>     {
1>       "keywordLocation": "/type",
1>       "absoluteKeywordLocation": "[CWD_URI]/openapi.yaml#/components/schemas/S/type",
1>       "instanceLocation": "",
1>       "instancePosition": [ 1, 1, 1, 2 ],
1>       "error": "The value was expected to be of type string but it was of type integer"
1>     }
1>   ]
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
