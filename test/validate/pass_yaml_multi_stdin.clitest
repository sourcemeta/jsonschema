WRITE schema.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Test",
  "description": "Test schema",
  "properties": {
    "foo": {
      "type": "string"
    }
  }
}
EOF

WRITE stdin_input UNTIL EOF
---
foo: first
---
foo: second
---
foo: third
EOF

RUN validate schema.json - --verbose STDIN stdin_input IN . INTO result_0.txt EXPECTING 0

WRITE expected_0.txt UNTIL EOF
2> Interpreting standard input as YAML multi-document
2> ok: tag:sourcemeta.com,2026:jsonschema/stdin (entry #1)
2> ok: tag:sourcemeta.com,2026:jsonschema/stdin (entry #2)
2> ok: tag:sourcemeta.com,2026:jsonschema/stdin (entry #3)
2>
2> 3 validated, 3 passed, 0 failed
EOF

COMPARE result_0.txt AGAINST expected_0.txt
