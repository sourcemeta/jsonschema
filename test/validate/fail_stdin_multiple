WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "string"
}
EOF

WRITE stdin_input UNTIL EOF
"foo"
EOF

// Invalid CLI arguments
RUN validate schema.json - - STDIN stdin_input IN . INTO result_0.txt EXPECTING 5

WRITE expected_0.txt UNTIL EOF
2> error: Cannot read from standard input more than once
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Invalid CLI arguments
RUN validate schema.json - - --json STDIN stdin_input IN . INTO result_1.txt EXPECTING 5

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "Cannot read from standard input more than once"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
