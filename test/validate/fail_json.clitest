WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test",
  "description": "Test schema",
  "type": "object",
  "properties": {
    "foo": {
      "type": "string"
    }
  }
}
EOF

WRITE instance.json UNTIL EOF
{ "foo": 1 }
EOF

// Validation failure
RUN validate schema.json instance.json --json STDIN /dev/null IN . INTO result_0.txt EXPECTING 2

REPLACE $CWD WITH '[CWD]' IN result_0.txt
REPLACE 'file:///\[CWD\]' WITH 'file://[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
1> {
1>   "valid": false,
1>   "errors": [
1>     {
1>       "keywordLocation": "/properties/foo/type",
1>       "absoluteKeywordLocation": "file://[CWD]/schema.json#/properties/foo/type",
1>       "instanceLocation": "/foo",
1>       "instancePosition": [ 1, 3, 1, 10 ],
1>       "error": "The value was expected to be of type string but it was of type integer"
1>     },
1>     {
1>       "keywordLocation": "/properties",
1>       "absoluteKeywordLocation": "file://[CWD]/schema.json#/properties",
1>       "instanceLocation": "",
1>       "instancePosition": [ 1, 1, 1, 12 ],
1>       "error": "The object value was expected to validate against the single defined property subschema"
1>     }
1>   ]
1> }
EOF

COMPARE result_0.txt AGAINST expected_0.txt
