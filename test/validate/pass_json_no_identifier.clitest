WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test",
  "description": "Test schema",
  "properties": {
    "foo": {
      "type": "string"
    }
  }
}
EOF

WRITE instance.json UNTIL EOF
{ "foo": "bar" }
EOF

RUN validate schema.json instance.json --json STDIN /dev/null IN . INTO result.txt EXPECTING 0

REPLACE '\\\\' WITH '/' IN result.txt
REPLACE '\\(?!")' WITH '/' IN result.txt
REPLACE $CWD WITH '[CWD]' IN result.txt
REPLACE 'file:///\[CWD\]' WITH 'file://[CWD]' IN result.txt

WRITE expected.txt UNTIL EOF
1> {
1>   "valid": true,
1>   "annotations": [
1>     {
1>       "keywordLocation": "/description",
1>       "absoluteKeywordLocation": "file://[CWD]/schema.json#/description",
1>       "instanceLocation": "",
1>       "instancePosition": [ 1, 1, 1, 16 ],
1>       "annotation": [ "Test schema" ]
1>     },
1>     {
1>       "keywordLocation": "/properties",
1>       "absoluteKeywordLocation": "file://[CWD]/schema.json#/properties",
1>       "instanceLocation": "",
1>       "instancePosition": [ 1, 1, 1, 16 ],
1>       "annotation": [ "foo" ]
1>     },
1>     {
1>       "keywordLocation": "/title",
1>       "absoluteKeywordLocation": "file://[CWD]/schema.json#/title",
1>       "instanceLocation": "",
1>       "instancePosition": [ 1, 1, 1, 16 ],
1>       "annotation": [ "Test" ]
1>     }
1>   ]
1> }
EOF

COMPARE result.txt AGAINST expected.txt
