// A `--resolve` document whose nested resources each declare both `$id` and
// `id` with different values must import promptly with `--http` enabled, no
// matter how deeply those resources nest, and the deepest of them must resolve
// locally without any network round trip

ENV SOURCEMETA_CORE_CURL_SO $CWD/does-not-exist.so

WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "https://example.com/level-32"
}
EOF

WRITE deep.json UNTIL EOF
{ "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://example.com/level-0", "$defs": { "nested":
{ "$id": "level-1", "id": "decoy", "$defs": { "nested":
{ "$id": "level-2", "id": "decoy", "$defs": { "nested":
{ "$id": "level-3", "id": "decoy", "$defs": { "nested":
{ "$id": "level-4", "id": "decoy", "$defs": { "nested":
{ "$id": "level-5", "id": "decoy", "$defs": { "nested":
{ "$id": "level-6", "id": "decoy", "$defs": { "nested":
{ "$id": "level-7", "id": "decoy", "$defs": { "nested":
{ "$id": "level-8", "id": "decoy", "$defs": { "nested":
{ "$id": "level-9", "id": "decoy", "$defs": { "nested":
{ "$id": "level-10", "id": "decoy", "$defs": { "nested":
{ "$id": "level-11", "id": "decoy", "$defs": { "nested":
{ "$id": "level-12", "id": "decoy", "$defs": { "nested":
{ "$id": "level-13", "id": "decoy", "$defs": { "nested":
{ "$id": "level-14", "id": "decoy", "$defs": { "nested":
{ "$id": "level-15", "id": "decoy", "$defs": { "nested":
{ "$id": "level-16", "id": "decoy", "$defs": { "nested":
{ "$id": "level-17", "id": "decoy", "$defs": { "nested":
{ "$id": "level-18", "id": "decoy", "$defs": { "nested":
{ "$id": "level-19", "id": "decoy", "$defs": { "nested":
{ "$id": "level-20", "id": "decoy", "$defs": { "nested":
{ "$id": "level-21", "id": "decoy", "$defs": { "nested":
{ "$id": "level-22", "id": "decoy", "$defs": { "nested":
{ "$id": "level-23", "id": "decoy", "$defs": { "nested":
{ "$id": "level-24", "id": "decoy", "$defs": { "nested":
{ "$id": "level-25", "id": "decoy", "$defs": { "nested":
{ "$id": "level-26", "id": "decoy", "$defs": { "nested":
{ "$id": "level-27", "id": "decoy", "$defs": { "nested":
{ "$id": "level-28", "id": "decoy", "$defs": { "nested":
{ "$id": "level-29", "id": "decoy", "$defs": { "nested":
{ "$id": "level-30", "id": "decoy", "$defs": { "nested":
{ "$id": "level-31", "id": "decoy", "$defs": { "nested":
{ "$id": "level-32", "id": "decoy", "type": "string" }
} } } } } } } } } } } } } } } }
} } } } } } } } } } } } } } } }
} } } } } } } } } } } } } } } }
} } } } } } } } } } } } } } } }
EOF

WRITE instance.json UNTIL EOF
"hello"
EOF

RUN validate schema.json instance.json --http --resolve deep.json --verbose STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

WRITE expected_0.txt UNTIL EOF
2> ok: instance.json
2>
2> 1 validated, 1 passed, 0 failed
EOF

COMPARE result_0.txt AGAINST expected_0.txt
