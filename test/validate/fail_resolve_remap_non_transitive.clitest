WRITE schema.json UNTIL EOF
{
  "id": "https://example.com",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "properties": {
    "foo": { "$ref": "other" }
  }
}
EOF

WRITE remote.json UNTIL EOF
{
  "id": "https://example.com/nested",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "integer"
}
EOF

WRITE jsonschema.json UNTIL EOF
{
  "resolve": {
    "https://example.com/other": "https://example.com/middle",
    "https://example.com/middle": "https://example.com/nested"
  }
}
EOF

WRITE instance.json UNTIL EOF
{ "foo": 1 }
EOF

// Schema input error
RUN validate schema.json instance.json --resolve remote.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: Could not resolve the reference to an external schema
2>   at identifier https://example.com/other
2>   at file path [CWD]/schema.json
2>
2> This is likely because you forgot to import such schema using `--resolve/-r`
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Schema input error
RUN validate schema.json instance.json --resolve remote.json --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "Could not resolve the reference to an external schema",
1>   "identifier": "https://example.com/other",
1>   "filePath": "[CWD]/schema.json"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
