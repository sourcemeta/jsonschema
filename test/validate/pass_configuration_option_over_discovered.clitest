MAKE DIRECTORY config

WRITE schema.json UNTIL EOF
{
  "properties": {
    "foo": {
      "type": "string"
    }
  }
}
EOF

WRITE instance.json UNTIL EOF
{ "foo": "bar" }
EOF

WRITE jsonschema.json UNTIL EOF
{
  "defaultDialect": 1
}
EOF

WRITE config/jsonschema.json UNTIL EOF
{
  "defaultDialect": "https://json-schema.org/draft/2020-12/schema"
}
EOF

RUN validate --configuration config/jsonschema.json --debug $CWD/schema.json $CWD/instance.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> Using configuration file: [CWD]/config/jsonschema.json
2> ok: [CWD]/instance.json
2>   matches [CWD]/schema.json
2>
2> 1 validated, 1 passed, 0 failed
EOF

COMPARE result_0.txt AGAINST expected_0.txt
