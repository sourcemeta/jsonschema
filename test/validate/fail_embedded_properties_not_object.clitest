WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com",
  "properties": {
    "foo": { "$ref": "#/$defs/inner" }
  },
  "$defs": {
    "inner": {
      "$id": "https://example.com/inner",
      "properties": true
    }
  }
}
EOF

WRITE instance.json UNTIL EOF
{}
EOF

// Schema input error
RUN validate schema.json instance.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: This keyword was expected to be set to an object whose values are valid schemas
2>   at line 10
2>   at column 7
2>   at file path [CWD]/schema.json
2>   at location "/properties"
2>   at base uri https://example.com/inner
2>
2> Use the `metaschema` command to check the schema against its meta-schema
EOF

COMPARE result_0.txt AGAINST expected_0.txt
