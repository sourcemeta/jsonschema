// Spelling that identity out in full reaches the same schema the relative
// form does, and is held to it.

WRITE openapi.json UNTIL EOF
{
  "openapi": "3.2.0",
  "$self": "https://example.com/api",
  "info": { "title": "Example", "version": "1.0.0" },
  "paths": {},
  "components": { "schemas": { "S": { "type": "string" } } }
}
EOF

WRITE instance.json UNTIL EOF
42
EOF

// Validation failure
RUN validate openapi.json instance.json --entrypoint https://example.com/api#/components/schemas/S STDIN /dev/null IN . INTO result_0.txt EXPECTING 2

WRITE expected_0.txt UNTIL EOF
2> fail: instance.json
2> error: Schema validation failure
2>   The value was expected to be of type string but it was of type integer
2>     at instance location "" (line 1, column 1)
2>     at evaluate path "/type"
2>
2> 1 validated, 0 passed, 1 failed
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Validation failure
RUN validate openapi.json instance.json --entrypoint https://example.com/api#/components/schemas/S --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 2

WRITE expected_1.txt UNTIL EOF
1> {
1>   "valid": false,
1>   "errors": [
1>     {
1>       "keywordLocation": "/type",
1>       "absoluteKeywordLocation": "https://example.com/api#/components/schemas/S/type",
1>       "instanceLocation": "",
1>       "instancePosition": [ 1, 1, 1, 2 ],
1>       "error": "The value was expected to be of type string but it was of type integer"
1>     }
1>   ]
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
