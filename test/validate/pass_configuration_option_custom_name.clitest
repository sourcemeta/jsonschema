WRITE schema.json UNTIL EOF
{
  "properties": {
    "foo": {
      "type": "string"
    }
  }
}
EOF

WRITE instance.json UNTIL EOF
{ "foo": "bar" }
EOF

WRITE jsonschema.ci.json UNTIL EOF
{
  "defaultDialect": "https://json-schema.org/draft/2020-12/schema"
}
EOF

RUN validate --configuration jsonschema.ci.json --verbose $CWD/schema.json $CWD/instance.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> Using configuration file: [CWD]/jsonschema.ci.json
2> ok: instance.json
2>
2> 1 validated, 1 passed, 0 failed
EOF

COMPARE result_0.txt AGAINST expected_0.txt
