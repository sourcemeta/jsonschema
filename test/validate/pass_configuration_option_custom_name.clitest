WRITE schema.json UNTIL EOF
{
  "properties": {
    "foo": {
      "type": "string"
    }
  }
}
EOF

WRITE instance.json UNTIL EOF
{ "foo": "bar" }
EOF

WRITE jsonschema.ci.json UNTIL EOF
{
  "defaultDialect": "https://json-schema.org/draft/2020-12/schema"
}
EOF

RUN validate --configuration jsonschema.ci.json --verbose $CWD/schema.json $CWD/instance.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> Using configuration file: [CWD]/jsonschema.ci.json
2> ok: [CWD]/instance.json
2>   matches [CWD]/schema.json
2> annotation: "foo"
2>   at instance location "" (line 1, column 1)
2>   at evaluate path "/properties"
EOF

COMPARE result_0.txt AGAINST expected_0.txt
