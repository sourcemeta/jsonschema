WRITE schema.json UNTIL EOF
{
  "type": "string"
}
EOF

WRITE instance.json UNTIL EOF
"foo"
EOF

WRITE jsonschema.json UNTIL EOF
{
  "defaultDialect": 1
}
EOF

// Other input error
RUN validate schema.json instance.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 6
REPLACE '\\\\' WITH '/' IN result_0.txt
REPLACE '\\(?!")' WITH '/' IN result_0.txt

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: The defaultDialect property must be a string
2>   at line 2
2>   at column 3
2>   at file path [CWD]/jsonschema.json
2>   at location "/defaultDialect"
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Other input error
RUN validate --json schema.json instance.json STDIN /dev/null IN . INTO result_1.txt EXPECTING 6
REPLACE '\\\\' WITH '/' IN result_1.txt
REPLACE '\\(?!")' WITH '/' IN result_1.txt

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "The defaultDialect property must be a string",
1>   "line": 2,
1>   "column": 3,
1>   "filePath": "[CWD]/jsonschema.json",
1>   "location": "/defaultDialect"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
