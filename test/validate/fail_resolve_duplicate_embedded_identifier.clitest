// Two embedded resources in the same `--resolve` input that declare the
// same identifier must keep raising the established duplicate-identifier
// error instead of silently discarding one of them.

WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "string"
}
EOF

WRITE duplicate.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/container",
  "$defs": {
    "first": {
      "$id": "https://example.com/duplicate",
      "type": "string"
    },
    "second": {
      "$id": "https://example.com/duplicate",
      "type": "integer"
    }
  }
}
EOF

WRITE instance.json UNTIL EOF
"hello"
EOF

// Schema input error
RUN validate schema.json instance.json --resolve duplicate.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: Schema identifier already exists
2>   at identifier https://example.com/duplicate
2>   at file path [CWD]/duplicate.json
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Schema input error
RUN validate schema.json instance.json --resolve duplicate.json --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "Schema identifier already exists",
1>   "identifier": "https://example.com/duplicate",
1>   "filePath": "[CWD]/duplicate.json"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
