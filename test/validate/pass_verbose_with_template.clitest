WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test",
  "description": "Test schema",
  "properties": {
    "foo": {
      "type": "string"
    }
  }
}
EOF

WRITE instance.json UNTIL EOF
{ "foo": "bar" }
EOF

RUN compile schema.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

EXTRACT STDOUT FROM result_0.txt INTO template.json

RUN validate schema.json instance.json --verbose --template template.json STDIN /dev/null IN . INTO result_1.txt EXPECTING 0

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
2> Parsing pre-compiled schema template: [CWD]/template.json
2> ok: [CWD]/instance.json
2>   matches [CWD]/schema.json
2>
2> 1 validated, 1 passed, 0 failed
EOF

COMPARE result_1.txt AGAINST expected_1.txt
