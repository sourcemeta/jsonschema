// An imported file answers for the single schema it declares at its root. A
// resource it merely embeds is reachable from within that file and from
// nowhere else, so naming one from the outside is told where it sits rather
// than being advised to import what is already imported.

WRITE outer.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/outer",
  "$defs": {
    "inner": { "$id": "https://example.com/inner", "type": "string" }
  }
}
EOF

WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "https://example.com/inner"
}
EOF

WRITE instance.json UNTIL EOF
"hello"
EOF

// Schema input error
RUN validate schema.json instance.json --resolve outer.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: This identifier is embedded in an imported schema, so only that schema can reach it
2>   at identifier https://example.com/inner
2>   at line 5
2>   at column 5
2>   at file path [CWD]/outer.json
2>   at location "/$defs/inner"
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Schema input error
RUN validate schema.json instance.json --resolve outer.json --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "This identifier is embedded in an imported schema, so only that schema can reach it",
1>   "identifier": "https://example.com/inner",
1>   "line": 5,
1>   "column": 5,
1>   "filePath": "[CWD]/outer.json",
1>   "location": "/$defs/inner"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt

WRITE root.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "https://example.com/outer"
}
EOF

// The root identifier of that very same file still answers
RUN validate root.json instance.json --resolve outer.json --verbose STDIN /dev/null IN . INTO result_2.txt EXPECTING 0

WRITE expected_2.txt UNTIL EOF
2> ok: instance.json
2>
2> 1 validated, 1 passed, 0 failed
EOF

COMPARE result_2.txt AGAINST expected_2.txt
