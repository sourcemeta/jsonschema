WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test",
  "description": "Test schema",
  "$ref": "http://example.com/schema.yaml"
}
EOF

WRITE schema.yaml UNTIL EOF
$id: http://example.com/schema.yaml
$schema: https://json-schema.org/draft/2020-12/schema
type: string
EOF

WRITE instance.json UNTIL EOF
"foo"
EOF

RUN validate schema.json --resolve schema.yaml instance.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

WRITE expected_0.txt UNTIL EOF
EOF

COMPARE result_0.txt AGAINST expected_0.txt
