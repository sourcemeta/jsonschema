MAKE DIRECTORY instances/drafts

WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test",
  "description": "Test schema",
  "properties": {
    "name": {
      "type": "string"
    }
  }
}
EOF

WRITE instances/instance_1.json UNTIL EOF
{ "name": "Alice" }
EOF

WRITE instances/drafts/invalid.json UNTIL EOF
{ "name": 123 }
EOF

RUN validate schema.json instances --ignore instances/drafts --verbose STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> Ignoring path: "[CWD]/instances/drafts"
2> ok: instances/instance_1.json
2>   matches schema.json
2>
2> 1 validated, 1 passed, 0 failed
EOF

COMPARE result_0.txt AGAINST expected_0.txt
