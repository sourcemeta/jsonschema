MAKE DIRECTORY schemas

WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test",
  "description": "Test schema",
  "$ref": "./schemas/other.json"
}
EOF

WRITE schemas/other.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test",
  "description": "Test schema",
  "type": "string"
}
EOF

WRITE instance.json UNTIL EOF
"foo bar"
EOF

RUN validate schema.json instance.json --verbose STDIN /dev/null IN . INTO result_0.txt EXPECTING 0
REPLACE '\\\\' WITH '/' IN result_0.txt
REPLACE '\\(?!")' WITH '/' IN result_0.txt

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> ok: [CWD]/instance.json
2>   matches [CWD]/schema.json
2> annotation: "Test schema"
2>   at instance location "" (line 1, column 1)
2>   at evaluate path "/$ref/description"
2> annotation: "Test"
2>   at instance location "" (line 1, column 1)
2>   at evaluate path "/$ref/title"
2> annotation: "Test schema"
2>   at instance location "" (line 1, column 1)
2>   at evaluate path "/description"
2> annotation: "Test"
2>   at instance location "" (line 1, column 1)
2>   at evaluate path "/title"
EOF

COMPARE result_0.txt AGAINST expected_0.txt
