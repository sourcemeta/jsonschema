MAKE DIRECTORY schema-directory

WRITE instance.json UNTIL EOF
{ "foo": 1 }
EOF

// Other input error
RUN validate schema-directory instance.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 6

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: The input was supposed to be a file but it is a directory
2>   at file path [CWD]/schema-directory
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Other input error
RUN validate schema-directory instance.json --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 6

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "The input was supposed to be a file but it is a directory",
1>   "filePath": "[CWD]/schema-directory"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
