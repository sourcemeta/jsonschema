WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object"
}
EOF

WRITE resolve.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://example.com/bad-recref",
  "$recursiveRef": "not-hash"
}
EOF

WRITE instance.json UNTIL EOF
{ "foo": "bar" }
EOF

// Schema input error
RUN validate schema.json instance.json --resolve resolve.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 4
REPLACE '\\\\' WITH '/' IN result_0.txt
REPLACE '\\(?!")' WITH '/' IN result_0.txt

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: Invalid recursive reference
2>   at identifier https://example.com/bad-recref
2>   at file path [CWD]/resolve.json
2>   at location "/$recursiveRef"
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Schema input error
RUN validate schema.json instance.json --resolve resolve.json --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 4
REPLACE '\\\\' WITH '/' IN result_1.txt
REPLACE '\\(?!")' WITH '/' IN result_1.txt

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "Invalid recursive reference",
1>   "identifier": "https://example.com/bad-recref",
1>   "filePath": "[CWD]/resolve.json",
1>   "location": "/$recursiveRef"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
