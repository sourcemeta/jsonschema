WRITE defs.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/defs",
  "type": "string"
}
EOF

WRITE instance.json UNTIL EOF
"hello"
EOF

WRITE stdin_0 UNTIL EOF
{"$schema":"https://json-schema.org/draft/2020-12/schema","$ref":"https://example.com/defs"}
EOF

// Schema from stdin referencing a resolved external schema
RUN validate - instance.json --resolve defs.json --verbose STDIN stdin_0 IN . INTO result.txt EXPECTING 0

WRITE expected.txt UNTIL EOF
2> ok: instance.json
2>
2> 1 validated, 1 passed, 0 failed
EOF

COMPARE result.txt AGAINST expected.txt
