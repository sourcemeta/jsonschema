WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test",
  "description": "Test schema",
  "properties": {
    "foo": {
      "type": "string"
    }
  }
}
EOF

WRITE instance.json UNTIL EOF
{ "foo": "bar" }
EOF

// Invalid CLI arguments
RUN validate schema.json instance.json --annotations --trace STDIN /dev/null IN . INTO result_0.txt EXPECTING 5

WRITE expected_0.txt UNTIL EOF
2> error: The `--annotations/-a` option cannot be used with `--trace/-t`, as trace output already reports annotations
EOF

COMPARE result_0.txt AGAINST expected_0.txt
