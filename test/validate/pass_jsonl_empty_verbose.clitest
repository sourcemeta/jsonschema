WRITE schema.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Test",
  "description": "Test schema",
  "properties": {
    "foo": {
      "type": "string"
    }
  }
}
EOF

WRITE instance.jsonl UNTIL EOF
EOF

RUN validate schema.json instance.jsonl --verbose STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> Interpreting input as JSONL: [CWD]/instance.jsonl
2> warning: The JSONL file is empty
EOF

COMPARE result_0.txt AGAINST expected_0.txt
