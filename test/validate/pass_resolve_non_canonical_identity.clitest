// A locally supplied identifier is matched however the document happens to
// spell it. The meta-schema below writes its `$id` in a non-canonical but
// equivalent form, uppercased and carrying the default port, while the schema
// that names it stays canonical. The cURL library cannot be loaded, so the run
// succeeding is what proves the match was made locally and nothing reached for
// the network.

ENV SOURCEMETA_CORE_CURL_SO $CWD/does-not-exist.so

WRITE schema.json UNTIL EOF
{
  "$schema": "https://example.com/meta",
  "type": "string"
}
EOF

WRITE meta.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "HTTPS://Example.COM:443/meta",
  "$vocabulary": {
    "https://json-schema.org/draft/2020-12/vocab/core": true,
    "https://json-schema.org/draft/2020-12/vocab/applicator": true,
    "https://json-schema.org/draft/2020-12/vocab/validation": true
  }
}
EOF

WRITE instance.json UNTIL EOF
"hello"
EOF

WRITE expected_0.txt UNTIL EOF
2> 1 validated, 1 passed, 0 failed
EOF

RUN validate schema.json instance.json --http --resolve meta.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

REPLACE $CWD WITH '[CWD]' IN result_0.txt

COMPARE result_0.txt AGAINST expected_0.txt
