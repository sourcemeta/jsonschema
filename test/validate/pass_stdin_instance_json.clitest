WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test",
  "description": "Test schema",
  "$id": "https://example.com",
  "properties": {
    "foo": {
      "type": "string"
    }
  }
}
EOF

WRITE stdin_0 UNTIL EOF
{ "foo": "bar" }
EOF

RUN validate schema.json - --json STDIN stdin_0 IN . INTO result.txt EXPECTING 0

WRITE expected.txt UNTIL EOF
1> {
1>   "valid": true,
1>   "annotations": [
1>     {
1>       "keywordLocation": "/description",
1>       "absoluteKeywordLocation": "https://example.com#/description",
1>       "instanceLocation": "",
1>       "instancePosition": [ 1, 1, 1, 16 ],
1>       "annotation": "Test schema"
1>     },
1>     {
1>       "keywordLocation": "/properties",
1>       "absoluteKeywordLocation": "https://example.com#/properties",
1>       "instanceLocation": "",
1>       "instancePosition": [ 1, 1, 1, 16 ],
1>       "annotation": [ "foo" ]
1>     },
1>     {
1>       "keywordLocation": "/title",
1>       "absoluteKeywordLocation": "https://example.com#/title",
1>       "instanceLocation": "",
1>       "instancePosition": [ 1, 1, 1, 16 ],
1>       "annotation": "Test"
1>     }
1>   ]
1> }
2> tag:sourcemeta.com,2026:jsonschema/stdin
EOF

COMPARE result.txt AGAINST expected.txt
