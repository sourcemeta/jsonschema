WRITE schema.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Test",
  "description": "Test schema",
  "properties": {
    "foo": {
      "type": "string"
    }
  }
}
EOF

WRITE empty.jsonl UNTIL EOF
EOF

WRITE instance.jsonl UNTIL EOF
{ "foo": "first" }
{ "foo": "second" }
EOF

RUN validate schema.json empty.jsonl instance.jsonl STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

WRITE expected_0.txt UNTIL EOF
2> warning: The JSONL file is empty
2> 2 validated, 2 passed, 0 failed
EOF

COMPARE result_0.txt AGAINST expected_0.txt
