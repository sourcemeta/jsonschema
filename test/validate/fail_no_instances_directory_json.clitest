MAKE DIRECTORY instances

WRITE schema.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Test",
  "description": "Test schema",
  "properties": {
    "foo": {
      "type": "string"
    }
  }
}
EOF

// Other input error
RUN validate schema.json instances --json STDIN /dev/null IN . INTO result_0.txt EXPECTING 6

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
1> {
1>   "error": "No input files found",
1>   "filePath": "[CWD]/instances"
1> }
EOF

COMPARE result_0.txt AGAINST expected_0.txt
