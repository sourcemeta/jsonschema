MAKE DIRECTORY instances

WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test",
  "description": "Test schema",
  "properties": {
    "name": {
      "type": "string"
    }
  }
}
EOF

WRITE instances/instance_1.data.json UNTIL EOF
{ "name": "Alice" }
EOF

WRITE instances/instance_2.data.json UNTIL EOF
{ "name": "Bob" }
EOF

WRITE instances/other.json UNTIL EOF
{ "name": 123 }
EOF

RUN validate schema.json instances --extension .data.json --verbose STDIN /dev/null IN . INTO result_0.txt EXPECTING 0
REPLACE '\\\\' WITH '/' IN result_0.txt
