// A locally supplied identifier must be shielded from remote fetching however
// the document happens to spell it. This is the fixture of
// `fail_resolve_custom_metaschema_cycle_http` with one `$id` written in a
// non-canonical but equivalent form, uppercased and carrying the default
// port, while the reference to it stays canonical. The run must still
// terminate with the local resolution diagnostic and no network round trip.

WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "string"
}
EOF

WRITE meta-x.json UNTIL EOF
{
  "$schema": "https://example.com/meta-y",
  "$id": "https://example.com/meta-x",
  "$vocabulary": {
    "https://json-schema.org/draft/2020-12/vocab/core": true,
    "https://json-schema.org/draft/2020-12/vocab/applicator": true,
    "https://json-schema.org/draft/2020-12/vocab/validation": true
  }
}
EOF

WRITE meta-y.json UNTIL EOF
{
  "$schema": "https://example.com/meta-x",
  "$id": "HTTPS://EXAMPLE.COM:443/meta-y",
  "$vocabulary": {
    "https://json-schema.org/draft/2020-12/vocab/core": true,
    "https://json-schema.org/draft/2020-12/vocab/applicator": true,
    "https://json-schema.org/draft/2020-12/vocab/validation": true
  }
}
EOF

WRITE instance.json UNTIL EOF
"hello"
EOF

// Schema input error
RUN validate schema.json instance.json --http --resolve meta-x.json --resolve meta-y.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_0.txt
REPLACE 'https://example.com/meta-x' WITH '[STUCK]' IN result_0.txt
REPLACE 'https://example.com/meta-y' WITH '[STUCK]' IN result_0.txt
REPLACE '[CWD]/meta-x.json' WITH '[INPUT]' IN result_0.txt
REPLACE '[CWD]/meta-y.json' WITH '[INPUT]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: Could not resolve the metaschema of the schema
2>   at identifier [STUCK]
2>   at file path [INPUT]
2>
2> This is likely because you forgot to import such schema using `--resolve/-r`
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Schema input error
RUN validate schema.json instance.json --http --resolve meta-x.json --resolve meta-y.json --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_1.txt
REPLACE 'https://example.com/meta-x' WITH '[STUCK]' IN result_1.txt
REPLACE 'https://example.com/meta-y' WITH '[STUCK]' IN result_1.txt
REPLACE '[CWD]/meta-x.json' WITH '[INPUT]' IN result_1.txt
REPLACE '[CWD]/meta-y.json' WITH '[INPUT]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "Could not resolve the metaschema of the schema",
1>   "identifier": "[STUCK]",
1>   "filePath": "[INPUT]"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
