WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test",
  "description": "Test schema",
  "$id": "https://example.com",
  "$ref": "#/$defs/string",
  "$defs": {
    "string": { "type": "string" }
  }
}
EOF

// Invalid CLI arguments
RUN inspect schema.json --json=foo STDIN /dev/null IN . INTO result_0.txt EXPECTING 5

WRITE expected_0.txt UNTIL EOF
2> error: This flag cannot take a value
2>   at option json
2>
2> Run the `help` command for usage information
EOF

COMPARE result_0.txt AGAINST expected_0.txt
