// Stopping at the first failure counts the schemas a description holds, not
// the files, and the structured output reports only the one that was reached.

WRITE openapi.json UNTIL EOF
{
  "openapi": "3.1.1",
  "info": { "title": "Example", "version": "1.0.0" },
  "paths": {},
  "components": {
    "schemas": { "A": { "type": 42 }, "B": { "type": 42 } }
  }
}
EOF

// Validation failure
RUN metaschema openapi.json --json STDIN /dev/null IN . INTO result.txt EXPECTING 2

WRITE expected.txt UNTIL EOF
1> {
1>   "valid": false,
1>   "errors": [
1>     {
1>       "keywordLocation": "/allOf/0/$ref/allOf/3/$ref/properties/type/anyOf/0/$ref/enum",
1>       "absoluteKeywordLocation": "https://json-schema.org/draft/2020-12/meta/validation#/$defs/simpleTypes/enum",
1>       "instanceLocation": "/type",
1>       "error": "The integer value 42 was expected to equal one of the following values: \"array\", \"boolean\", \"integer\", \"null\", \"number\", \"object\", and \"string\"",
1>       "instancePosition": [ 6, 25, 6, 34 ]
1>     },
1>     {
1>       "keywordLocation": "/allOf/0/$ref/allOf/3/$ref/properties/type/anyOf/0/$ref",
1>       "absoluteKeywordLocation": "https://json-schema.org/draft/2020-12/meta/validation#/properties/type/anyOf/0/$ref",
1>       "instanceLocation": "/type",
1>       "error": "The integer value was expected to validate against the referenced schema",
1>       "instancePosition": [ 6, 25, 6, 34 ]
1>     },
1>     {
1>       "keywordLocation": "/allOf/0/$ref/allOf/3/$ref/properties/type/anyOf/1/type",
1>       "absoluteKeywordLocation": "https://json-schema.org/draft/2020-12/meta/validation#/properties/type/anyOf/1/type",
1>       "instanceLocation": "/type",
1>       "error": "The value was expected to be of type array but it was of type integer",
1>       "instancePosition": [ 6, 25, 6, 34 ]
1>     },
1>     {
1>       "keywordLocation": "/allOf/0/$ref/allOf/3/$ref/properties/type/anyOf",
1>       "absoluteKeywordLocation": "https://json-schema.org/draft/2020-12/meta/validation#/properties/type/anyOf",
1>       "instanceLocation": "/type",
1>       "error": "The integer value was expected to validate against at least one of the 2 given subschemas",
1>       "instancePosition": [ 6, 25, 6, 34 ]
1>     },
1>     {
1>       "keywordLocation": "/allOf/0/$ref/allOf/3/$ref/properties",
1>       "absoluteKeywordLocation": "https://json-schema.org/draft/2020-12/meta/validation#/properties",
1>       "instanceLocation": "",
1>       "instancePosition": [ 6, 18, 6, 36 ],
1>       "error": "The object value was expected to validate against the 20 defined properties subschemas"
1>     },
1>     {
1>       "keywordLocation": "/allOf/0/$ref/allOf/3/$ref",
1>       "absoluteKeywordLocation": "https://json-schema.org/draft/2020-12/schema#/allOf/3/$ref",
1>       "instanceLocation": "",
1>       "instancePosition": [ 6, 18, 6, 36 ],
1>       "error": "The object value was expected to validate against the referenced schema"
1>     },
1>     {
1>       "keywordLocation": "/allOf/0/$ref/allOf",
1>       "absoluteKeywordLocation": "https://json-schema.org/draft/2020-12/schema#/allOf",
1>       "instanceLocation": "",
1>       "instancePosition": [ 6, 18, 6, 36 ],
1>       "error": "The object value was expected to validate against the 7 given subschemas"
1>     },
1>     {
1>       "keywordLocation": "/allOf/0/$ref",
1>       "absoluteKeywordLocation": "https://spec.openapis.org/oas/3.1/dialect/base#/allOf/0/$ref",
1>       "instanceLocation": "",
1>       "instancePosition": [ 6, 18, 6, 36 ],
1>       "error": "The object value was expected to validate against the referenced schema"
1>     },
1>     {
1>       "keywordLocation": "/allOf",
1>       "absoluteKeywordLocation": "https://spec.openapis.org/oas/3.1/dialect/base#/allOf",
1>       "instanceLocation": "",
1>       "instancePosition": [ 6, 18, 6, 36 ],
1>       "error": "The object value was expected to validate against the 2 given subschemas"
1>     }
1>   ]
1> }
2> openapi.json#/components/schemas/A
2> warning: Stopped at first failure, pass --continue/-c to keep going
EOF

COMPARE result.txt AGAINST expected.txt
