// Asking to keep going checks every Schema Object the description holds
// rather than stopping at the first that fails.

WRITE openapi.json UNTIL EOF
{
  "openapi": "3.1.1",
  "info": { "title": "Example", "version": "1.0.0" },
  "paths": {},
  "components": {
    "schemas": { "A": { "type": 42 }, "B": { "type": 42 } }
  }
}
EOF

// Validation failure
RUN metaschema openapi.json --continue STDIN /dev/null IN . INTO result_0.txt EXPECTING 2

WRITE expected_0.txt UNTIL EOF
