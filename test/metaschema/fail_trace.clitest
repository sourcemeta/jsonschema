1>    at keyword location "http://json-schema.org/draft-04/schema#/properties/minimum/type"
1>    at vocabulary "http://json-schema.org/draft-04/schema#"
1>
1> <- (fail) "/properties/minimum/type" (AssertionTypeStrictAny)
1>    at instance location "/minimum" (line 5, column 3)
1>    at keyword location "http://json-schema.org/draft-04/schema#/properties/minimum/type"
