WRITE schema.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Test",
  "description": "Test schema",
  "minimum": "foo"
}
EOF

// Metaschema validation failure
RUN metaschema schema.json --trace STDIN /dev/null IN . INTO result.txt EXPECTING 2

WRITE expected.txt UNTIL EOF
1> -> (push) "/dependencies" (AssertionPropertyDependencies)
1>    at instance location "" (line 1, column 1)
1>    at keyword location "http://json-schema.org/draft-04/schema#/dependencies"
