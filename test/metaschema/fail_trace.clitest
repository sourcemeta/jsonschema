1> <- (pass) "/properties/title/type" (AssertionTypeStrict)
1>    at instance location "/title" (line 3, column 3)
1>    at keyword location "http://json-schema.org/draft-04/schema#/properties/title/type"
1>    at vocabulary "http://json-schema.org/draft-04/schema#"
1>
1> -> (push) "/properties/description/type" (AssertionTypeStrict)
1>    at instance location "/description" (line 4, column 3)
