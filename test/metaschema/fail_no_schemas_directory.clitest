MAKE DIRECTORY schemas

// Other input error
RUN metaschema schemas STDIN /dev/null IN . INTO result_0.txt EXPECTING 6

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: No input files found
2>   at file path [CWD]/schemas
EOF

COMPARE result_0.txt AGAINST expected_0.txt
