MAKE DIRECTORY schemas

WRITE schemas/schema_1.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "minimum": 1
}
EOF

WRITE schemas/schema_2.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "minimum": 2
}
EOF

// Invalid CLI arguments
RUN metaschema schemas/schema_1.json schemas/schema_2.json --trace STDIN /dev/null IN . INTO result_0.txt EXPECTING 5

WRITE expected_0.txt UNTIL EOF
2> error: The `--trace/-t` option is only allowed given a single schema
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Invalid CLI arguments
RUN metaschema schemas/schema_1.json schemas/schema_2.json --trace --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 5

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "The `--trace/-t` option is only allowed given a single schema"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
