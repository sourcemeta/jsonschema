WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test",
  "description": "Test schema",
  "type": "string"
}
EOF

RUN metaschema schema.json --verbose --color never STDIN /dev/null IN . INTO result.txt EXPECTING 0

WRITE expected.txt UNTIL EOF
2> ok: schema.json
2>   matches https://json-schema.org/draft/2020-12/schema
2>
2> 1 validated, 1 passed, 0 failed
EOF

COMPARE result.txt AGAINST expected.txt
