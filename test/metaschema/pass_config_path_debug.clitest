MAKE DIRECTORY bar

WRITE foo/schema.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Test",
  "description": "Test schema",
  "type": "string"
}
EOF

WRITE jsonschema.json UNTIL EOF
{
  "path": "./foo"
}
EOF

RUN metaschema --debug STDIN /dev/null IN bar INTO result.txt EXPECTING 0
REPLACE '\\\\' WITH '/' IN result.txt
REPLACE '\\(?!")' WITH '/' IN result.txt

REPLACE $CWD WITH '[CWD]' IN result.txt

WRITE expected.txt UNTIL EOF
2> debug: Using configuration file: [CWD]/jsonschema.json
2> Using extension: .json
2> Using extension: .yaml
2> Using extension: .yml
2> ok: [CWD]/foo/schema.json
2>   matches http://json-schema.org/draft-04/schema#
EOF

COMPARE result.txt AGAINST expected.txt
