// Stopping at the first failure holds across the kinds of input, so a
// schema that fails leaves a description that follows it unchecked.

WRITE schema.json UNTIL EOF
{ "$schema": "https://json-schema.org/draft/2020-12/schema", "type": 42 }
EOF

WRITE openapi.json UNTIL EOF
{
  "openapi": "3.1.1",
  "info": { "title": "Example", "version": "1.0.0" },
  "paths": {},
  "components": { "schemas": { "A": { "type": "string" }, "B": { "type": "integer" } } }
}
EOF

// Validation failure
RUN metaschema schema.json openapi.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 2

WRITE expected_0.txt UNTIL EOF
2> fail: schema.json
2>   against https://json-schema.org/draft/2020-12/schema
2> error: Schema validation failure
2>   The integer value 42 was expected to equal one of the following values: "array", "boolean", "integer", "null", "number", "object", and "string"
2>     at instance location "/type" (line 1, column 62)
2>     at evaluate path "/allOf/3/$ref/properties/type/anyOf/0/$ref/enum"
2>   The integer value was expected to validate against the referenced schema
2>     at instance location "/type" (line 1, column 62)
2>     at evaluate path "/allOf/3/$ref/properties/type/anyOf/0/$ref"
2>   The value was expected to be of type array but it was of type integer
2>     at instance location "/type" (line 1, column 62)
2>     at evaluate path "/allOf/3/$ref/properties/type/anyOf/1/type"
2>   The integer value was expected to validate against at least one of the 2 given subschemas
2>     at instance location "/type" (line 1, column 62)
2>     at evaluate path "/allOf/3/$ref/properties/type/anyOf"
2>   The object value was expected to validate against the 20 defined properties subschemas
2>     at instance location "" (line 1, column 1)
2>     at evaluate path "/allOf/3/$ref/properties"
2>   The object value was expected to validate against the referenced schema
2>     at instance location "" (line 1, column 1)
2>     at evaluate path "/allOf/3/$ref"
2>   The object value was expected to validate against the 7 given subschemas
2>     at instance location "" (line 1, column 1)
2>     at evaluate path "/allOf"
2>
2> 1 validated, 0 passed, 1 failed
2> warning: Stopped at first failure, pass --continue/-c to keep going
EOF

COMPARE result_0.txt AGAINST expected_0.txt
