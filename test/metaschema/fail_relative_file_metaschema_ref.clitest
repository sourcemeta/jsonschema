WRITE schemas/folder/test.json UNTIL EOF
{ "$schema": "../meta.json" }
EOF

WRITE schemas/meta.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test",
  "description": "Test schema",
  "$vocabulary": { "https://json-schema.org/draft/2020-12/vocab/core": true },
  "$dynamicAnchor": "meta",
  "$ref": "https://json-schema.org/draft/2020-12/meta/core"
}
EOF

// Schema input error
RUN metaschema schemas/folder/test.json --resolve schemas/meta.json STDIN /dev/null IN . INTO result.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result.txt

WRITE expected.txt UNTIL EOF
2> error: Relative meta-schema URIs are not valid according to the JSON Schema specification
2>   at identifier ../meta.json
2>   at file path [CWD]/schemas/folder/test.json
EOF

COMPARE result.txt AGAINST expected.txt

// Schema input error
RUN metaschema schemas/folder/test.json --resolve schemas/meta.json --json STDIN /dev/null IN . INTO result_json.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_json.txt

WRITE expected_json.txt UNTIL EOF
1> {
1>   "error": "Relative meta-schema URIs are not valid according to the JSON Schema specification",
1>   "identifier": "../meta.json",
1>   "filePath": "[CWD]/schemas/folder/test.json"
1> }
EOF

COMPARE result_json.txt AGAINST expected_json.txt
