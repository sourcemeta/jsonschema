MAKE DIRECTORY schemas

WRITE schemas/schema_1.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "minimum": "foo"
}
EOF

WRITE schemas/schema_2.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "minimum": 1
}
EOF

