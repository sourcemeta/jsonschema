WRITE schemas/schema.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Test",
  "description": "Test schema",
  "type": "string"
}
EOF

WRITE schemas/ignored/bad.json UNTIL EOF
{
  "type": "string"
}
EOF

WRITE jsonschema.json UNTIL EOF
{
  "path": "./schemas",
  "ignore": [
    "./schemas/ignored"
  ]
}
EOF

WRITE silent.txt UNTIL EOF
EOF

RUN metaschema STDIN /dev/null IN . INTO result.txt EXPECTING 0

COMPARE result.txt AGAINST silent.txt
