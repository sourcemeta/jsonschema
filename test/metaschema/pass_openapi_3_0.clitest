WRITE openapi.json UNTIL EOF
{
  "openapi": "3.0.3",
  "info": { "title": "Example", "version": "1.0.0" },
  "paths": {
    "/p": {
      "get": {
        "responses": {
          "200": {
            "description": "ok",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    }
  },
  "components": { "schemas": { "Person": { "type": "string" } } }
}
EOF

RUN metaschema openapi.json --verbose STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

WRITE expected_0.txt UNTIL EOF
2> ok: openapi.json#/components/schemas/Person
2>   matches tag:spec.openapis.org,2024-10-18:oas/3.0/dialect
2> ok: openapi.json#/paths/~1p/get/responses/200/content/application~1json/schema
2>   matches tag:spec.openapis.org,2024-10-18:oas/3.0/dialect
2>
2> 2 validated, 2 passed, 0 failed
EOF

COMPARE result_0.txt AGAINST expected_0.txt
