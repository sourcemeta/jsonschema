// Schemas and descriptions may be given together, and the counts are of the
// schemas checked rather than of the files, so a description holding two
// contributes two beside a schema's one.

WRITE schema.json UNTIL EOF
{ "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "string" }
EOF

WRITE openapi.json UNTIL EOF
{
  "openapi": "3.1.1",
  "info": { "title": "Example", "version": "1.0.0" },
  "paths": {},
  "components": { "schemas": { "A": { "type": "string" }, "B": { "type": "integer" } } }
}
EOF

RUN metaschema schema.json openapi.json --verbose STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

WRITE expected_0.txt UNTIL EOF
2> ok: schema.json
2>   matches https://json-schema.org/draft/2020-12/schema
2> ok: openapi.json#/components/schemas/A
2>   matches https://spec.openapis.org/oas/3.1/dialect/base
2> ok: openapi.json#/components/schemas/B
2>   matches https://spec.openapis.org/oas/3.1/dialect/base
2>
2> 3 validated, 3 passed, 0 failed
EOF

COMPARE result_0.txt AGAINST expected_0.txt
