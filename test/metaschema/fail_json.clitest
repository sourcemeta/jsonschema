WRITE schema.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Test",
  "description": "Test schema",
  "type": 1
}
EOF

// Metaschema validation failure
RUN metaschema schema.json --json STDIN /dev/null IN . INTO result.txt EXPECTING 2
REPLACE '\\\\' WITH '/' IN result.txt
REPLACE '\\(?!")' WITH '/' IN result.txt

REPLACE $CWD WITH '[CWD]' IN result.txt

WRITE expected.txt UNTIL EOF
1> {
1>   "valid": false,
1>   "errors": [
1>     {
1>       "keywordLocation": "/properties/type/anyOf/0/$ref/enum",
1>       "absoluteKeywordLocation": "http://json-schema.org/draft-04/schema#/definitions/simpleTypes/enum",
1>       "instanceLocation": "/type",
1>       "instancePosition": [ 5, 3, 5, 11 ],
1>       "error": "The integer value 1 was expected to equal one of the following values: \"array\", \"boolean\", \"integer\", \"null\", \"number\", \"object\", and \"string\""
1>     },
1>     {
1>       "keywordLocation": "/properties/type/anyOf/0/$ref",
1>       "absoluteKeywordLocation": "http://json-schema.org/draft-04/schema#/properties/type/anyOf/0/$ref",
1>       "instanceLocation": "/type",
1>       "instancePosition": [ 5, 3, 5, 11 ],
1>       "error": "The integer value was expected to validate against the referenced schema"
1>     },
1>     {
1>       "keywordLocation": "/properties/type/anyOf/1/type",
1>       "absoluteKeywordLocation": "http://json-schema.org/draft-04/schema#/properties/type/anyOf/1/type",
1>       "instanceLocation": "/type",
1>       "instancePosition": [ 5, 3, 5, 11 ],
1>       "error": "The value was expected to be of type array but it was of type integer"
1>     },
1>     {
1>       "keywordLocation": "/properties/type/anyOf",
1>       "absoluteKeywordLocation": "http://json-schema.org/draft-04/schema#/properties/type/anyOf",
1>       "instanceLocation": "/type",
1>       "instancePosition": [ 5, 3, 5, 11 ],
1>       "error": "The integer value was expected to validate against at least one of the 2 given subschemas"
1>     },
1>     {
1>       "keywordLocation": "/properties",
1>       "absoluteKeywordLocation": "http://json-schema.org/draft-04/schema#/properties",
1>       "instanceLocation": "",
1>       "instancePosition": [ 1, 1, 6, 1 ],
1>       "error": "The object value was expected to validate against the 33 defined properties subschemas"
1>     }
1>   ]
1> }
2> [CWD]/schema.json
EOF

COMPARE result.txt AGAINST expected.txt
