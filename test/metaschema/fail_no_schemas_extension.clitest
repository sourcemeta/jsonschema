MAKE DIRECTORY schemas

WRITE schemas/schema.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Test",
  "description": "Test schema",
  "type": "string"
}
EOF

// Other input error
RUN metaschema schemas --extension .yaml STDIN /dev/null IN . INTO result_0.txt EXPECTING 6

WRITE expected_0.txt UNTIL EOF
EOF

COMPARE result_0.txt AGAINST expected_0.txt
