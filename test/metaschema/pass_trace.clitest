WRITE schema.json UNTIL EOF
{ "$schema": "http://json-schema.org/draft-04/schema#" }
EOF

RUN metaschema schema.json --trace STDIN /dev/null IN . INTO result.txt EXPECTING 0

WRITE expected.txt UNTIL EOF
1> -> (push) "/dependencies" (AssertionPropertyDependencies)
1>    at instance location "" (line 1, column 1)
1>    at keyword location "http://json-schema.org/draft-04/schema#/dependencies"
1>    at vocabulary "http://json-schema.org/draft-04/schema#"
1>
1> <- (pass) "/dependencies" (AssertionPropertyDependencies)
1>    at instance location "" (line 1, column 1)
1>    at keyword location "http://json-schema.org/draft-04/schema#/dependencies"
1>    at vocabulary "http://json-schema.org/draft-04/schema#"
1>
1> -> (push) "/properties" (LoopPropertiesMatch)
1>    at instance location "" (line 1, column 1)
1>    at keyword location "http://json-schema.org/draft-04/schema#/properties"
1>    at vocabulary "http://json-schema.org/draft-04/schema#"
1>
1> -> (push) "/properties/$schema/type" (AssertionTypeStrict)
1>    at instance location "/$schema" (line 1, column 3)
1>    at keyword location "http://json-schema.org/draft-04/schema#/properties/$schema/type"
1>    at vocabulary "http://json-schema.org/draft-04/schema#"
1>
1> <- (pass) "/properties/$schema/type" (AssertionTypeStrict)
1>    at instance location "/$schema" (line 1, column 3)
1>    at keyword location "http://json-schema.org/draft-04/schema#/properties/$schema/type"
1>    at vocabulary "http://json-schema.org/draft-04/schema#"
1>
1> <- (pass) "/properties" (LoopPropertiesMatch)
1>    at instance location "" (line 1, column 1)
1>    at keyword location "http://json-schema.org/draft-04/schema#/properties"
1>    at vocabulary "http://json-schema.org/draft-04/schema#"
1>
1> -> (push) "/type" (AssertionTypeStrict)
1>    at instance location "" (line 1, column 1)
1>    at keyword location "http://json-schema.org/draft-04/schema#/type"
1>    at vocabulary "http://json-schema.org/draft-04/schema#"
1>
1> <- (pass) "/type" (AssertionTypeStrict)
1>    at instance location "" (line 1, column 1)
1>    at keyword location "http://json-schema.org/draft-04/schema#/type"
1>    at vocabulary "http://json-schema.org/draft-04/schema#"
EOF

COMPARE result.txt AGAINST expected.txt
