// A description holding nothing to check says so without standing in the
// way of the other inputs.

WRITE openapi.json UNTIL EOF
{
  "openapi": "3.1.1",
  "info": { "title": "Example", "version": "1.0.0" },
  "paths": {}
}
EOF

WRITE schema.json UNTIL EOF
{ "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "string" }
EOF

RUN metaschema openapi.json schema.json --verbose STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

WRITE expected_0.txt UNTIL EOF
2> warning: No schema objects were found in openapi.json
2> ok: schema.json
2>   matches https://json-schema.org/draft/2020-12/schema
2>
2> 1 validated, 1 passed, 0 failed
EOF

COMPARE result_0.txt AGAINST expected_0.txt
