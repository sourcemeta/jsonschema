// A remote answering that it does not hold an identifier settles the question
// just as firmly as finding nothing on disk does, so an input that merely
// embeds it is pointed at rather than letting the status stand as the whole
// answer. An identifier nothing embeds keeps reporting the status.

WRITE holder.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/holder",
  "$defs": {
    "x": {
      "$id": "https://schemas.sourcemeta.com/definitely-absent-abc123",
      "type": "string"
    }
  }
}
EOF

WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "https://schemas.sourcemeta.com/definitely-absent-abc123"
}
EOF

WRITE instance.json UNTIL EOF
"hello"
EOF

// Schema input error
RUN validate schema.json instance.json --http --resolve holder.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: This identifier is embedded in an imported schema, so only that schema can reach it
2>   at identifier https://schemas.sourcemeta.com/definitely-absent-abc123
2>   at line 5
2>   at column 5
2>   at file path [CWD]/holder.json
2>   at location "/$defs/x"
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Schema input error
RUN validate schema.json instance.json --http --resolve holder.json --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "This identifier is embedded in an imported schema, so only that schema can reach it",
1>   "identifier": "https://schemas.sourcemeta.com/definitely-absent-abc123",
1>   "line": 5,
1>   "column": 5,
1>   "filePath": "[CWD]/holder.json",
1>   "location": "/$defs/x"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt

// Unexpected error
RUN validate schema.json instance.json --http STDIN /dev/null IN . INTO result_2.txt EXPECTING 1

WRITE expected_2.txt UNTIL EOF
2> error: Unsuccessful HTTP response
2>   with status 404 Not Found
2>   with method GET
2>   at url https://schemas.sourcemeta.com/definitely-absent-abc123
EOF

COMPARE result_2.txt AGAINST expected_2.txt
