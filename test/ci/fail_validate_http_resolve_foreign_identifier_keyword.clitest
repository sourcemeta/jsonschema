// Which of `$id` and `id` introduces a schema resource depends on the
// dialect, and the other one carries no such meaning. The documents below
// spell their root identifier with the keyword of a different dialect than
// the one they declare: a 2020-12 document reaching for `id`, and a Draft 4
// one reaching for `$id`. Neither declares the identifier that the other
// input names as its own meta-schema, so both runs must reach for the
// network. The cURL library cannot be loaded, so the error below proves the
// request was attempted

ENV SOURCEMETA_CORE_CURL_SO $CWD/does-not-exist.so

WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "string"
}
EOF

WRITE orphan.json UNTIL EOF
{
  "$schema": "https://example.com/target-meta",
  "$id": "https://example.com/orphan",
  "type": "string"
}
EOF

WRITE modern-dialect.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "https://example.com/target-meta",
  "$defs": {
    "inner": {
      "$schema": "https://example.com/orphan",
      "$id": "https://example.com/inner"
    }
  }
}
EOF

WRITE legacy-dialect.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "$id": "https://example.com/target-meta",
  "definitions": {
    "inner": {
      "$schema": "https://example.com/orphan",
      "id": "https://example.com/inner"
    }
  }
}
EOF

WRITE instance.json UNTIL EOF
"hello"
EOF

// Not supported
RUN validate schema.json instance.json --http --resolve orphan.json --resolve modern-dialect.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 3

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: Could not load the cURL library from the configured path
2>   with environment variable SOURCEMETA_CORE_CURL_SO
2>   with paths
2>   - [CWD]/does-not-exist.so
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Not supported
RUN validate schema.json instance.json --http --resolve orphan.json --resolve modern-dialect.json --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 3

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "Could not load the cURL library from the configured path",
1>   "environmentVariable": "SOURCEMETA_CORE_CURL_SO",
1>   "paths": [ "[CWD]/does-not-exist.so" ]
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt

// Not supported
RUN validate schema.json instance.json --http --resolve orphan.json --resolve legacy-dialect.json STDIN /dev/null IN . INTO result_2.txt EXPECTING 3

REPLACE $CWD WITH '[CWD]' IN result_2.txt

WRITE expected_2.txt UNTIL EOF
2> error: Could not load the cURL library from the configured path
2>   with environment variable SOURCEMETA_CORE_CURL_SO
2>   with paths
2>   - [CWD]/does-not-exist.so
EOF

COMPARE result_2.txt AGAINST expected_2.txt

// Not supported
RUN validate schema.json instance.json --http --resolve orphan.json --resolve legacy-dialect.json --json STDIN /dev/null IN . INTO result_3.txt EXPECTING 3

REPLACE $CWD WITH '[CWD]' IN result_3.txt

WRITE expected_3.txt UNTIL EOF
1> {
1>   "error": "Could not load the cURL library from the configured path",
1>   "environmentVariable": "SOURCEMETA_CORE_CURL_SO",
1>   "paths": [ "[CWD]/does-not-exist.so" ]
1> }
EOF

COMPARE result_3.txt AGAINST expected_3.txt
