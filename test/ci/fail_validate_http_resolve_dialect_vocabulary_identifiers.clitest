// A keyword only holds schema resources when the dialect in effect declares
// the vocabulary that defines it. The custom meta-schema below leaves the
// applicator vocabulary out, so `properties` is a keyword the dialect gives
// no meaning to and the identifier it holds is part of an instance rather
// than a resource that the user supplied. The input whose own meta-schema
// names that identifier must therefore reach for the network: the cURL
// library cannot be loaded, so the error below proves the request was
// attempted

ENV SOURCEMETA_CORE_CURL_SO $CWD/does-not-exist.so

WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "string"
}
EOF

WRITE custom-meta.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/custom-meta",
  "$vocabulary": {
    "https://json-schema.org/draft/2020-12/vocab/core": true
  }
}
EOF

WRITE uses-custom.json UNTIL EOF
{
  "$schema": "https://example.com/custom-meta",
  "$id": "https://example.com/uses-custom",
  "properties": {
    "meta": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://example.com/embedded-meta",
      "$vocabulary": {
        "https://json-schema.org/draft/2020-12/vocab/core": true,
        "https://json-schema.org/draft/2020-12/vocab/applicator": true,
        "https://json-schema.org/draft/2020-12/vocab/validation": true
      }
    }
  }
}
EOF

WRITE orphan.json UNTIL EOF
{
  "$schema": "https://example.com/embedded-meta",
  "$id": "https://example.com/orphan",
  "type": "string"
}
EOF

WRITE instance.json UNTIL EOF
"hello"
EOF

// Not supported
RUN validate schema.json instance.json --http --resolve orphan.json --resolve uses-custom.json --resolve custom-meta.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 3

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: Could not load the cURL library from the configured path
2>   with environment variable SOURCEMETA_CORE_CURL_SO
2>   with paths
2>   - [CWD]/does-not-exist.so
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Not supported
RUN validate schema.json instance.json --http --resolve orphan.json --resolve uses-custom.json --resolve custom-meta.json --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 3

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "Could not load the cURL library from the configured path",
1>   "environmentVariable": "SOURCEMETA_CORE_CURL_SO",
1>   "paths": [ "[CWD]/does-not-exist.so" ]
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
