// A message sits in a list, so naming a property straight after the list skips
// the position it meant and lands on the list itself.

WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "string"
}
EOF

// Invalid CLI arguments
RUN llm schema.json --ask hello --url https://api.example.com/v1/chat/completions --model my-model --dry-run --param /messages/role=system STDIN /dev/null IN . INTO result.txt EXPECTING 5

WRITE expected.txt UNTIL EOF
2> error: The parameter writes a property into a value that is not an object
2>   at value /messages/role=system
2>
2> Run this command without this parameter and with --dry-run/-D to see what
2> the request body looks like
EOF

COMPARE result.txt AGAINST expected.txt
