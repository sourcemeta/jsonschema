// A schema written in YAML asks the same question as one written in JSON. What
// goes out is JSON either way, since that is what a provider takes.

WRITE schema.yaml UNTIL EOF
$schema: "https://json-schema.org/draft/2020-12/schema"
type: object
properties:
  capital:
    type: string
required:
  - capital
additionalProperties: false
EOF

RUN llm schema.yaml --ask hello --url https://api.example.com/v1/chat/completions --model my-model --dry-run STDIN /dev/null IN . INTO result.txt EXPECTING 0

REPLACE $CWD_URI WITH '[CWD_URI]' IN result.txt

WRITE expected.txt UNTIL EOF
1> POST https://api.example.com/v1/chat/completions
1> Content-Type: application/json
1>
1> {
1>   "model": "my-model",
1>   "messages": [
1>     {
1>       "role": "user",
1>       "content": "hello"
1>     }
1>   ],
1>   "response_format": {
1>     "type": "json_schema",
1>     "json_schema": {
1>       "name": "schema",
1>       "strict": true,
1>       "schema": {
1>         "$schema": "https://json-schema.org/draft/2020-12/schema",
1>         "$id": "[CWD_URI]/schema.yaml",
1>         "type": "object",
1>         "required": [ "capital" ],
1>         "properties": {
1>           "capital": {
1>             "type": "string"
1>           }
1>         },
1>         "additionalProperties": false
1>       }
1>     }
1>   }
1> }
EOF

COMPARE result.txt AGAINST expected.txt
