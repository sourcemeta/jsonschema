// Which endpoint to reach is never guessed, as no vendor is built in.

WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "string"
}
EOF

// Invalid CLI arguments
RUN llm schema.json --ask hello --model my-model --dry-run STDIN /dev/null IN . INTO result.txt EXPECTING 5

WRITE expected.txt UNTIL EOF
2> error: You must pass the completion endpoint using the `--url/-u` option
EOF

COMPARE result.txt AGAINST expected.txt
