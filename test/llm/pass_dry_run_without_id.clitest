// Removing the identifiers a schema declares is how a provider that cannot
// resolve a reference by identifier is worked around, which is the one use this
// option has. What a reference named by identifier becomes is a pointer into the
// document itself, so the schema still stands on its own.

WRITE helper.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/helper",
  "type": "string",
  "minLength": 3
}
EOF

WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": { "capital": { "$ref": "https://example.com/helper" } }
}
EOF

RUN llm schema.json --ask hello --url https://api.example.com/v1/chat/completions --model my-model --dry-run --resolve helper.json --without-id STDIN /dev/null IN . INTO result.txt EXPECTING 0

WRITE expected.txt UNTIL EOF
1> POST https://api.example.com/v1/chat/completions
1> Content-Type: application/json
1>
1> {
1>   "model": "my-model",
1>   "messages": [
1>     {
1>       "role": "user",
1>       "content": "hello"
1>     }
1>   ],
1>   "response_format": {
1>     "type": "json_schema",
1>     "json_schema": {
1>       "name": "schema",
1>       "strict": true,
1>       "schema": {
1>         "$schema": "https://json-schema.org/draft/2020-12/schema",
1>         "type": "object",
1>         "properties": {
1>           "capital": {
1>             "$ref": "#/$defs/https:~1~1example.com~1helper"
1>           }
1>         },
1>         "$defs": {
1>           "https://example.com/helper": {
1>             "$schema": "https://json-schema.org/draft/2020-12/schema",
1>             "type": "string",
1>             "minLength": 3
1>           }
1>         }
1>       }
1>     }
1>   }
1> }
EOF

COMPARE result.txt AGAINST expected.txt
