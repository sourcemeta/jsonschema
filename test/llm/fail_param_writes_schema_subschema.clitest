// What the response is checked against is the schema that was read, so a
// parameter that rewrites the one going out would leave the two describing
// different things and turn every result into a statement about nothing.

WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "string"
}
EOF

// Invalid CLI arguments
RUN llm schema.json --ask hello --url https://api.example.com/v1/chat/completions --model my-model --dry-run --param /response_format/json_schema/schema/type=integer STDIN /dev/null IN . INTO result.txt EXPECTING 5

WRITE expected.txt UNTIL EOF
2> error: A parameter cannot write the schema, as that is what the response is checked against
2>   at value /response_format/json_schema/schema/type=integer
EOF

COMPARE result.txt AGAINST expected.txt
