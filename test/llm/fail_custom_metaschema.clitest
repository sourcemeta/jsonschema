// What a provider supports is a moving subset that is hard to say much about,
// but a meta-schema of one's own is very unlikely to be part of any of it, so a
// schema written against one is turned down rather than sent to be ignored.

WRITE metaschema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/my-metaschema",
  "$dynamicAnchor": "meta",
  "type": [ "object", "boolean" ]
}
EOF

WRITE schema.json UNTIL EOF
{
  "$schema": "https://example.com/my-metaschema",
  "type": "string"
}
EOF

// Schema input error
RUN llm schema.json --ask hello --url https://api.example.com/v1/chat/completions --model my-model --dry-run --resolve metaschema.json STDIN /dev/null IN . INTO result.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result.txt

WRITE expected.txt UNTIL EOF
2> error: Schemas that declare a custom meta-schema cannot be sent to a model
2>   at line 1
2>   at column 1
2>   at file path [CWD]/schema.json
2>   at location ""
2>   at uri https://example.com/my-metaschema
2>
2> What a provider supports differs between them and changes over time, but a
2> meta-schema of your own is very unlikely to be part of any of it. Rewrite the
2> schema against an official dialect and send that instead
EOF

COMPARE result.txt AGAINST expected.txt
