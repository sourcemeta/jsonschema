// A provider recognises one fixed set of keywords and reads no dialect
// declaration, so a schema written against a meta-schema of its own describes
// itself in terms nothing on the other end could know, and sending it would hand
// over keywords that are silently ignored.

WRITE metaschema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/my-metaschema",
  "$dynamicAnchor": "meta",
  "type": [ "object", "boolean" ]
}
EOF

WRITE schema.json UNTIL EOF
{
  "$schema": "https://example.com/my-metaschema",
  "type": "string"
}
EOF

// Schema input error
RUN llm schema.json --ask hello --url https://api.example.com/v1/chat/completions --model my-model --dry-run --resolve metaschema.json --json STDIN /dev/null IN . INTO result.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result.txt

WRITE expected.txt UNTIL EOF
1> {
1>   "error": "Schemas that declare a custom meta-schema cannot be sent to a model",
1>   "line": 1,
1>   "column": 1,
1>   "filePath": "[CWD]/schema.json",
1>   "location": "",
1>   "uri": "https://example.com/my-metaschema"
1> }
EOF

COMPARE result.txt AGAINST expected.txt
