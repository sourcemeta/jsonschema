// An identifier the schema declares itself goes the same way as one bundling
// gave it, so what reaches a provider names nothing it would have to resolve.

WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/capital",
  "type": "object",
  "properties": { "capital": { "type": "string" } }
}
EOF

RUN llm schema.json --ask hello --url https://api.example.com/v1/chat/completions --model my-model --dry-run --without-id STDIN /dev/null IN . INTO result.txt EXPECTING 0

WRITE expected.txt UNTIL EOF
1> POST https://api.example.com/v1/chat/completions
1> Content-Type: application/json
1>
1> {
1>   "model": "my-model",
1>   "messages": [
1>     {
1>       "role": "user",
1>       "content": "hello"
1>     }
1>   ],
1>   "response_format": {
1>     "type": "json_schema",
1>     "json_schema": {
1>       "name": "schema",
1>       "strict": true,
1>       "schema": {
1>         "$schema": "https://json-schema.org/draft/2020-12/schema",
1>         "type": "object",
1>         "properties": {
1>           "capital": {
1>             "type": "string"
1>           }
1>         }
1>       }
1>     }
1>   }
1> }
EOF

COMPARE result.txt AGAINST expected.txt
