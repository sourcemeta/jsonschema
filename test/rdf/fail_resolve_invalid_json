WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "x-jsonld-type": "https://schema.org/Person"
}
EOF

WRITE instance.json UNTIL EOF
{}
EOF

WRITE invalid.json UNTIL EOF

  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com",
  "type": "string"
}
EOF

// Other input error
RUN rdf schema.json instance.json --resolve invalid.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 6
REPLACE '\\\\' WITH '/' IN result_0.txt
REPLACE '\\(?!")' WITH '/' IN result_0.txt

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: Failed to parse the JSON document
2>   at line 2
2>   at column 12
2>   at file path [CWD]/invalid.json
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Other input error
RUN rdf schema.json instance.json --resolve invalid.json --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 6
REPLACE '\\\\' WITH '/' IN result_1.txt
REPLACE '\\(?!")' WITH '/' IN result_1.txt

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "Failed to parse the JSON document",
1>   "line": 2,
1>   "column": 12,
1>   "filePath": "[CWD]/invalid.json"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
