WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "x-jsonld-type": "https://schema.org/Person",
  "properties": {
    "name": { "type": "string", "x-jsonld-id": "https://schema.org/name" }
  }
}
EOF

WRITE instances.yaml UNTIL EOF
name: Ada
---
name: Alan
EOF

RUN rdf schema.json instances.yaml --verbose STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
1> [{"@type":["https://schema.org/Person"],"https://schema.org/name":[{"@value":"Ada"}]}]
1> [{"@type":["https://schema.org/Person"],"https://schema.org/name":[{"@value":"Alan"}]}]
2> Interpreting input as YAML multi-document: [CWD]/instances.yaml
2> ok: [CWD]/instances.yaml (entry #1)
2>   matches [CWD]/schema.json
2> ok: [CWD]/instances.yaml (entry #2)
2>   matches [CWD]/schema.json
EOF

COMPARE result_0.txt AGAINST expected_0.txt
