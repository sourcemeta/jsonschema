WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "price": {
      "type": "number",
      "x-jsonld-id": "https://schema.org/price",
      "allOf": [
        {
          "x-jsonld-datatype": "http://www.w3.org/2001/XMLSchema#decimal",
          "x-jsonld-override": true
        },
        { "x-jsonld-datatype": "http://www.w3.org/2001/XMLSchema#double" }
      ]
    }
  }
}
EOF

WRITE instance.json UNTIL EOF
{ "price": 1 }
EOF

// Schema input error
RUN rdf schema.json instance.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 4

REPLACE $CWD_URI WITH '[CWD_URI]' IN result_0.txt
REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: A JSON-LD datatype cannot be assigned more than one value
2>   at line 1
2>   at column 3
2>   at instance location "/price"
2>   at facet "datatype"
2>   at schema location [CWD_URI]/schema.json#/properties/price/allOf/0/x-jsonld-datatype
2>   at conflicting schema location [CWD_URI]/schema.json#/properties/price/allOf/1/x-jsonld-datatype
2>   at inert override location [CWD_URI]/schema.json#/properties/price/allOf/0/x-jsonld-override
2>   at file path [CWD]/instance.json
2>
2> The x-jsonld-override mark was ignored because it does not enclose the
2> conflicting annotation. Move the conflicting annotation, or the reference
2> that brings it in, inside the overriding object for the override to
2> take effect
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Schema input error
RUN rdf schema.json instance.json --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 4

REPLACE $CWD_URI WITH '[CWD_URI]' IN result_1.txt
REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "A JSON-LD datatype cannot be assigned more than one value",
1>   "line": 1,
1>   "column": 3,
1>   "instanceLocation": "/price",
1>   "facet": "datatype",
1>   "schemaLocation": "[CWD_URI]/schema.json#/properties/price/allOf/0/x-jsonld-datatype",
1>   "conflictingSchemaLocation": "[CWD_URI]/schema.json#/properties/price/allOf/1/x-jsonld-datatype",
1>   "inertOverrideLocation": "[CWD_URI]/schema.json#/properties/price/allOf/0/x-jsonld-override",
1>   "filePath": "[CWD]/instance.json"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
