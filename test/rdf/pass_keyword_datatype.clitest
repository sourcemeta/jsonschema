WRITE schema.json UNTIL EOF
{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "dob": {
        "type": "string",
        "x-jsonld-id": "https://schema.org/birthDate",
        "x-jsonld-datatype": "http://www.w3.org/2001/XMLSchema#date"
      }
    }
  }
EOF

WRITE instance.json UNTIL EOF
{ "dob": "1990-05-15" }
EOF

RUN rdf schema.json instance.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

WRITE expected_0.txt UNTIL EOF
1> [
1>   {
1>     "https://schema.org/birthDate": [
1>       {
1>         "@value": "1990-05-15",
1>         "@type": "http://www.w3.org/2001/XMLSchema#date"
1>       }
1>     ]
1>   }
1> ]
EOF

COMPARE result_0.txt AGAINST expected_0.txt
