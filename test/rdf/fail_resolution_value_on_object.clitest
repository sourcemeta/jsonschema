WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "spec": {
      "type": "object",
      "x-jsonld-id": "https://schema.org/weight",
      "x-jsonld-value": "https://schema.org/value"
    }
  }
}
EOF

WRITE instance.json UNTIL EOF
{ "spec": { "a": 1 } }
EOF

// Schema input error
RUN rdf schema.json instance.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_0.txt
REPLACE 'file:///\[CWD\]' WITH 'file://[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: A JSON-LD value predicate can only be assigned to a scalar value
2>   at line 1
2>   at column 3
2>   at instance location "/spec"
2>   at facet "value"
2>   at schema location file://[CWD]/schema.json#/properties/spec/x-jsonld-value
2>   at file path [CWD]/instance.json
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Schema input error
RUN rdf schema.json instance.json --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_1.txt
REPLACE 'file:///\[CWD\]' WITH 'file://[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "A JSON-LD value predicate can only be assigned to a scalar value",
1>   "line": 1,
1>   "column": 3,
1>   "instanceLocation": "/spec",
1>   "facet": "value",
1>   "schemaLocation": "file://[CWD]/schema.json#/properties/spec/x-jsonld-value",
1>   "filePath": "[CWD]/instance.json"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
