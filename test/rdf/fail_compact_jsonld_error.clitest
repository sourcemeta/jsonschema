WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "x-jsonld-type": "https://schema.org/Person",
  "properties": {
    "name": { "type": "string", "x-jsonld-id": "https://schema.org/name" }
  }
}
EOF

WRITE instance.json UNTIL EOF
{ "name": "Ada" }
EOF

WRITE context.json UNTIL EOF
{ "@context": { "name": true } }
EOF

// Other input error
RUN rdf schema.json instance.json --compact context.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 6

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: Invalid term definition
2>   at file path [CWD]/context.json
2>   at document location "/name"
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Other input error
RUN rdf schema.json instance.json --compact context.json --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 6

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "Invalid term definition",
1>   "filePath": "[CWD]/context.json",
1>   "location": "/name"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
