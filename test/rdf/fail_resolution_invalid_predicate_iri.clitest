WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": { "type": "string", "x-jsonld-id": "name" }
  }
}
EOF

WRITE instance.json UNTIL EOF
{ "name": "Ada" }
EOF

// Schema input error
RUN rdf schema.json instance.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 4

REPLACE $CWD_URI WITH '[CWD_URI]' IN result_0.txt
REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: The value of x-jsonld-id must be an absolute IRI
2>   at line 1
2>   at column 3
2>   at instance location "/name"
2>   at facet "predicate"
2>   at schema location [CWD_URI]/schema.json#/properties/name/x-jsonld-id
2>   at file path [CWD]/instance.json
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Schema input error
RUN rdf schema.json instance.json --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 4

REPLACE $CWD_URI WITH '[CWD_URI]' IN result_1.txt
REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "The value of x-jsonld-id must be an absolute IRI",
1>   "line": 1,
1>   "column": 3,
1>   "instanceLocation": "/name",
1>   "facet": "predicate",
1>   "schemaLocation": "[CWD_URI]/schema.json#/properties/name/x-jsonld-id",
1>   "filePath": "[CWD]/instance.json"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
