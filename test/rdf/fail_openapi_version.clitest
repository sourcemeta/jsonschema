// A description declaring a revision we cannot read is turned down rather
// than being taken for a schema and read through as one.

WRITE openapi.json UNTIL EOF
{
  "openapi": "3.0.3",
  "info": { "title": "Example", "version": "1.0.0" },
  "paths": {}
}
EOF

WRITE instance.json UNTIL EOF
{ "name": "Ada" }
EOF

// Not supported
RUN rdf openapi.json instance.json --entrypoint /components/schemas/Person STDIN /dev/null IN . INTO result.txt EXPECTING 3

REPLACE $CWD WITH '[CWD]' IN result.txt

WRITE expected.txt UNTIL EOF
2> error: This OpenAPI Specification revision is not supported
2>   at value 3.0.3
2>   at file path [CWD]/openapi.json
EOF

COMPARE result.txt AGAINST expected.txt
