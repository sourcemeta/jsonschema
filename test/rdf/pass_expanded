WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "x-jsonld-type": "https://schema.org/Person",
  "properties": {
    "name": { "type": "string", "x-jsonld-id": "https://schema.org/name" },
    "email": { "type": "string", "x-jsonld-id": "https://schema.org/email" }
  }
}
EOF

WRITE instance.json UNTIL EOF
{ "name": "Ada", "email": "ada@example.com" }
EOF

RUN rdf schema.json instance.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

WRITE expected_0.txt UNTIL EOF
1> [
1>   {
1>     "@type": [ "https://schema.org/Person" ],
1>     "https://schema.org/email": [
1>       {
1>         "@value": "ada@example.com"
1>       }
1>     ],
1>     "https://schema.org/name": [
1>       {
1>         "@value": "Ada"
1>       }
1>     ]
1>   }
1> ]
EOF

COMPARE result_0.txt AGAINST expected_0.txt

RUN rdf schema.json instance.json --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 0

WRITE expected_1.txt UNTIL EOF
1> [
1>   {
1>     "@type": [ "https://schema.org/Person" ],
1>     "https://schema.org/email": [
1>       {
1>         "@value": "ada@example.com"
1>       }
1>     ],
1>     "https://schema.org/name": [
1>       {
1>         "@value": "Ada"
1>       }
1>     ]
1>   }
1> ]
EOF

COMPARE result_1.txt AGAINST expected_1.txt
