WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "x-jsonld-type": "https://schema.org/Person",
  "properties": {
    "name": { "type": "string", "x-jsonld-id": "https://schema.org/name" }
  }
}
EOF

WRITE instance.yaml UNTIL EOF
foo: [unclosed
EOF

// Other input error
RUN rdf schema.json instance.yaml STDIN /dev/null IN . INTO result_0.txt EXPECTING 6
REPLACE '\\\\' WITH '/' IN result_0.txt
REPLACE '\\(?!")' WITH '/' IN result_0.txt

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: Missing comma in flow sequence
2>   at line 3
2>   at column 0
2>   at file path [CWD]/instance.yaml
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Other input error
RUN rdf schema.json instance.yaml --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 6
REPLACE '\\\\' WITH '/' IN result_1.txt
REPLACE '\\(?!")' WITH '/' IN result_1.txt

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "Missing comma in flow sequence",
1>   "line": 3,
1>   "column": 0,
1>   "filePath": "[CWD]/instance.yaml"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
