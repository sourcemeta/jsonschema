// The same schema without an entry point is read through its root, which
// says something different from the subschema beside it.

WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "type": "object",
  "x-jsonld-type": "https://schema.org/Thing",
  "properties": {
    "name": { "type": "string", "x-jsonld-id": "https://schema.org/alternateName" }
  },
  "$defs": {
    "Person": {
      "type": "object",
      "x-jsonld-type": "https://schema.org/Person",
      "properties": {
        "name": { "type": "string", "x-jsonld-id": "https://schema.org/name" }
      }
    }
  }
}
EOF

WRITE instance.json UNTIL EOF
{ "name": "Ada" }
EOF

RUN rdf schema.json instance.json STDIN /dev/null IN . INTO result.txt EXPECTING 0

WRITE expected.txt UNTIL EOF
1> [
1>   {
1>     "@type": [ "https://schema.org/Thing" ],
1>     "https://schema.org/alternateName": [
1>       {
1>         "@value": "Ada"
1>       }
1>     ]
1>   }
1> ]
EOF

COMPARE result.txt AGAINST expected.txt
