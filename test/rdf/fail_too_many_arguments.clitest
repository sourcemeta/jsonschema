WRITE schema.json UNTIL EOF
{ "$schema": "https://json-schema.org/draft/2020-12/schema" }
EOF

WRITE instance.json UNTIL EOF
{}
EOF

WRITE extra.json UNTIL EOF
{}
EOF

// Invalid CLI arguments
RUN rdf schema.json instance.json extra.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 5

WRITE expected_0.txt UNTIL EOF
2> error: This command expects a path to a schema and a path to an instance to promote to JSON-LD
2>
2> For example: jsonschema rdf path/to/schema.json path/to/instance.json
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Invalid CLI arguments
RUN rdf schema.json instance.json extra.json --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 5

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "This command expects a path to a schema and a path to an instance to promote to JSON-LD"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
