WRITE schema.json UNTIL EOF
{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "x-jsonld-id": "https://schema.org/text",
        "x-jsonld-direction": "rtl"
      }
    }
  }
EOF

WRITE instance.json UNTIL EOF
{ "text": "abc" }
EOF

RUN rdf schema.json instance.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

WRITE expected_0.txt UNTIL EOF
1> [
1>   {
1>     "https://schema.org/text": [
1>       {
1>         "@value": "abc",
1>         "@direction": "rtl"
1>       }
1>     ]
1>   }
1> ]
EOF

COMPARE result_0.txt AGAINST expected_0.txt
