WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "x-jsonld-type": "https://schema.org/Person",
  "properties": {
    "name": { "type": "string", "x-jsonld-id": "https://schema.org/name" }
  }
}
EOF

WRITE instances.jsonl UNTIL EOF
{ "name": "Ada" }
{ "name": "Alan" }
{ "name": "Grace" }
EOF

COMPRESS GZIP instances.jsonl INTO instances.jsonl.gz

RUN rdf schema.json instances.jsonl.gz --verbose STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
1> [{"@type":["https://schema.org/Person"],"https://schema.org/name":[{"@value":"Ada"}]}]
1> [{"@type":["https://schema.org/Person"],"https://schema.org/name":[{"@value":"Alan"}]}]
1> [{"@type":["https://schema.org/Person"],"https://schema.org/name":[{"@value":"Grace"}]}]
2> Interpreting input as GZIP-compressed JSONL: [CWD]/instances.jsonl.gz
2> ok: [CWD]/instances.jsonl.gz (entry #1)
2>   matches [CWD]/schema.json
2> ok: [CWD]/instances.jsonl.gz (entry #2)
2>   matches [CWD]/schema.json
2> ok: [CWD]/instances.jsonl.gz (entry #3)
2>   matches [CWD]/schema.json
EOF

COMPARE result_0.txt AGAINST expected_0.txt
