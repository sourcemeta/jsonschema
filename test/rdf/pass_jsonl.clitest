WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "x-jsonld-type": "https://schema.org/Person",
  "properties": {
    "name": { "type": "string", "x-jsonld-id": "https://schema.org/name" }
  }
}
EOF

WRITE instances.jsonl UNTIL EOF
{ "name": "Ada" }
{ "name": "Alan" }
{ "name": "Grace" }
EOF

RUN rdf schema.json instances.jsonl STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

WRITE expected_0.txt UNTIL EOF
1> [{"@type":["https://schema.org/Person"],"https://schema.org/name":[{"@value":"Ada"}]}]
1> [{"@type":["https://schema.org/Person"],"https://schema.org/name":[{"@value":"Alan"}]}]
1> [{"@type":["https://schema.org/Person"],"https://schema.org/name":[{"@value":"Grace"}]}]
EOF

COMPARE result_0.txt AGAINST expected_0.txt

RUN rdf schema.json instances.jsonl --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 0

WRITE expected_1.txt UNTIL EOF
1> [{"@type":["https://schema.org/Person"],"https://schema.org/name":[{"@value":"Ada"}]}]
1> [{"@type":["https://schema.org/Person"],"https://schema.org/name":[{"@value":"Alan"}]}]
1> [{"@type":["https://schema.org/Person"],"https://schema.org/name":[{"@value":"Grace"}]}]
EOF

COMPARE result_1.txt AGAINST expected_1.txt
