// Whether a schema can carry annotations is a question about the schema the
// entry point names, not about the description it sits in.

WRITE openapi.json UNTIL EOF
{
  "openapi": "3.1.1",
  "info": { "title": "Example", "version": "1.0.0" },
  "paths": {},
  "components": {
    "schemas": {
      "Person": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "x-jsonld-type": "https://schema.org/Person",
        "properties": {
          "name": { "type": "string", "x-jsonld-id": "https://schema.org/name" }
        }
      }
    }
  }
}
EOF

WRITE instance.json UNTIL EOF
{ "name": "Ada" }
EOF

// Whether a schema can carry annotations is a question about the schema the
RUN rdf openapi.json instance.json --entrypoint /components/schemas/Person --json STDIN /dev/null IN . INTO result.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result.txt

WRITE expected.txt UNTIL EOF
1> {
1>   "error": "This command requires the schema to declare JSON Schema 2019-09 or newer",
1>   "identifier": "http://json-schema.org/draft-07/schema#",
1>   "filePath": "[CWD]/openapi.json"
1> }
EOF

COMPARE result.txt AGAINST expected.txt
