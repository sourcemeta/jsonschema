// Upgrading a description means moving every Schema Object it holds and the
// revision it declares, which is more than upgrading a schema, so it is
// turned down outright rather than half done.

WRITE openapi.json UNTIL EOF
{
  "openapi": "3.1.1",
  "info": { "title": "Example", "version": "1.0.0" },
  "paths": {},
  "components": {
    "schemas": {
      "Person": { "$schema": "http://json-schema.org/draft-07/schema#", "type": "string" }
    }
  }
}
EOF

// Not supported
RUN upgrade openapi.json --to 2020-12 --json STDIN /dev/null IN . INTO result.txt EXPECTING 3

REPLACE $CWD WITH '[CWD]' IN result.txt

WRITE expected.txt UNTIL EOF
1> {
1>   "error": "Upgrading OpenAPI descriptions is not supported yet",
1>   "filePath": "[CWD]/openapi.json"
1> }
EOF

COMPARE result.txt AGAINST expected.txt
