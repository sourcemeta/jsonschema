WRITE schema.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "https://example.com/test",
  "type": "integer",
  "minimum": 0
}
EOF

RUN upgrade --to 2019-09 schema.json STDIN /dev/null IN . INTO result.txt EXPECTING 0

WRITE expected.txt UNTIL EOF
1> {
1>   "$schema": "https://json-schema.org/draft/2019-09/schema",
1>   "$id": "https://example.com/test",
1>   "type": "integer",
1>   "minimum": 0
1> }
EOF

COMPARE result.txt AGAINST expected.txt
