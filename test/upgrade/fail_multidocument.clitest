WRITE schema.yaml UNTIL EOF
$schema: https://json-schema.org/draft/2020-12/schema
$id: https://example.com/first
type: string
---
$schema: https://json-schema.org/draft/2020-12/schema
$id: https://example.com/second
type: integer
EOF

// Not supported
RUN upgrade schema.yaml STDIN /dev/null IN . INTO result_0.txt EXPECTING 3

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: This command does not support input with multiple documents
2>   at file path [CWD]/schema.yaml
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Not supported
RUN upgrade schema.yaml --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 3

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "This command does not support input with multiple documents",
1>   "filePath": "[CWD]/schema.yaml"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
