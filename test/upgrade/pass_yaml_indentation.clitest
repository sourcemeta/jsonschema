WRITE schema.yaml UNTIL EOF
$schema: http://json-schema.org/draft-04/schema#
id: https://example.com/test
properties:
    foo:
        type: string
EOF

RUN upgrade schema.yaml STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

WRITE expected_0.txt UNTIL EOF
1> $schema: https://json-schema.org/draft/2020-12/schema
1> $id: https://example.com/test
1> properties:
1>     foo:
1>         type: string
EOF

COMPARE result_0.txt AGAINST expected_0.txt

RUN upgrade schema.yaml --indentation 2 STDIN /dev/null IN . INTO result_1.txt EXPECTING 0

WRITE expected_1.txt UNTIL EOF
1> $schema: https://json-schema.org/draft/2020-12/schema
1> $id: https://example.com/test
1> properties:
1>   foo:
1>     type: string
EOF

COMPARE result_1.txt AGAINST expected_1.txt
