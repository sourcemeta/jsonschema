MAKE DIRECTORY config

WRITE schema.json UNTIL EOF
{
  "id": "https://example.com/test",
  "type": "integer"
}
EOF

WRITE config/jsonschema.json UNTIL EOF
{
  "defaultDialect": "http://json-schema.org/draft-04/schema#"
}
EOF

RUN upgrade --configuration config/jsonschema.json schema.json --verbose STDIN /dev/null IN . INTO result.txt EXPECTING 0

REPLACE $CWD WITH '[CWD]' IN result.txt

WRITE expected.txt UNTIL EOF
1> {
1>   "$schema": "https://json-schema.org/draft/2020-12/schema",
1>   "$id": "https://example.com/test",
1>   "type": "integer"
1> }
2> Using configuration file: [CWD]/config/jsonschema.json
EOF

COMPARE result.txt AGAINST expected.txt
