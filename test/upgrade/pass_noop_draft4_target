WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/test",
  "type": "string",
  "minLength": 1
}
EOF

RUN upgrade --to draft4 schema.json STDIN /dev/null IN . INTO result.txt EXPECTING 0

WRITE expected.txt UNTIL EOF
1> {
1>   "$schema": "https://json-schema.org/draft/2020-12/schema",
1>   "$id": "https://example.com/test",
1>   "type": "string",
1>   "minLength": 1
1> }
EOF

COMPARE result.txt AGAINST expected.txt
