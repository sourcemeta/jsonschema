WRITE schema.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://json-schema.org/draft-07/schema#",
  "type": [ "object", "boolean" ],
  "properties": {
    "definitions": { "type": "object" }
  }
}
EOF

// Not supported
RUN upgrade --to 2020-12 schema.json STDIN /dev/null IN . INTO result.txt EXPECTING 3

REPLACE $CWD WITH '[CWD]' IN result.txt

WRITE expected.txt UNTIL EOF
2> error: Cannot upgrade a schema that is itself a meta-schema
2>   at line 1
2>   at column 1
2>   at file path [CWD]/schema.json
2>   at location ""
2>   at uri http://json-schema.org/draft-07/schema#
2>
2> Meta-schemas name the keywords of their dialect as ordinary data, which an
2> upgrade cannot rename alongside the keywords themselves. Please upgrade
2> meta-schemas manually.
EOF

COMPARE result.txt AGAINST expected.txt

// Not supported
RUN upgrade --to 2020-12 --json schema.json STDIN /dev/null IN . INTO result_json.txt EXPECTING 3

REPLACE $CWD WITH '[CWD]' IN result_json.txt

WRITE expected_json.txt UNTIL EOF
1> {
1>   "error": "Cannot upgrade a schema that is itself a meta-schema",
1>   "line": 1,
1>   "column": 1,
1>   "filePath": "[CWD]/schema.json",
1>   "location": "",
1>   "uri": "http://json-schema.org/draft-07/schema#"
1> }
EOF

COMPARE result_json.txt AGAINST expected_json.txt
