WRITE schema.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/main",
  "definitions": {
    "child": {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "https://example.com/child",
      "type": "string"
    }
  }
}
EOF

RUN upgrade schema.json STDIN /dev/null IN . INTO result.txt EXPECTING 0

WRITE expected.txt UNTIL EOF
1> {
1>   "$schema": "https://json-schema.org/draft/2020-12/schema",
1>   "$id": "https://example.com/main",
1>   "$defs": {
1>     "child": {
1>       "$schema": "https://json-schema.org/draft/2020-12/schema",
1>       "$id": "https://example.com/child",
1>       "type": "string"
1>     }
1>   }
1> }
EOF

COMPARE result.txt AGAINST expected.txt
