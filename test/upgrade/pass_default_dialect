WRITE schema.json UNTIL EOF
{
  "id": "https://example.com/test",
  "type": "integer"
}
EOF

RUN upgrade --default-dialect http://json-schema.org/draft-04/schema# schema.json STDIN /dev/null IN . INTO result.txt EXPECTING 0

WRITE expected.txt UNTIL EOF
1> {
1>   "$schema": "https://json-schema.org/draft/2020-12/schema",
1>   "$id": "https://example.com/test",
1>   "type": "integer"
1> }
EOF

COMPARE result.txt AGAINST expected.txt
