WRITE schema.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/string",
  "definitions": {
    "string": { "type": "string" }
  }
}
EOF

// Schema input error
RUN compile schema.json STDIN /dev/null IN . INTO result.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result.txt

WRITE expected_0.txt UNTIL EOF
2> error: Cannot bundle a JSON Schema Draft 7 or older with a top-level `$ref` (which overrides sibling keywords) without introducing undefined behavior
2>   at file path [CWD]/schema.json
EOF

COMPARE result.txt AGAINST expected_0.txt

// Schema input error
RUN compile schema.json --json STDIN /dev/null IN . INTO result_json.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_json.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "Cannot bundle a JSON Schema Draft 7 or older with a top-level `$ref` (which overrides sibling keywords) without introducing undefined behavior",
1>   "filePath": "[CWD]/schema.json"
1> }
EOF

COMPARE result_json.txt AGAINST expected_1.txt
