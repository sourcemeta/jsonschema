WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test",
  "description": "Test schema",
  "$id": "https://example.com",
  "$ref": "other"
}
EOF

WRITE remote.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/nested",
  "title": "Test",
  "description": "Test schema",
  "type": "string"
}
EOF

WRITE jsonschema.json UNTIL EOF
{
  "resolve": {
    "https://example.com/other": "https://example.com/nested"
  }
}
EOF

RUN compile schema.json --resolve remote.json --debug STDIN /dev/null IN . INTO result.txt EXPECTING 0
REPLACE '\\\\' WITH '/' IN result.txt
REPLACE '\\(?!")' WITH '/' IN result.txt

REPLACE $CWD WITH '[CWD]' IN result.txt
REPLACE 'file:///\[CWD\]' WITH 'file://[CWD]' IN result.txt

WRITE expected.txt UNTIL EOF
1> [
1>   5,
1>   false,
1>   true,
1>   [
1>     [
1>       [
1>         99,
1>         [ "$ref" ],
1>         [],
1>         "https://example.com#/$ref",
1>         2,
1>         [ 10, 1 ]
1>       ],
1>       [
1>         50,
1>         [ "description" ],
1>         [],
1>         "https://example.com#/description",
1>         2,
1>         [ 1, "Test schema" ]
1>       ],
1>       [
1>         50,
1>         [ "title" ],
1>         [],
1>         "https://example.com#/title",
1>         2,
1>         [ 1, "Test" ]
1>       ]
1>     ],
1>     [
1>       [
1>         50,
1>         [ "description" ],
1>         [],
1>         "https://example.com/nested#/description",
1>         3,
1>         [ 1, "Test schema" ]
1>       ],
1>       [
1>         50,
1>         [ "title" ],
1>         [],
1>         "https://example.com/nested#/title",
1>         3,
1>         [ 1, "Test" ]
1>       ],
1>       [
1>         11,
1>         [ "type" ],
1>         [],
1>         "https://example.com/nested#/type",
1>         3,
1>         [ 8, 4 ]
1>       ]
1>     ]
1>   ],
1>   []
1> ]
2> debug: Using configuration file: [CWD]/jsonschema.json
2> Using extension: .json
2> Using extension: .yaml
2> Using extension: .yml
2> debug: Detecting schema resources from file: [CWD]/remote.json
2> debug: Importing schema into the resolution context: file://[CWD]/remote.json
2> debug: Importing schema into the resolution context: https://example.com/nested
2> debug: Resolving https://example.com/other as https://example.com/nested given the configuration file
EOF

COMPARE result.txt AGAINST expected.txt
