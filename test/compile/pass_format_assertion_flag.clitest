WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "string",
  "format": "email"
}
EOF

RUN compile schema.json --format-assertion STDIN /dev/null IN . INTO result.txt EXPECTING 0

REPLACE $CWD_URI WITH '[CWD_URI]' IN result.txt
WRITE expected.txt UNTIL EOF
1> [
1>   15,
1>   false,
1>   true,
1>   [
1>     [
1>       [
1>         42,
1>         [ "format" ],
1>         [],
1>         "[CWD_URI]/schema.json#/format",
1>         1,
1>         1,
1>         1,
1>         0,
1>         [ 14, 5 ]
1>       ],
1>       [
1>         101,
1>         [],
1>         [],
1>         "[CWD_URI]/schema.json#/format",
1>         1,
1>         1,
1>         0,
1>         0,
1>         [ 8, 4 ],
1>         [
1>           [
1>             53,
1>             [ "format" ],
1>             [],
1>             "[CWD_URI]/schema.json#/format",
1>             1,
1>             1,
1>             2,
1>             0,
1>             [ 1, "email" ]
1>           ]
1>         ]
1>       ],
1>       [
1>         11,
1>         [ "type" ],
1>         [],
1>         "[CWD_URI]/schema.json#/type",
1>         1,
1>         2,
1>         3,
1>         4,
1>         [ 8, 4 ]
1>       ]
1>     ]
1>   ],
1>   [],
1>   [
1>     "https://json-schema.org/draft/2020-12/vocab/format-annotation",
1>     "https://json-schema.org/draft/2020-12/vocab/validation"
1>   ],
1>   [
1>     "The string value {0} was expected to represent a valid email address",
1>     "The logical type of the {0} was expected to be {2}",
1>     "{0} was expected to be of type {1}",
1>     "{0} was expected to be of type {1} but it was of type {2}"
1>   ]
1> ]
EOF

COMPARE result.txt AGAINST expected.txt
