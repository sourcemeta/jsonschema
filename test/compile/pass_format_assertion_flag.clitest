WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "string",
  "format": "email"
}
EOF

RUN compile schema.json --format-assertion STDIN /dev/null IN . INTO result.txt EXPECTING 0

REPLACE $CWD_URI WITH '[CWD_URI]' IN result.txt
REPLACE $CWD WITH '[CWD]' IN result.txt

WRITE expected.txt UNTIL EOF
1> [
1>   7,
1>   false,
1>   true,
1>   [
1>     [
1>       [
1>         40,
1>         [ "format" ],
1>         [],
1>         "[CWD_URI]/schema.json#/format",
1>         1,
1>         1,
1>         [ 14, 5 ]
1>       ],
1>       [
1>         97,
1>         [],
1>         [],
1>         "[CWD_URI]/schema.json#/format",
1>         1,
1>         1,
1>         [ 8, 4 ],
1>         [
1>           [
1>             50,
1>             [ "format" ],
1>             [],
1>             "[CWD_URI]/schema.json#/format",
1>             1,
1>             1,
1>             [ 1, "email" ]
1>           ]
1>         ]
1>       ],
1>       [
1>         11,
1>         [ "type" ],
1>         [],
1>         "[CWD_URI]/schema.json#/type",
1>         1,
1>         2,
1>         [ 8, 4 ]
1>       ]
1>     ]
1>   ],
1>   [],
1>   [
1>     "https://json-schema.org/draft/2020-12/vocab/format-annotation",
1>     "https://json-schema.org/draft/2020-12/vocab/validation"
1>   ]
1> ]
EOF

COMPARE result.txt AGAINST expected.txt
