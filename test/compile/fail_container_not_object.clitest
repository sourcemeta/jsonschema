WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com",
  "$defs": [ 1, 2 ],
  "$ref": "nested"
}
EOF

WRITE remote.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/nested",
  "type": "string"
}
EOF

// Schema input error
RUN compile schema.json --resolve remote.json STDIN /dev/null IN . INTO result.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result.txt

WRITE expected_0.txt UNTIL EOF
2> error: Could not bundle to a container that is not an object
2>   at line 4
2>   at column 3
2>   at file path [CWD]/schema.json
2>   at location "/$defs"
EOF

COMPARE result.txt AGAINST expected_0.txt

// Schema input error
RUN compile schema.json --json --resolve remote.json STDIN /dev/null IN . INTO result_json.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_json.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "Could not bundle to a container that is not an object",
1>   "line": 4,
1>   "column": 3,
1>   "filePath": "[CWD]/schema.json",
1>   "location": "/$defs"
1> }
EOF

COMPARE result_json.txt AGAINST expected_1.txt
