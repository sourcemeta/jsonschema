// Nothing in a description stands out as the one schema to compile, so
// leaving the entry point out is refused rather than guessed at.

WRITE openapi.json UNTIL EOF
{
  "openapi": "3.1.1",
  "info": { "title": "Example", "version": "1.0.0" },
  "paths": {},
  "components": {
    "schemas": {
      "Person": {
        "type": "object",
        "required": [ "name" ],
        "properties": { "name": { "type": "string" } }
      }
    }
  }
}
EOF

// Invalid CLI arguments
RUN compile openapi.json STDIN /dev/null IN . INTO result.txt EXPECTING 5

WRITE expected.txt UNTIL EOF
2> error: You must pass an entry point using the `--entrypoint/-p` option when the input is an OpenAPI description
EOF

COMPARE result.txt AGAINST expected.txt
