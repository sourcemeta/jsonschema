// An entry point naming a place the description does not hold is reported
// against the file it was looked for in.

WRITE openapi.json UNTIL EOF
{
  "openapi": "3.1.1",
  "info": { "title": "Example", "version": "1.0.0" },
  "paths": {},
  "components": {
    "schemas": {
      "Person": {
        "type": "object",
        "required": [ "name" ],
        "properties": { "name": { "type": "string" } }
      }
    }
  }
}
EOF

// Schema input error
RUN compile openapi.json --entrypoint /components/schemas/Nope STDIN /dev/null IN . INTO result.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result.txt

WRITE expected.txt UNTIL EOF
2> error: The given entry point URI does not exist in the schema
2>   at identifier file://[CWD]/openapi.json#/components/schemas/Nope
2>   at file path [CWD]/openapi.json
2>
2> Use the `inspect` command to find valid schema locations
EOF

COMPARE result.txt AGAINST expected.txt
