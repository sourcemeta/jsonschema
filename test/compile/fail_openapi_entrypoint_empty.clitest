// An entry point given as an empty string is one nobody means, as an unset
// variable reaches us that way, so it is met with the same answer as having
// passed none at all.

WRITE openapi.json UNTIL EOF
{
  "openapi": "3.1.1",
  "info": { "title": "Example", "version": "1.0.0" },
  "paths": {},
  "components": { "schemas": { "Person": { "type": "string" } } }
}
EOF

// Invalid CLI arguments
RUN compile openapi.json --entrypoint '' STDIN /dev/null IN . INTO result.txt EXPECTING 5

WRITE expected.txt UNTIL EOF
2> error: You must pass an entry point using the `--entrypoint/-p` option when the input is an OpenAPI description
EOF

COMPARE result.txt AGAINST expected.txt
