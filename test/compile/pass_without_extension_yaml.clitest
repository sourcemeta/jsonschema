WRITE schema UNTIL EOF
$schema: https://json-schema.org/draft/2020-12/schema
$id: https://example.com
$ref: '#/$defs/string'
$defs:
  string: { type: string }
EOF

RUN compile schema STDIN /dev/null IN . INTO result.txt EXPECTING 0

WRITE expected.txt UNTIL EOF
1> [
1>   7,
1>   false,
1>   true,
1>   [
1>     [
1>       [
1>         100,
1>         [ "$ref" ],
1>         [],
1>         "https://example.com#/$ref",
1>         2,
1>         1,
1>         [ 10, 1 ]
1>       ]
1>     ],
1>     [
1>       [
1>         11,
1>         [ "type" ],
1>         [],
1>         "https://example.com#/$defs/string/type",
1>         2,
1>         2,
1>         [ 8, 4 ]
1>       ]
1>     ]
1>   ],
1>   [],
1>   [
1>     "https://json-schema.org/draft/2020-12/vocab/core",
1>     "https://json-schema.org/draft/2020-12/vocab/validation"
1>   ]
1> ]
EOF

COMPARE result.txt AGAINST expected.txt
