// A description holds many schemas and no root one, so which of them to
// compile is given as a JSON Pointer into the description.

WRITE openapi.json UNTIL EOF
{
  "openapi": "3.1.1",
  "info": { "title": "Example", "version": "1.0.0" },
  "paths": {},
  "components": {
    "schemas": {
      "Person": {
        "type": "object",
        "required": [ "name" ],
        "properties": { "name": { "type": "string" } }
      }
    }
  }
}
EOF

RUN compile openapi.json --entrypoint /components/schemas/Person STDIN /dev/null IN . INTO result.txt EXPECTING 0

REPLACE $CWD_URI WITH '[CWD_URI]' IN result.txt

WRITE expected.txt UNTIL EOF
1> [
1>   7,
1>   false,
1>   true,
1>   [
1>     [
1>       [
1>         2,
1>         [ "required" ],
1>         [],
1>         "[CWD_URI]/openapi.json#/components/schemas/Person/required",
1>         1,
1>         1,
1>         [
1>           4,
1>           [
1>             "name",
1>             [ 0, 435626798592, 0, 0 ]
1>           ]
1>         ]
1>       ],
1>       [
1>         61,
1>         [ "properties" ],
1>         [],
1>         "[CWD_URI]/openapi.json#/components/schemas/Person/properties",
1>         1,
1>         2,
1>         [ 8, 6 ],
1>         [
1>           [
1>             11,
1>             [ "name", "type" ],
1>             [ "name" ],
1>             "[CWD_URI]/openapi.json#/components/schemas/Person/properties/name/type",
1>             1,
1>             1,
1>             [ 8, 4 ]
1>           ],
1>           [
1>             51,
1>             [],
1>             [],
1>             "[CWD_URI]/openapi.json#/components/schemas/Person/properties",
1>             1,
1>             2,
1>             [ 1, "name" ]
1>           ]
1>         ]
1>       ],
1>       [
1>         11,
1>         [ "type" ],
1>         [],
1>         "[CWD_URI]/openapi.json#/components/schemas/Person/type",
1>         1,
1>         1,
1>         [ 8, 6 ]
1>       ]
1>     ]
1>   ],
1>   [],
