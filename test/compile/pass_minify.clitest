WRITE schema.json UNTIL EOF
{
  "$id": "https://example.com",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test",
  "description": "Test schema",
  "additionalProperties": {
    "type": "string"
  }
}
EOF

RUN compile --minify schema.json STDIN /dev/null IN . INTO result.txt EXPECTING 0

WRITE expected.txt UNTIL EOF
1> [15,false,true,[[[53,["description"],[],"https://example.com#/description",2,1,1,0,[1,"Test schema"]],[53,["title"],[],"https://example.com#/title",2,1,2,0,[1,"Test"]],[71,["additionalProperties"],[],"https://example.com#/additionalProperties",2,3,3,0,[0],[[11,["type"],[],"https://example.com#/additionalProperties/type",2,2,4,5,[8,4]],[56,[],[],"https://example.com#/additionalProperties",2,3,6,0,[0]]]]]],[],["https://json-schema.org/draft/2020-12/vocab/meta-data","https://json-schema.org/draft/2020-12/vocab/validation","https://json-schema.org/draft/2020-12/vocab/applicator"],["The description of the {0} was {1}","The title of the {0} was {1}","The object properties not covered by other adjacent object keywords were expected to validate against this subschema","{0} was expected to be of type {1}","{0} was expected to be of type {1} but it was of type {2}","The object property {0} successfully validated against the additional properties subschema"]]
EOF

COMPARE result.txt AGAINST expected.txt
