WRITE schema.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-06/schema#",
  "$id": "https://example.com/dangling",
  "allOf": [
    { "$ref": "#a%2fb" }
  ],
  "definitions": {
    "target": {
      "$id": "#a-2fb",
      "type": "string"
    }
  }
}
EOF

// Schema input error
RUN compile schema.json STDIN /dev/null IN . INTO result.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result.txt

WRITE expected_0.txt UNTIL EOF
2> error: Could not resolve schema reference
2>   at identifier https://example.com/dangling#a%2Fb
2>   at line 5
2>   at column 7
2>   at file path [CWD]/schema.json
2>   at location "/allOf/0/$ref"
EOF

COMPARE result.txt AGAINST expected_0.txt

// Schema input error
RUN compile schema.json --json STDIN /dev/null IN . INTO result_json.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_json.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "Could not resolve schema reference",
1>   "identifier": "https://example.com/dangling#a%2Fb",
1>   "line": 5,
1>   "column": 7,
1>   "filePath": "[CWD]/schema.json",
1>   "location": "/allOf/0/$ref"
1> }
EOF

COMPARE result_json.txt AGAINST expected_1.txt
