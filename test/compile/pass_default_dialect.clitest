WRITE schema.json UNTIL EOF
{
  "$id": "https://example.com",
  "additionalProperties": {
    "type": "string"
  }
}
EOF

RUN compile schema.json --default-dialect https://json-schema.org/draft/2020-12/schema STDIN /dev/null IN . INTO result.txt EXPECTING 0

WRITE expected.txt UNTIL EOF
1> [
1>   15,
1>   false,
1>   true,
1>   [
1>     [
1>       [
1>         71,
1>         [ "additionalProperties" ],
1>         [],
1>         "https://example.com#/additionalProperties",
1>         2,
1>         2,
1>         1,
1>         0,
1>         [ 0 ],
1>         [
1>           [
1>             11,
1>             [ "type" ],
1>             [],
1>             "https://example.com#/additionalProperties/type",
1>             2,
1>             1,
1>             2,
1>             3,
1>             [ 8, 4 ]
1>           ],
1>           [
1>             56,
1>             [],
1>             [],
1>             "https://example.com#/additionalProperties",
1>             2,
1>             2,
1>             4,
1>             0,
1>             [ 0 ]
1>           ]
1>         ]
1>       ]
1>     ]
1>   ],
1>   [],
1>   [
1>     "https://json-schema.org/draft/2020-12/vocab/validation",
1>     "https://json-schema.org/draft/2020-12/vocab/applicator"
1>   ],
1>   [
1>     "The object properties not covered by other adjacent object keywords were expected to validate against this subschema",
1>     "{0} was expected to be of type {1}",
1>     "{0} was expected to be of type {1} but it was of type {2}",
1>     "The object property {0} successfully validated against the additional properties subschema"
1>   ]
1> ]
EOF

COMPARE result.txt AGAINST expected.txt
