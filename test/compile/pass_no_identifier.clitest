WRITE foo/bar/baz/qux/very/long/path/foo/bar/baz/qux/schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test",
  "description": "Test schema",
  "additionalProperties": {
    "type": "string"
  }
}
EOF

RUN compile foo/bar/baz/qux/very/long/path/foo/bar/baz/qux/schema.json STDIN /dev/null IN . INTO result.txt EXPECTING 0
REPLACE '\\\\' WITH '/' IN result.txt
REPLACE '\\(?!")' WITH '/' IN result.txt

REPLACE $CWD WITH '[CWD]' IN result.txt
REPLACE 'file:///\[CWD\]' WITH 'file://[CWD]' IN result.txt

WRITE expected.txt UNTIL EOF
1> [
