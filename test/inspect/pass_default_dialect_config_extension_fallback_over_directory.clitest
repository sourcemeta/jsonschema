WRITE meta/unused.json UNTIL EOF
{ "type": "string" }
EOF

WRITE meta.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/my-meta",
  "$vocabulary": {
    "https://json-schema.org/draft/2020-12/vocab/core": true,
    "https://json-schema.org/draft/2020-12/vocab/applicator": true,
    "https://json-schema.org/draft/2020-12/vocab/validation": true
  }
}
EOF

WRITE schema.json UNTIL EOF
{ "$id": "https://example.com/x", "type": "string" }
EOF

WRITE jsonschema.json UNTIL EOF
{
  "defaultDialect": "./meta"
}
EOF

RUN inspect schema.json STDIN /dev/null IN . INTO result.txt EXPECTING 0

REPLACE $CWD WITH '[CWD]' IN result.txt
REPLACE 'file:///\[CWD\]' WITH 'file://[CWD]' IN result.txt

WRITE expected.txt UNTIL EOF
1> (RESOURCE) URI: https://example.com/x
1>     Type              : Static
1>     Root              : https://example.com/x
1>     Pointer           :
1>     File Position     : 1:1
1>     Base              : https://example.com/x
1>     Relative Pointer  :
1>     Dialect           : file://[CWD]/meta.json
1>     Base Dialect      : https://json-schema.org/draft/2020-12/schema
1>     Parent            : <NONE>
1>     Property Name     : no
1>     Orphan            : no
1>
1> (POINTER) URI: https://example.com/x#/$id
1>     Type              : Static
1>     Root              : https://example.com/x
1>     Pointer           : /$id
1>     File Position     : 1:3
1>     Base              : https://example.com/x
1>     Relative Pointer  : /$id
1>     Dialect           : file://[CWD]/meta.json
1>     Base Dialect      : https://json-schema.org/draft/2020-12/schema
1>     Parent            :
1>     Property Name     : no
1>     Orphan            : no
1>
1> (POINTER) URI: https://example.com/x#/type
1>     Type              : Static
1>     Root              : https://example.com/x
1>     Pointer           : /type
1>     File Position     : 1:35
1>     Base              : https://example.com/x
1>     Relative Pointer  : /type
1>     Dialect           : file://[CWD]/meta.json
1>     Base Dialect      : https://json-schema.org/draft/2020-12/schema
1>     Parent            :
1>     Property Name     : no
1>     Orphan            : no
EOF

COMPARE result.txt AGAINST expected.txt
