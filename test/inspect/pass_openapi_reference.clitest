// A Path Item Object standing in for another carries where it points along
// with where it sits, and the operation it exposes is reached through the
// Path Item that gives it a URL rather than the one that defines it, so the
// two differ whenever a reference stands between them. What sits inside a
// Schema Object goes on being reported the way a schema on its own is.

WRITE openapi.json UNTIL EOF
{
  "openapi": "3.1.1",
  "info": { "title": "Example", "version": "1.0.0" },
  "paths": {
    "/people": { "$ref": "#/components/pathItems/People" }
  },
  "components": {
    "pathItems": {
      "People": { "get": { "responses": { "200": { "description": "ok" } } } }
    },
    "schemas": { "Person": { "type": "string" } }
  }
}
EOF

RUN inspect openapi.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

REPLACE $CWD_URI WITH '[CWD_URI]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
