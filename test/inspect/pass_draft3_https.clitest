WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft-03/schema#",
  "title": "Test",
  "description": "Test schema",
  "id": "https://example.com",
  "type": "string"
}
EOF

RUN inspect schema.json STDIN /dev/null IN . INTO result.txt EXPECTING 0

