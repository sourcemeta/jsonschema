WRITE schema.json UNTIL EOF
{
  "$schema": "https://example.com/unknown",
  "title": "Test",
  "description": "Test schema",
  "$id": "https://example.com",
  "$ref": "nested"
}
EOF

// Schema input error
RUN inspect schema.json STDIN /dev/null IN . INTO result.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result.txt

WRITE expected.txt UNTIL EOF
2> error: Could not resolve the metaschema of the schema
2>   at identifier https://example.com/unknown
2>   at file path [CWD]/schema.json
2>
2> This is likely because you forgot to import such schema using `--resolve/-r`
EOF

COMPARE result.txt AGAINST expected.txt

// Schema input error
RUN inspect schema.json --json STDIN /dev/null IN . INTO result_json.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_json.txt

WRITE expected_json.txt UNTIL EOF
1> {
1>   "error": "Could not resolve the metaschema of the schema",
1>   "identifier": "https://example.com/unknown",
1>   "filePath": "[CWD]/schema.json"
1> }
EOF

COMPARE result_json.txt AGAINST expected_json.txt
