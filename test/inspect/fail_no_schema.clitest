// Invalid CLI arguments
RUN inspect STDIN /dev/null IN . INTO result.txt EXPECTING 5

WRITE expected.txt UNTIL EOF
2> error: This command expects a path to a schema
2>
2> For example: jsonschema inspect path/to/schema.json
EOF

COMPARE result.txt AGAINST expected.txt

// Invalid CLI arguments
RUN inspect --json STDIN /dev/null IN . INTO result_json.txt EXPECTING 5

WRITE expected_json.txt UNTIL EOF
1> {
1>   "error": "This command expects a path to a schema"
1> }
EOF

COMPARE result_json.txt AGAINST expected_json.txt
