// A description written in YAML is inspected the same way one written in JSON
// is, with the positions naming where each Object sits in the YAML.

WRITE api.yaml UNTIL EOF
openapi: "3.1.1"
info:
  title: Example
  version: "1.0.0"
paths: {}
EOF

RUN inspect api.yaml STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

REPLACE $CWD_URI WITH '[CWD_URI]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
1> (OPENAPI) URI: [CWD_URI]/api.yaml
1>     Pointer           :
1>     File Position     : 1:1
1>     Parent            : <NONE>
1>     Dialect           : https://spec.openapis.org/oas/3.1/dialect/base
1>     Version           : 3.1
1>     Base              : [CWD_URI]/api.yaml
1>     Standalone        : yes
1>     Info              :
1>       Title           : Example
1>       Version         : 1.0.0
1>       Summary         : <NONE>
1>       Description     : <NONE>
1>       Terms of Service: <NONE>
1>       Contact         : <NONE>
1>       License         : <NONE>
1>
1> (INFO) URI: [CWD_URI]/api.yaml#/info
1>     Pointer           : /info
1>     File Position     : 2:1
1>     Parent            : [CWD_URI]/api.yaml
1>
1> (PATHS) URI: [CWD_URI]/api.yaml#/paths
1>     Pointer           : /paths
1>     File Position     : 5:1
1>     Parent            : [CWD_URI]/api.yaml
EOF

COMPARE result_0.txt AGAINST expected_0.txt
