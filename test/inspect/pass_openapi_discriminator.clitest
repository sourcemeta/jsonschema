// A Discriminator Object names a schema by component name or by URI, which is
// a place the description reaches for just as a reference is. One naming
// nothing the frame holds has nowhere to land.

WRITE openapi.json UNTIL EOF
{
  "openapi": "3.1.1",
  "info": { "title": "Example", "version": "1.0.0" },
  "paths": {},
  "components": {
    "schemas": {
      "Pet": {
        "discriminator": {
          "propertyName": "kind",
          "mapping": { "dog": "#/components/schemas/Dog", "cat": "#/components/schemas/Missing" }
        }
      },
      "Dog": { "type": "object" }
    }
  }
}
EOF

RUN inspect openapi.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

REPLACE $CWD_URI WITH '[CWD_URI]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
