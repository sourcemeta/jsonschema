// Every operation the described API exposes gets an entry naming how it is
// reached, which the specification fixes by the route to it rather than by
// where it is defined. An operation may name a tag that nothing declares,
// which keeps its slot rather than being dropped.

WRITE openapi.json UNTIL EOF
{
  "openapi": "3.1.1",
  "info": { "title": "Example", "version": "1.0.0" },
  "tags": [ { "name": "people" } ],
  "webhooks": {
    "newPerson": { "post": { "responses": { "200": { "description": "ok" } } } }
  },
  "paths": {
    "/people": {
      "get": {
        "tags": [ "people", "ghost" ],
        "responses": { "200": { "description": "ok" } }
      }
    }
  }
}
EOF

RUN inspect openapi.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

REPLACE $CWD_URI WITH '[CWD_URI]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
