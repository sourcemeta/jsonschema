WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "age": { "type": "integer" }
  }
}
EOF

RUN inspect schema.json --keywords STDIN /dev/null IN . INTO result.txt EXPECTING 0

WRITE expected.txt UNTIL EOF
1>     3 - type (https://json-schema.org/draft/2020-12/vocab/validation)
1>     1 - properties (https://json-schema.org/draft/2020-12/vocab/applicator)
1>     1 - $schema (https://json-schema.org/draft/2020-12/vocab/core)
EOF

COMPARE result.txt AGAINST expected.txt
