WRITE schema.custom UNTIL EOF
$id: https://example.com
$schema: https://json-schema.org/draft/2020-12/schema
type: string
EOF

RUN fmt schema.custom STDIN /dev/null IN . INTO result.txt EXPECTING 0

WRITE expected.txt UNTIL EOF
EOF

COMPARE result.txt AGAINST expected.txt

WRITE expected_file_0.txt UNTIL EOF
$schema: https://json-schema.org/draft/2020-12/schema
$id: https://example.com
type: string
EOF

COMPARE schema.custom AGAINST expected_file_0.txt
