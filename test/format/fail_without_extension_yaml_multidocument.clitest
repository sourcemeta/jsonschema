WRITE schema UNTIL EOF
$schema: https://json-schema.org/draft/2020-12/schema
type: string
---
$schema: https://json-schema.org/draft/2020-12/schema
type: integer
EOF

// Not supported
RUN fmt schema STDIN /dev/null IN . INTO result.txt EXPECTING 3

REPLACE $CWD WITH '[CWD]' IN result.txt

WRITE expected.txt UNTIL EOF
2> error: This command does not support input with multiple documents
2>   at file path [CWD]/schema
EOF

COMPARE result.txt AGAINST expected.txt

// Not supported
RUN fmt schema --json STDIN /dev/null IN . INTO result_json.txt EXPECTING 3

REPLACE $CWD WITH '[CWD]' IN result_json.txt

WRITE expected_json.txt UNTIL EOF
1> {
1>   "error": "This command does not support input with multiple documents",
1>   "filePath": "[CWD]/schema"
1> }
EOF

COMPARE result_json.txt AGAINST expected_json.txt

WRITE expected_file_0.txt UNTIL EOF
$schema: https://json-schema.org/draft/2020-12/schema
type: string
---
$schema: https://json-schema.org/draft/2020-12/schema
type: integer
EOF

COMPARE schema AGAINST expected_file_0.txt
