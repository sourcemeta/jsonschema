WRITE openapi.json UNTIL EOF
{
  "paths": {},
  "info": { "version": "1.0.0", "title": "Example" },
  "openapi": "3.1.1",
  "components": {
    "schemas": {
      "Pet": { "type": "string", "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "Pet" }
    }
  }
}
EOF

RUN fmt openapi.json STDIN /dev/null IN . INTO result.txt EXPECTING 0

WRITE expected.txt UNTIL EOF
EOF

COMPARE result.txt AGAINST expected.txt

WRITE expected_file_0.txt UNTIL EOF
{
  "openapi": "3.1.1",
  "info": {
    "title": "Example",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "Pet": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Pet",
        "type": "string"
      }
    }
  }
}
EOF

COMPARE openapi.json AGAINST expected_file_0.txt
