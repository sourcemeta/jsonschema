WRITE first.json UNTIL EOF
{ "$schema": "https://json-schema.org/draft/2020-12/schema" }
EOF

WRITE second.json UNTIL EOF
{ "$schema": "https://json-schema.org/draft/2020-12/schema" }
EOF

WRITE jsonschema.json UNTIL EOF
{
  "resolve": {
    "https://example.com/second": "./second.json",
    "https://example.com/first": "./first.json"
  },
  "title": "My project"
}
EOF

RUN fmt jsonschema.json STDIN /dev/null IN . INTO result.txt EXPECTING 0

REPLACE $CWD WITH '[CWD]' IN result.txt

WRITE expected.txt UNTIL EOF
2> Interpreting as a configuration file: [CWD]/jsonschema.json
EOF

COMPARE result.txt AGAINST expected.txt

WRITE expected_file_0.txt UNTIL EOF
{
  "title": "My project",
  "resolve": {
    "https://example.com/first": "./first.json",
    "https://example.com/second": "./second.json"
  }
}
EOF

COMPARE jsonschema.json AGAINST expected_file_0.txt
