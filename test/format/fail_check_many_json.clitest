WRITE schemas/1.json UNTIL EOF
{
  "type": "string",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Test",
  "description": "Test schema"
}
EOF

WRITE schemas/2.json UNTIL EOF
{
  "type": "string",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Test",
  "description": "Test schema"
}
EOF

WRITE schemas/3.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Test",
  "description": "Test schema"
}
EOF

// Validation failure
RUN fmt schemas --check --json STDIN /dev/null IN . INTO result.txt EXPECTING 2

REPLACE $CWD WITH '[CWD]' IN result.txt

WRITE expected.txt UNTIL EOF
1> {
1>   "valid": false,
1>   "errors": [
1>     "[CWD]/schemas/1.json",
1>     "[CWD]/schemas/2.json"
1>   ]
1> }
EOF

COMPARE result.txt AGAINST expected.txt
