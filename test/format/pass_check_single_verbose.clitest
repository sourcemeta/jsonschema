WRITE schema.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Test",
  "description": "Test schema",
  "type": 1
}
EOF

RUN fmt schema.json --check --verbose STDIN /dev/null IN . INTO result.txt EXPECTING 0
REPLACE '\\\\' WITH '/' IN result.txt
REPLACE '\\(?!")' WITH '/' IN result.txt

REPLACE $CWD WITH '[CWD]' IN result.txt

WRITE expected.txt UNTIL EOF
2> Checking: [CWD]/schema.json
2> ok: [CWD]/schema.json
EOF

COMPARE result.txt AGAINST expected.txt

WRITE expected_file_0.txt UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Test",
  "description": "Test schema",
  "type": 1
}
EOF

COMPARE schema.json AGAINST expected_file_0.txt
