WRITE schema.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Test",
  "description": "Test schema",
  "type": 1
}
EOF

RUN fmt schema.json --check --verbose --color always STDIN /dev/null IN . INTO result.txt EXPECTING 0

REPLACE $CWD WITH '[CWD]' IN result.txt
REPLACE MATCHING '\x1B\[1;32m' WITH '[ANSI_BOLD_GREEN]' IN result.txt
REPLACE MATCHING '\x1B\[0m' WITH '[ANSI_RESET]' IN result.txt

WRITE expected.txt UNTIL EOF
2> Checking: [CWD]/schema.json
2> [ANSI_BOLD_GREEN]✓ ok:[ANSI_RESET] [CWD]/schema.json
EOF

COMPARE result.txt AGAINST expected.txt

WRITE expected_file_0.txt UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Test",
  "description": "Test schema",
  "type": 1
}
EOF

COMPARE schema.json AGAINST expected_file_0.txt
