WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Test schema",
  "additionalProperties": false,
  "title": "Hello World",
  "properties": {"foo": {}, "bar": {}}
}
EOF

WRITE jsonschema.json UNTIL EOF
{
  "defaultDialect": "https://json-schema.org/draft/2020-12/schema",
  "ignore": [
    "./jsonschema.json"
  ]
}
EOF

RUN fmt STDIN /dev/null IN . INTO result.txt EXPECTING 0
REPLACE '\\\\' WITH '/' IN result.txt
REPLACE '\\(?!")' WITH '/' IN result.txt

REPLACE $CWD WITH '[CWD]' IN result.txt

WRITE expected.txt UNTIL EOF
2> warning: Recursively processing every file in [CWD] as the configuration file does not set an explicit path
EOF

COMPARE result.txt AGAINST expected.txt

WRITE expected_file_0.txt UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hello World",
  "description": "Test schema",
  "properties": {
    "foo": {},
    "bar": {}
  },
  "additionalProperties": false
}
EOF

COMPARE schema.json AGAINST expected_file_0.txt
