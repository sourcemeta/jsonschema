// Naming a document with `$self` is something only 3.2 admits, so a 3.1
// description that spells one is turned down rather than being read as
// though the field established its identity.

WRITE openapi.json UNTIL EOF
{
  "openapi": "3.1.1",
  "$self": "https://example.com/declared",
  "info": { "title": "Example", "version": "1.0.0" },
  "paths": {},
  "components": { "schemas": { "S": { "type": "string" } } }
}
EOF

// Schema input error
RUN fmt openapi.json --check STDIN /dev/null IN . INTO result_0.txt EXPECTING 4

REPLACE $CWD_URI WITH '[CWD_URI]' IN result_0.txt
REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: The OpenAPI Object does not define this field
2>   at line 3
2>   at column 3
2>   at file path [CWD]/openapi.json
2>   at location "/$self"
2>   at base uri [CWD_URI]/openapi.json
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Schema input error
RUN fmt openapi.json --check --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 4

REPLACE $CWD_URI WITH '[CWD_URI]' IN result_1.txt
REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "The OpenAPI Object does not define this field",
1>   "line": 3,
1>   "column": 3,
1>   "filePath": "[CWD]/openapi.json",
1>   "location": "/$self",
1>   "baseURI": "[CWD_URI]/openapi.json"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
