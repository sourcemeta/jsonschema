WRITE schema.yaml UNTIL EOF
$schema: https://json-schema.org/draft/2020-12/schema
title: Hello World
type: object
properties:
  foo:
    type: string
EOF

RUN fmt schema.yaml --indentation 4 STDIN /dev/null IN . INTO result.txt EXPECTING 0

WRITE expected.txt UNTIL EOF
EOF

COMPARE result.txt AGAINST expected.txt

WRITE expected_file_0.txt UNTIL EOF
$schema: https://json-schema.org/draft/2020-12/schema
title: Hello World
type: object
properties:
    foo:
        type: string
EOF

COMPARE schema.yaml AGAINST expected_file_0.txt
