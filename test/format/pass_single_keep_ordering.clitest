WRITE schema.json UNTIL EOF
{
  "additionalProperties": false,
  "title": "Hello World",
  "properties": {"foo": {}, "bar": {}}
}
EOF

RUN fmt --keep-ordering schema.json STDIN /dev/null IN . INTO result.txt EXPECTING 0

REPLACE $CWD WITH '[CWD]' IN result.txt

WRITE expected.txt UNTIL EOF
EOF

COMPARE result.txt AGAINST expected.txt

WRITE expected_file_0.txt UNTIL EOF
{
  "additionalProperties": false,
  "title": "Hello World",
  "properties": {
    "foo": {},
    "bar": {}
  }
}
EOF

COMPARE schema.json AGAINST expected_file_0.txt
