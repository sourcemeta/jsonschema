WRITE schema.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Test",
  "description": "Test schema",
  "minimum": 1e-05
}
EOF

RUN fmt schema.json STDIN /dev/null IN . INTO result.txt EXPECTING 0

REPLACE '\\\\' WITH '/' IN result.txt
REPLACE '\\(?!")' WITH '/' IN result.txt
REPLACE $CWD WITH '[CWD]' IN result.txt

WRITE expected.txt UNTIL EOF
EOF

COMPARE result.txt AGAINST expected.txt

WRITE expected_file_0.txt UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Test",
  "description": "Test schema",
  "minimum": 1e-5
}
EOF

COMPARE schema.json AGAINST expected_file_0.txt
