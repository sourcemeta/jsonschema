WRITE schemas/schema1 UNTIL EOF
$schema: https://json-schema.org/draft/2020-12/schema
description: Test schema
additionalProperties: false
title: Hello World
EOF

RUN fmt schemas --extension '' STDIN /dev/null IN . INTO result.txt EXPECTING 0

WRITE expected.txt UNTIL EOF
2> warning: Matching files with no extension
EOF

COMPARE result.txt AGAINST expected.txt

WRITE expected_file_0.txt UNTIL EOF
$schema: https://json-schema.org/draft/2020-12/schema
title: Hello World
description: Test schema
additionalProperties: false
EOF

COMPARE schemas/schema1 AGAINST expected_file_0.txt
