WRITE openapi.json UNTIL EOF
{
  "paths": {},
  "info": { "version": "1.0.0", "title": "Example" },
  "openapi": "3.1.1"
}
EOF

RUN fmt openapi.json --keep-ordering STDIN /dev/null IN . INTO result.txt EXPECTING 0

WRITE expected.txt UNTIL EOF
EOF

COMPARE result.txt AGAINST expected.txt

WRITE expected_file_0.txt UNTIL EOF
{
  "paths": {},
  "info": {
    "version": "1.0.0",
    "title": "Example"
  },
  "openapi": "3.1.1"
}
EOF

COMPARE openapi.json AGAINST expected_file_0.txt
