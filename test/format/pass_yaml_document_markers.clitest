WRITE schema.yaml UNTIL EOF
%YAML 1.2
---
$schema: https://json-schema.org/draft/2020-12/schema
type: object
title: Markers
...
EOF

RUN fmt schema.yaml STDIN /dev/null IN . INTO result.txt EXPECTING 0

WRITE expected.txt UNTIL EOF
EOF

COMPARE result.txt AGAINST expected.txt

WRITE expected_file_0.txt UNTIL EOF
%YAML 1.2
---
$schema: https://json-schema.org/draft/2020-12/schema
title: Markers
type: object
...
EOF

COMPARE schema.yaml AGAINST expected_file_0.txt
