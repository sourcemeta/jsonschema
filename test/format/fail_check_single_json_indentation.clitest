WRITE this/is/a/very/very/very/very/very/very/very/very/long/nested/path/schema.json UNTIL EOF
{
  "type": "string",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Test",
  "description": "Test schema"
}
EOF

// Validation failure
RUN fmt this/is/a/very/very/very/very/very/very/very/very/long/nested/path/schema.json --check --json --indentation 4 STDIN /dev/null IN . INTO result.txt EXPECTING 2

REPLACE $CWD WITH '[CWD]' IN result.txt

WRITE expected.txt UNTIL EOF
1> {
1>     "valid": false,
1>     "errors": [
1>         {
1>             "path": "[CWD]/this/is/a/very/very/very/very/very/very/very/very/long/nested/path/schema.json",
1>             "diff": [
1>                 {
1>                     "type": "equal",
1>                     "lines": [ "{" ]
1>                 },
1>                 {
1>                     "type": "delete",
1>                     "lines": [
1>                         "  \"type\": \"string\",",
1>                         "  \"$schema\": \"http://json-schema.org/draft-04/schema#\",",
1>                         "  \"title\": \"Test\",",
1>                         "  \"description\": \"Test schema\""
1>                     ]
1>                 },
1>                 {
1>                     "type": "insert",
1>                     "lines": [
1>                         "    \"$schema\": \"http://json-schema.org/draft-04/schema#\",",
1>                         "    \"title\": \"Test\",",
1>                         "    \"description\": \"Test schema\",",
1>                         "    \"type\": \"string\""
1>                     ]
1>                 },
1>                 {
1>                     "type": "equal",
1>                     "lines": [ "}" ]
1>                 }
1>             ]
1>         }
1>     ]
1> }
EOF

COMPARE result.txt AGAINST expected.txt
