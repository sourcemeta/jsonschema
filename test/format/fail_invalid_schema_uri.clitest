WRITE schema.json UNTIL EOF
{
  "$schema": "not a valid uri",
  "type": "string"
}
EOF

// Schema input error
RUN fmt schema.json STDIN /dev/null IN . INTO result.txt EXPECTING 4
REPLACE '\\\\' WITH '/' IN result.txt
REPLACE '\\(?!")' WITH '/' IN result.txt

REPLACE $CWD WITH '[CWD]' IN result.txt

WRITE expected.txt UNTIL EOF
2> error: The dialect is not a valid URI
2>   at value not a valid uri
2>   at keyword $schema
2>   at file path [CWD]/schema.json
2>
2> Are you sure the input is a valid JSON Schema and it is valid according to its meta-schema?
EOF

COMPARE result.txt AGAINST expected.txt
