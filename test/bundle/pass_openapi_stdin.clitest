WRITE stdin_input UNTIL EOF
{
  "openapi": "3.2.0",
  "info": { "title": "Example", "version": "1.0.0" },
  "paths": {
    "/pets": {
      "get": {
        "responses": {
          "200": { "$ref": "https://example.com/shared#/components/responses/Ok" }
        }
      }
    }
  }
}
EOF

WRITE shared.json UNTIL EOF
{
  "openapi": "3.2.0",
  "$self": "https://example.com/shared",
  "info": { "title": "Shared", "version": "1.0.0" },
  "components": {
    "responses": {
      "Ok": { "description": "All good" }
    }
  }
}
EOF

RUN bundle - --resolve shared.json STDIN stdin_input IN . INTO result.txt EXPECTING 0

WRITE expected.txt UNTIL EOF
1> {
1>   "openapi": "3.2.0",
1>   "info": {
1>     "title": "Example",
1>     "version": "1.0.0"
1>   },
1>   "paths": {
1>     "/pets": {
1>       "get": {
1>         "responses": {
1>           "200": {
1>             "$ref": "#/components/responses/Ok"
1>           }
1>         }
1>       }
1>     }
1>   },
1>   "components": {
1>     "responses": {
1>       "Ok": {
1>         "description": "All good"
1>       }
1>     }
1>   }
1> }
EOF

COMPARE result.txt AGAINST expected.txt
