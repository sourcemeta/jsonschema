// A v3.0 Schema Object admits no identifier and no dialect declaration, so a
// schema the resolution context hands over keeps neither, and what reaches it
// across files lands in the container that revision spells, named by a pointer

WRITE schema.json UNTIL EOF
{
  "type": "object",
  "properties": {
    "name": { "$ref": "./nested.json" }
  }
}
EOF

WRITE nested.json UNTIL EOF
{
  "type": "string",
  "minLength": 1
}
EOF

WRITE silent.txt UNTIL EOF
EOF

RUN bundle schema.json --default-dialect tag:spec.openapis.org,2024-10-18:oas/3.0/dialect --resolve nested.json STDIN /dev/null IN . INTO result.txt EXPECTING 0

EXTRACT STDOUT FROM result.txt INTO bundled.json

REPLACE $CWD_URI WITH '[CWD_URI]' IN result.txt
REPLACE MATCHING 'file:[^"]*~1nested\.json' WITH '[CWD_URI_POINTER]~1nested.json' IN result.txt

WRITE expected_0.txt UNTIL EOF
1> {
1>   "type": "object",
1>   "properties": {
1>     "name": {
1>       "$ref": "#/x-definitions/[CWD_URI_POINTER]~1nested.json"
1>     }
1>   },
1>   "x-definitions": {
1>     "[CWD_URI]/nested.json": {
1>       "type": "string",
1>       "minLength": 1
1>     }
1>   }
1> }
EOF

COMPARE result.txt AGAINST expected_0.txt

RUN metaschema bundled.json --default-dialect tag:spec.openapis.org,2024-10-18:oas/3.0/dialect STDIN /dev/null IN . INTO checked.txt EXPECTING 0

WRITE expected_1.txt UNTIL EOF
2> 1 validated, 1 passed, 0 failed
EOF

COMPARE checked.txt AGAINST expected_1.txt
