WRITE entry.json UNTIL EOF
{
  "openapi": "3.2.0",
  "info": { "title": "Example", "version": "1.0.0" },
  "paths": {
    "/pets": {
      "get": {
        "responses": {
          "200": { "$ref": "https://example.com/shared#/components/responses/Ok" }
        }
      }
    }
  }
}
EOF

WRITE one.json UNTIL EOF
{
  "openapi": "3.2.0",
  "$self": "https://example.com/shared",
  "info": { "title": "One", "version": "1.0.0" },
  "components": {
    "responses": {
      "Ok": { "description": "from one" }
    }
  }
}
EOF

WRITE two.json UNTIL EOF
{
  "openapi": "3.2.0",
  "$self": "https://example.com/shared",
  "info": { "title": "Two", "version": "1.0.0" },
  "components": {
    "responses": {
      "Ok": { "description": "from two" }
    }
  }
}
EOF

// Schema input error
RUN bundle entry.json --resolve one.json --resolve two.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: Conflicting OpenAPI descriptions for the same identifier
2>   at identifier https://example.com/shared
2>   at file path [CWD]/two.json
2>   at other path [CWD]/one.json
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Schema input error
RUN bundle entry.json --resolve one.json --resolve two.json --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "Conflicting OpenAPI descriptions for the same identifier",
1>   "identifier": "https://example.com/shared",
1>   "filePath": "[CWD]/two.json",
1>   "otherPath": "[CWD]/one.json"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
