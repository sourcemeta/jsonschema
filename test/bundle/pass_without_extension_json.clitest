WRITE schema UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test",
  "description": "Test schema",
  "$id": "https://example.com",
  "$ref": "nested"
}
EOF

WRITE remote UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/nested",
  "type": "string"
}
EOF

WRITE silent.txt UNTIL EOF
EOF

RUN bundle schema --resolve remote STDIN /dev/null IN . INTO result.txt EXPECTING 0

EXTRACT STDOUT FROM result.txt INTO bundled.json

WRITE expected_0.txt UNTIL EOF
1> {
1>   "$schema": "https://json-schema.org/draft/2020-12/schema",
1>   "$id": "https://example.com",
1>   "title": "Test",
1>   "description": "Test schema",
1>   "$ref": "nested",
1>   "$defs": {
1>     "https://example.com/nested": {
1>       "$schema": "https://json-schema.org/draft/2020-12/schema",
1>       "$id": "https://example.com/nested",
1>       "type": "string"
1>     }
1>   }
1> }
EOF

COMPARE result.txt AGAINST expected_0.txt

RUN fmt bundled.json --check STDIN /dev/null IN . INTO checked.txt EXPECTING 0

COMPARE checked.txt AGAINST silent.txt
