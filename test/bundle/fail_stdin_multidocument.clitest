WRITE stdin_input UNTIL EOF
---
$schema: https://json-schema.org/draft/2020-12/schema
type: string
---
$schema: https://json-schema.org/draft/2020-12/schema
type: integer
EOF

// Not supported
RUN bundle - STDIN stdin_input IN . INTO result_0.txt EXPECTING 3

WRITE expected_0.txt UNTIL EOF
2> error: This command does not support reading multiple documents from standard input
2>   at file path tag:sourcemeta.com,2026:jsonschema/stdin
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Not supported
RUN bundle - --json STDIN stdin_input IN . INTO result_1.txt EXPECTING 3

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "This command does not support reading multiple documents from standard input",
1>   "filePath": "tag:sourcemeta.com,2026:jsonschema/stdin"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
