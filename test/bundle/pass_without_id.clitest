WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test",
  "description": "Test schema",
  "$id": "https://example.com",
  "$ref": "nested"
}
EOF

WRITE schemas/remote.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test",
  "description": "Test schema",
  "$id": "https://example.com/nested",
  "type": "string"
}
EOF

WRITE silent.txt UNTIL EOF
EOF

RUN bundle schema.json --resolve schemas --without-id STDIN /dev/null IN . INTO result.txt EXPECTING 0

COPY result.txt TO bundled.json
KEEP LINES MATCHING '^1>' IN bundled.json
REPLACE '^1> ?' WITH '' IN bundled.json

WRITE expected_0.txt UNTIL EOF
1> {
1>   "$schema": "https://json-schema.org/draft/2020-12/schema",
1>   "title": "Test",
1>   "description": "Test schema",
1>   "$ref": "#/$defs/https:~1~1example.com~1nested",
1>   "$defs": {
1>     "https://example.com/nested": {
1>       "$schema": "https://json-schema.org/draft/2020-12/schema",
1>       "title": "Test",
1>       "description": "Test schema",
1>       "type": "string"
1>     }
1>   }
1> }
2> warning: You are opting in to remove schema identifiers in the bundled schema.
2> The only legit use case of this advanced feature we know of is to workaround
2> non-compliant JSON Schema implementations such as Visual Studio Code.
2> Otherwise, this is not needed and may harm other use cases. For example,
2> you will be unable to reference the resulting schema from other schemas
2> using the --resolve/-r option.
EOF

COMPARE result.txt AGAINST expected_0.txt

RUN fmt bundled.json --check STDIN /dev/null IN . INTO checked.txt EXPECTING 0

COMPARE checked.txt AGAINST silent.txt
