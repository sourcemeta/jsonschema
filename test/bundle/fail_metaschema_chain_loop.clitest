WRITE jsonschema.json UNTIL EOF
{
  "resolve": {
    "https://example.com/a": "a.json",
    "https://example.com/b": "b.json"
  }
}
EOF

WRITE a.json UNTIL EOF
{
  "$schema": "https://example.com/b",
  "$id": "https://example.com/a",
  "$vocabulary": {
    "https://json-schema.org/draft/2020-12/vocab/core": true
  }
}
EOF

WRITE b.json UNTIL EOF
{
  "$schema": "https://example.com/a",
  "$id": "https://example.com/b",
  "$vocabulary": {
    "https://json-schema.org/draft/2020-12/vocab/core": true
  }
}
EOF

WRITE schema.json UNTIL EOF
{
  "$schema": "https://example.com/a",
  "type": "string"
}
EOF

// Schema input error
RUN bundle schema.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: Could not determine the base dialect of the schema
2>   at file path [CWD]/schema.json
2>
2> Are you sure the input is a valid JSON Schema and its base dialect is known?
2> If the input does not declare the `$schema` keyword, you might want to
2> explicitly declare a default dialect using `--default-dialect/-d`
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Schema input error
RUN bundle schema.json --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "Could not determine the base dialect of the schema",
1>   "filePath": "[CWD]/schema.json"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
