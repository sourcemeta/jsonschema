WRITE openapi.json UNTIL EOF
{
  "openapi": "3.1.1",
  "info": { "title": "Example", "version": "1.0.0" },
  "paths": {},
  "components": {
    "schemas": {
      "pet": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://example.com/schemas/pet",
        "externalDocs": { "url": "./docs/pet.html" },
        "type": "object"
      }
    }
  }
}
EOF

RUN bundle openapi.json STDIN /dev/null IN . INTO result.txt EXPECTING 0

WRITE expected.txt UNTIL EOF
1> {
1>   "openapi": "3.1.1",
1>   "info": {
1>     "title": "Example",
1>     "version": "1.0.0"
1>   },
1>   "paths": {},
1>   "components": {
1>     "schemas": {
1>       "pet": {
1>         "$schema": "https://json-schema.org/draft/2020-12/schema",
1>         "$id": "https://example.com/schemas/pet",
1>         "externalDocs": {
1>           "url": "./docs/pet.html"
1>         },
1>         "type": "object"
1>       }
1>     }
1>   }
1> }
EOF

COMPARE result.txt AGAINST expected.txt
