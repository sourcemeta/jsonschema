WRITE input.yaml UNTIL EOF
$schema: https://json-schema.org/draft/2020-12/schema
$id: https://example.com
$ref: nested
EOF

WRITE remote.yaml UNTIL EOF
$schema: https://json-schema.org/draft/2020-12/schema
$id: https://example.com/nested
type: string
EOF

RUN bundle - --resolve remote.yaml STDIN input.yaml IN . INTO result.txt EXPECTING 0

WRITE expected.txt UNTIL EOF
1> $schema: https://json-schema.org/draft/2020-12/schema
1> $id: https://example.com
1> $ref: nested
1> $defs:
1>   https://example.com/nested:
1>     $schema: https://json-schema.org/draft/2020-12/schema
1>     $id: https://example.com/nested
1>     type: string
EOF

COMPARE result.txt AGAINST expected.txt
