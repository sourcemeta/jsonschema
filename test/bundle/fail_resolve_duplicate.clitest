WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test",
  "description": "Test schema",
  "$id": "https://example.com",
  "$ref": "nested"
}
EOF

WRITE schemas/remote.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test",
  "description": "Test schema",
  "$id": "https://example.com/nested",
  "type": "string"
}
EOF

WRITE schemas/duplicated.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test",
  "description": "Test schema",
  "$id": "https://example.com/nested",
  "type": "number"
}
EOF

// Schema input error
RUN bundle schema.json --resolve schemas STDIN /dev/null IN . INTO result.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result.txt

WRITE expected_0.txt UNTIL EOF
2> error: Conflicting schemas for the same identifier
2>   at identifier https://example.com/nested
2>   at line 1
2>   at column 1
2>   at file path [CWD]/schemas/remote.json
2>   at location ""
2>   at other file path [CWD]/schemas/duplicated.json
2>   at other location ""
EOF

COMPARE result.txt AGAINST expected_0.txt

// Schema input error
RUN bundle schema.json --resolve schemas --json STDIN /dev/null IN . INTO result_json.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_json.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "Conflicting schemas for the same identifier",
1>   "identifier": "https://example.com/nested",
1>   "line": 1,
1>   "column": 1,
1>   "filePath": "[CWD]/schemas/remote.json",
1>   "location": "",
1>   "otherFilePath": "[CWD]/schemas/duplicated.json",
1>   "otherLocation": ""
1> }
EOF

COMPARE result_json.txt AGAINST expected_1.txt
