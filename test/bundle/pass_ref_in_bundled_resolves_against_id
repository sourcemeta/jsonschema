WRITE entry.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Entry",
  "$ref": "./bundled.json"
}
EOF

WRITE bundled.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/parent",
  "$ref": "./child",
  "$defs": {
    "https://example.com/schemas/child": {
      "$id": "https://example.com/schemas/child",
      "type": "string"
    }
  }
}
EOF

RUN bundle entry.json STDIN /dev/null IN . INTO result.txt EXPECTING 0
REPLACE '\\\\' WITH '/' IN result.txt
REPLACE '\\(?!")' WITH '/' IN result.txt

REPLACE $CWD WITH '[CWD]' IN result.txt
REPLACE 'file:///\[CWD\]' WITH 'file://[CWD]' IN result.txt

WRITE expected.txt UNTIL EOF
1> {
1>   "$schema": "https://json-schema.org/draft/2020-12/schema",
1>   "$id": "file://[CWD]/entry.json",
1>   "title": "Entry",
1>   "$ref": "https://example.com/schemas/parent",
1>   "$defs": {
1>     "https://example.com/schemas/child": {
1>       "$schema": "https://json-schema.org/draft/2020-12/schema",
1>       "$id": "https://example.com/schemas/child",
1>       "type": "string"
1>     },
1>     "https://example.com/schemas/parent": {
1>       "$schema": "https://json-schema.org/draft/2020-12/schema",
1>       "$id": "https://example.com/schemas/parent",
1>       "$ref": "./child"
1>     }
1>   }
1> }
EOF

COMPARE result.txt AGAINST expected.txt
