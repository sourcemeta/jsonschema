WRITE openapi.json UNTIL EOF
{
  "paths": {
    "/pets": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": { "$ref": "https://example.com/schemas/pet" }
              }
            },
            "description": "OK"
          }
        }
      }
    }
  },
  "info": { "version": "1.0.0", "title": "Example" },
  "openapi": "3.1.1"
}
EOF

WRITE pet.json UNTIL EOF
{
  "type": "object",
  "$id": "https://example.com/schemas/pet",
  "title": "Pet",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
EOF

RUN bundle openapi.json --resolve pet.json STDIN /dev/null IN . INTO result.txt EXPECTING 0

EXTRACT STDOUT FROM result.txt INTO bundled.json

WRITE expected.txt UNTIL EOF
1> {
1>   "openapi": "3.1.1",
1>   "info": {
1>     "title": "Example",
1>     "version": "1.0.0"
1>   },
1>   "paths": {
1>     "/pets": {
1>       "get": {
1>         "responses": {
1>           "200": {
1>             "description": "OK",
1>             "content": {
1>               "application/json": {
1>                 "schema": {
1>                   "$ref": "https://example.com/schemas/pet"
1>                 }
1>               }
1>             }
1>           }
1>         }
1>       }
1>     }
1>   },
1>   "components": {
1>     "schemas": {
1>       "pet": {
1>         "$schema": "https://json-schema.org/draft/2020-12/schema",
1>         "$id": "https://example.com/schemas/pet",
1>         "title": "Pet",
1>         "type": "object"
1>       }
1>     }
1>   }
1> }
EOF

COMPARE result.txt AGAINST expected.txt

WRITE silent.txt UNTIL EOF
EOF

RUN fmt bundled.json --check STDIN /dev/null IN . INTO checked.txt EXPECTING 0

COMPARE checked.txt AGAINST silent.txt
