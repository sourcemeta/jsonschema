WRITE schema.json UNTIL EOF
true
EOF

WRITE silent.txt UNTIL EOF
EOF

RUN bundle schema.json --default-dialect https://json-schema.org/draft/2020-12/schema STDIN /dev/null IN . INTO result.txt EXPECTING 0

EXTRACT STDOUT FROM result.txt INTO bundled.json

WRITE expected_0.txt UNTIL EOF
1> true
EOF

COMPARE result.txt AGAINST expected_0.txt

RUN fmt bundled.json --check --default-dialect https://json-schema.org/draft/2020-12/schema STDIN /dev/null IN . INTO checked.txt EXPECTING 0

COMPARE checked.txt AGAINST silent.txt
