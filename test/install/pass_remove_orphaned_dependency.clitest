MAKE DIRECTORY source

MAKE DIRECTORY project/vendor

WRITE source/a.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/a",
  "type": "string"
}
EOF

WRITE source/b.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/b",
  "type": "integer"
}
EOF

WRITE project/jsonschema.json UNTIL EOF
{
  "dependencies": {
    "[CWD_URI]/source/a.json": "./vendor/a.json",
    "[CWD_URI]/source/b.json": "./vendor/b.json"
  }
}
EOF

REPLACE '\[CWD_URI\]' WITH $CWD_URI IN project/jsonschema.json

RUN install STDIN /dev/null IN project INTO result_0.txt EXPECTING 0
REPLACE '\\\\' WITH '/' IN result_0.txt
REPLACE '\\(?!")' WITH '/' IN result_0.txt

REPLACE $CWD WITH '[CWD]' IN result_0.txt
REPLACE 'file:///\[CWD\]' WITH 'file://[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> Fetching       : file://[CWD]/source/a.json
2> Installed      : [CWD]/project/vendor/a.json
2> Fetching       : file://[CWD]/source/b.json
2> Installed      : [CWD]/project/vendor/b.json
EOF

COMPARE result_0.txt AGAINST expected_0.txt

WRITE expected_a.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/a",
  "type": "string"
}
EOF

COMPARE project/vendor/a.json AGAINST expected_a.json

WRITE expected_b.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/b",
  "type": "integer"
}
EOF

COMPARE project/vendor/b.json AGAINST expected_b.json

CHECKSUM SHA256 project/vendor/a.json AS HASH_A
CHECKSUM SHA256 project/vendor/b.json AS HASH_B

COPY project/jsonschema.lock.json TO checked_lock.json
REPLACE '\\\\' WITH '/' IN checked_lock.json
REPLACE $CWD WITH '[CWD]' IN checked_lock.json
REPLACE 'file:///\[CWD\]' WITH 'file://[CWD]' IN checked_lock.json

WRITE expected_lock.json UNTIL EOF
{
  "version": 1,
  "dependencies": {
    "file://[CWD]/source/a.json": {
      "path": "./vendor/a.json",
      "hash": "[HASH_A]",
      "hashAlgorithm": "sha256"
    },
    "file://[CWD]/source/b.json": {
      "path": "./vendor/b.json",
      "hash": "[HASH_B]",
      "hashAlgorithm": "sha256"
    }
  }
}
EOF

REPLACE '\[HASH_A\]' WITH $HASH_A IN expected_lock.json
REPLACE '\[HASH_B\]' WITH $HASH_B IN expected_lock.json

COMPARE checked_lock.json AGAINST expected_lock.json

WRITE project/jsonschema.json UNTIL EOF
{
  "dependencies": {
    "[CWD_URI]/source/a.json": "./vendor/a.json"
  }
}
EOF

REPLACE '\[CWD_URI\]' WITH $CWD_URI IN project/jsonschema.json

RUN install STDIN /dev/null IN project INTO result_1.txt EXPECTING 0
REPLACE '\\\\' WITH '/' IN result_1.txt
REPLACE '\\(?!")' WITH '/' IN result_1.txt

REPLACE $CWD WITH '[CWD]' IN result_1.txt
REPLACE 'file:///\[CWD\]' WITH 'file://[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
2> Up to date     : file://[CWD]/source/a.json
2> Orphaned       : file://[CWD]/source/b.json
EOF

COMPARE result_1.txt AGAINST expected_1.txt

TREE project/vendor INTO listing.txt

WRITE expected_listing.txt UNTIL EOF
./a.json
EOF

COMPARE listing.txt AGAINST expected_listing.txt

COMPARE project/vendor/a.json AGAINST expected_a.json

COPY project/jsonschema.lock.json TO checked_lock_after.json
REPLACE '\\\\' WITH '/' IN checked_lock_after.json
REPLACE $CWD WITH '[CWD]' IN checked_lock_after.json
REPLACE 'file:///\[CWD\]' WITH 'file://[CWD]' IN checked_lock_after.json

WRITE expected_lock_after.json UNTIL EOF
{
  "version": 1,
  "dependencies": {
    "file://[CWD]/source/a.json": {
      "path": "./vendor/a.json",
      "hash": "[HASH_A]",
      "hashAlgorithm": "sha256"
    }
  }
}
EOF

REPLACE '\[HASH_A\]' WITH $HASH_A IN expected_lock_after.json

COMPARE checked_lock_after.json AGAINST expected_lock_after.json
