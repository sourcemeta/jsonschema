MAKE DIRECTORY source

MAKE DIRECTORY project

WRITE source/schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "string"
}
EOF

WRITE project/jsonschema.json UNTIL EOF
{
  "dependencies": {
    "[CWD_URI]/source/schema.json": "./vendor/schema.json"
  }
}
EOF

REPLACE '\[CWD_URI\]' WITH $CWD_URI IN project/jsonschema.json

RUN install STDIN /dev/null IN project INTO result_0.txt EXPECTING 0

COPY project/jsonschema.lock.json TO lock_before.json

REMOVE project/vendor/schema.json

RUN install --frozen --debug STDIN /dev/null IN project INTO result_1.txt EXPECTING 0

REPLACE $CWD_URI WITH '[CWD_URI]' IN result_1.txt
REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
2> debug: fetch/start: [CWD_URI]/source/schema.json (1/1) -> [CWD]/project/vendor/schema.json
2> Fetching       : [CWD_URI]/source/schema.json
2> debug: Attempting to read file reference from disk: [CWD]/source/schema.json
2> debug: fetch/end: [CWD_URI]/source/schema.json (1/1) -> [CWD]/project/vendor/schema.json
2> debug: bundle/start: [CWD_URI]/source/schema.json (1/1) -> [CWD]/project/vendor/schema.json
2> Bundling       : [CWD_URI]/source/schema.json
2> debug: bundle/end: [CWD_URI]/source/schema.json (1/1) -> [CWD]/project/vendor/schema.json
2> debug: write/start: [CWD_URI]/source/schema.json (1/1) -> [CWD]/project/vendor/schema.json
2> Writing        : [CWD]/project/vendor/schema.json
2> debug: write/end: [CWD_URI]/source/schema.json (1/1) -> [CWD]/project/vendor/schema.json
2> debug: verify/start: [CWD_URI]/source/schema.json (1/1) -> [CWD]/project/vendor/schema.json
2> Verifying      : [CWD]/project/vendor/schema.json
2> debug: verify/end: [CWD_URI]/source/schema.json (1/1) -> [CWD]/project/vendor/schema.json
2> Installed      : [CWD]/project/vendor/schema.json
EOF

COMPARE result_1.txt AGAINST expected_1.txt

COMPARE project/jsonschema.lock.json AGAINST lock_before.json

REPLACE $CWD_URI WITH '[CWD_URI]' IN result_0.txt
REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> Fetching       : [CWD_URI]/source/schema.json
2> Installed      : [CWD]/project/vendor/schema.json
EOF

COMPARE result_0.txt AGAINST expected_0.txt
