MAKE DIRECTORY source

MAKE DIRECTORY project/foo

WRITE source/user.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "string"
}
EOF

WRITE project/foo/bar UNTIL EOF
EOF

WRITE project/jsonschema.json UNTIL EOF
{
  "dependencies": {
    "[CWD_URI]/source/user.json": "./foo/bar/baz.json"
  }
}
EOF

REPLACE '\[CWD_URI\]' WITH $CWD_URI IN project/jsonschema.json

// Other input error
RUN install STDIN /dev/null IN project INTO result_0.txt EXPECTING 6

REPLACE $CWD_URI WITH '[CWD_URI]' IN result_0.txt
REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> Fetching       : [CWD_URI]/source/user.json
2> error: Failed to write schema
2>   at uri [CWD_URI]/source/user.json
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Other input error
RUN install --json STDIN /dev/null IN project INTO result_1.txt EXPECTING 6

REPLACE $CWD_URI WITH '[CWD_URI]' IN result_1.txt
REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "events": [
1>     {
1>       "type": "fetching",
1>       "uri": "[CWD_URI]/source/user.json"
1>     },
1>     {
1>       "type": "error",
1>       "uri": "[CWD_URI]/source/user.json",
1>       "message": "Failed to write schema"
1>     }
1>   ]
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt

TREE project INTO listing_0.txt
KEEP LINES MATCHING '^\./jsonschema\.lock\.json$' IN listing_0.txt

WRITE listing_expected_0.txt UNTIL EOF
EOF

COMPARE listing_0.txt AGAINST listing_expected_0.txt
