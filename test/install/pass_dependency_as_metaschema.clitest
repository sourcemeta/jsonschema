MAKE DIRECTORY source

MAKE DIRECTORY project

WRITE source/custom_meta.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "[CWD_URI]/source/custom_meta.json",
  "$vocabulary": {
    "https://json-schema.org/draft/2020-12/vocab/core": true,
    "https://json-schema.org/draft/2020-12/vocab/applicator": true,
    "https://json-schema.org/draft/2020-12/vocab/validation": true
  }
}
EOF

REPLACE '[CWD_URI]' WITH $CWD_URI IN source/custom_meta.json

WRITE source/my_schema.json UNTIL EOF
{
  "$schema": "[CWD_URI]/source/custom_meta.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    }
  }
}
EOF

REPLACE '[CWD_URI]' WITH $CWD_URI IN source/my_schema.json

WRITE project/jsonschema.json UNTIL EOF
{
  "dependencies": {
    "[CWD_URI]/source/custom_meta.json": "./vendor/custom_meta.json",
    "[CWD_URI]/source/my_schema.json": "./vendor/my_schema.json"
  }
}
EOF

REPLACE '[CWD_URI]' WITH $CWD_URI IN project/jsonschema.json

RUN install STDIN /dev/null IN project INTO result_0.txt EXPECTING 0

REPLACE $CWD_URI WITH '[CWD_URI]' IN result_0.txt
REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> Fetching       : [CWD_URI]/source/custom_meta.json
2> Installed      : [CWD]/project/vendor/custom_meta.json
2> Fetching       : [CWD_URI]/source/my_schema.json
2> Installed      : [CWD]/project/vendor/my_schema.json
EOF

COMPARE result_0.txt AGAINST expected_0.txt

COPY project/vendor/custom_meta.json TO checked_meta.json
REPLACE $CWD_URI WITH '[CWD_URI]' IN checked_meta.json
REPLACE $CWD WITH '[CWD]' IN checked_meta.json

WRITE expected_meta.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "[CWD_URI]/source/custom_meta.json",
  "$vocabulary": {
    "https://json-schema.org/draft/2020-12/vocab/core": true,
    "https://json-schema.org/draft/2020-12/vocab/applicator": true,
    "https://json-schema.org/draft/2020-12/vocab/validation": true
  }
}
EOF

COMPARE checked_meta.json AGAINST expected_meta.json

COPY project/vendor/my_schema.json TO checked_schema.json
REPLACE $CWD_URI WITH '[CWD_URI]' IN checked_schema.json
REPLACE $CWD WITH '[CWD]' IN checked_schema.json

WRITE expected_schema.json UNTIL EOF
{
  "$schema": "[CWD_URI]/source/custom_meta.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    }
  },
  "$id": "[CWD_URI]/source/my_schema.json",
  "$defs": {
    "[CWD_URI]/source/custom_meta.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "[CWD_URI]/source/custom_meta.json",
      "$vocabulary": {
        "https://json-schema.org/draft/2020-12/vocab/core": true,
        "https://json-schema.org/draft/2020-12/vocab/applicator": true,
        "https://json-schema.org/draft/2020-12/vocab/validation": true
      }
    }
  }
}
EOF

COMPARE checked_schema.json AGAINST expected_schema.json

CHECKSUM SHA256 project/vendor/custom_meta.json AS HASH_META
CHECKSUM SHA256 project/vendor/my_schema.json AS HASH_SCHEMA

COPY project/jsonschema.lock.json TO checked_lock.json
REPLACE $CWD_URI WITH '[CWD_URI]' IN checked_lock.json
REPLACE $CWD WITH '[CWD]' IN checked_lock.json

WRITE expected_lock.json UNTIL EOF
{
  "version": 1,
  "dependencies": {
    "[CWD_URI]/source/custom_meta.json": {
      "path": "./vendor/custom_meta.json",
      "hash": "[HASH_META]",
      "hashAlgorithm": "sha256"
    },
    "[CWD_URI]/source/my_schema.json": {
      "path": "./vendor/my_schema.json",
      "hash": "[HASH_SCHEMA]",
      "hashAlgorithm": "sha256"
    }
  }
}
EOF

REPLACE '[HASH_META]' WITH $HASH_META IN expected_lock.json
REPLACE '[HASH_SCHEMA]' WITH $HASH_SCHEMA IN expected_lock.json

COMPARE checked_lock.json AGAINST expected_lock.json
