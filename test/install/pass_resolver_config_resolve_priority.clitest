MAKE DIRECTORY source

MAKE DIRECTORY project

WRITE source/main.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/main",
  "$ref": "http://json-schema.org/draft-07/schema#"
}
EOF

WRITE project/local_override.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://json-schema.org/draft-07/schema#",
  "type": "string",
  "description": "from the config resolve map"
}
EOF

WRITE project/jsonschema.json UNTIL EOF
{
  "resolve": {
    "http://json-schema.org/draft-07/schema": "./local_override.json"
  },
  "dependencies": {
    "[CWD_URI]/source/main.json": "./vendor/main.json"
  }
}
EOF

REPLACE '\[CWD_URI\]' WITH $CWD_URI IN project/jsonschema.json

RUN install STDIN /dev/null IN project INTO result_0.txt EXPECTING 0

REPLACE $CWD WITH '[CWD]' IN result_0.txt
REPLACE 'file:///\[CWD\]' WITH 'file://[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> Fetching       : file://[CWD]/source/main.json
2> Installed      : [CWD]/project/vendor/main.json
EOF

COMPARE result_0.txt AGAINST expected_0.txt

WRITE expected_main.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/main",
  "$ref": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "http://json-schema.org/draft-07/schema#": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "http://json-schema.org/draft-07/schema#",
      "type": "string",
      "description": "from the config resolve map"
    }
  }
}
EOF

COMPARE project/vendor/main.json AGAINST expected_main.json

CHECKSUM SHA256 project/vendor/main.json AS HASH

COPY project/jsonschema.lock.json TO checked_lock.json
REPLACE $CWD WITH '[CWD]' IN checked_lock.json
REPLACE 'file:///\[CWD\]' WITH 'file://[CWD]' IN checked_lock.json

WRITE expected_lock.json UNTIL EOF
{
  "version": 1,
  "dependencies": {
    "file://[CWD]/source/main.json": {
      "path": "./vendor/main.json",
      "hash": "[HASH]",
      "hashAlgorithm": "sha256"
    }
  }
}
EOF

REPLACE '\[HASH\]' WITH $HASH IN expected_lock.json

COMPARE checked_lock.json AGAINST expected_lock.json
