MAKE DIRECTORY source

MAKE DIRECTORY project_fetch

MAKE DIRECTORY project_add

WRITE source/user.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "string"
}
EOF

// A resolve target that the dependency it points to has yet to create
WRITE project_fetch/jsonschema.json UNTIL EOF
{
  "dependencies": {
    "[CWD_URI]/source/user.json": "./vendor/user.json"
  },
  "resolve": {
    "https://example.com/user": "./vendor/user.json"
  }
}
EOF

REPLACE '[CWD_URI]' WITH $CWD_URI IN project_fetch/jsonschema.json

RUN install STDIN /dev/null IN project_fetch INTO result_0.txt EXPECTING 0

REPLACE $CWD_URI WITH '[CWD_URI]' IN result_0.txt
REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> Fetching       : [CWD_URI]/source/user.json
2> Installed      : [CWD]/project_fetch/vendor/user.json
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// The same target, named before the dependency that creates it exists at all
WRITE project_add/jsonschema.json UNTIL EOF
{
  "resolve": {
    "https://example.com/user": "./vendor/user.json"
  }
}
EOF

RUN install $CWD_URI/source/user.json ./vendor/user.json STDIN /dev/null IN project_add INTO result_1.txt EXPECTING 0

REPLACE $CWD_URI WITH '[CWD_URI]' IN result_1.txt
REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
2> Adding         : [CWD_URI]/source/user.json -> ./vendor/user.json
2> Fetching       : [CWD_URI]/source/user.json
2> Installed      : [CWD]/project_add/vendor/user.json
EOF

COMPARE result_1.txt AGAINST expected_1.txt
