MAKE DIRECTORY source

MAKE DIRECTORY project

WRITE source/alpha.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "string"
}
EOF

WRITE source/beta.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "integer"
}
EOF

WRITE project/jsonschema.json UNTIL EOF
{
  "dependencies": {
    "[CWD_URI]/source/alpha.json": "./vendor/alpha.json",
    "[CWD_URI]/source/beta.json": "./vendor/beta.json"
  }
}
EOF

REPLACE '\[CWD_URI\]' WITH $CWD_URI IN project/jsonschema.json

RUN install STDIN /dev/null IN project INTO result_0.txt EXPECTING 0

REPLACE $CWD WITH '[CWD]' IN result_0.txt
REPLACE 'file:///\[CWD\]' WITH 'file://[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> Fetching       : file://[CWD]/source/alpha.json
2> Installed      : [CWD]/project/vendor/alpha.json
2> Fetching       : file://[CWD]/source/beta.json
2> Installed      : [CWD]/project/vendor/beta.json
EOF

COMPARE result_0.txt AGAINST expected_0.txt

COPY project/vendor/alpha.json TO checked_alpha.json
REPLACE $CWD WITH '[CWD]' IN checked_alpha.json
REPLACE 'file:///\[CWD\]' WITH 'file://[CWD]' IN checked_alpha.json

WRITE expected_alpha.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "string",
  "$id": "file://[CWD]/source/alpha.json"
}
EOF

COMPARE checked_alpha.json AGAINST expected_alpha.json

COPY project/vendor/beta.json TO checked_beta.json
REPLACE $CWD WITH '[CWD]' IN checked_beta.json
REPLACE 'file:///\[CWD\]' WITH 'file://[CWD]' IN checked_beta.json

WRITE expected_beta.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "integer",
  "$id": "file://[CWD]/source/beta.json"
}
EOF

COMPARE checked_beta.json AGAINST expected_beta.json

CHECKSUM SHA256 project/vendor/alpha.json AS HASH_ALPHA
CHECKSUM SHA256 project/vendor/beta.json AS HASH_BETA

COPY project/jsonschema.lock.json TO checked_lock.json
REPLACE $CWD WITH '[CWD]' IN checked_lock.json
REPLACE 'file:///\[CWD\]' WITH 'file://[CWD]' IN checked_lock.json

WRITE expected_lock.json UNTIL EOF
{
  "version": 1,
  "dependencies": {
    "file://[CWD]/source/alpha.json": {
      "path": "./vendor/alpha.json",
      "hash": "[HASH_ALPHA]",
      "hashAlgorithm": "sha256"
    },
    "file://[CWD]/source/beta.json": {
      "path": "./vendor/beta.json",
      "hash": "[HASH_BETA]",
      "hashAlgorithm": "sha256"
    }
  }
}
EOF

REPLACE '\[HASH_ALPHA\]' WITH $HASH_ALPHA IN expected_lock.json
REPLACE '\[HASH_BETA\]' WITH $HASH_BETA IN expected_lock.json

COMPARE checked_lock.json AGAINST expected_lock.json
