// Invalid CLI arguments
RUN install a b c STDIN /dev/null IN . INTO result_0.txt EXPECTING 5

WRITE expected_0.txt UNTIL EOF
2> error: The install command takes either zero or two positional arguments
2>
2> For example: jsonschema install https://example.com/schema ./vendor/schema.json
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Invalid CLI arguments
RUN install --json a b c STDIN /dev/null IN . INTO result_1.txt EXPECTING 5

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "The install command takes either zero or two positional arguments"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
