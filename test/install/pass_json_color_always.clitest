MAKE DIRECTORY source

MAKE DIRECTORY project

WRITE source/user.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "string"
}
EOF

WRITE project/jsonschema.json UNTIL EOF
{
  "dependencies": {
    "[CWD_URI]/source/user.json": "./vendor/user.json"
  }
}
EOF

REPLACE '[CWD_URI]' WITH $CWD_URI IN project/jsonschema.json

RUN install --json --color always STDIN /dev/null IN project INTO result_0.txt EXPECTING 0

REPLACE $CWD_URI WITH '[CWD_URI]' IN result_0.txt
REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
1> {
1>   "events": [
1>     {
1>       "type": "fetching",
1>       "uri": "[CWD_URI]/source/user.json"
1>     },
1>     {
1>       "type": "installed",
1>       "uri": "[CWD_URI]/source/user.json",
1>       "path": "[CWD]/project/vendor/user.json"
1>     }
1>   ]
1> }
EOF

COMPARE result_0.txt AGAINST expected_0.txt

COPY project/vendor/user.json TO checked_schema.json
REPLACE $CWD_URI WITH '[CWD_URI]' IN checked_schema.json
WRITE expected_schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "string",
  "$id": "[CWD_URI]/source/user.json"
}
EOF

COMPARE checked_schema.json AGAINST expected_schema.json

// Verbose JSON execution to ensure verbose messages on stderr remain uncolored in JSON mode
RUN install --force --json --verbose --color always STDIN /dev/null IN project INTO result_1.txt EXPECTING 0

REPLACE $CWD_URI WITH '[CWD_URI]' IN result_1.txt
REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "events": [
1>     {
1>       "type": "fetching",
1>       "uri": "[CWD_URI]/source/user.json"
1>     },
1>     {
1>       "type": "installed",
1>       "uri": "[CWD_URI]/source/user.json",
1>       "path": "[CWD]/project/vendor/user.json"
1>     }
1>   ]
1> }
2> Bundling       : [CWD_URI]/source/user.json
2> Writing        : [CWD]/project/vendor/user.json
2> Verifying      : [CWD]/project/vendor/user.json
EOF

COMPARE result_1.txt AGAINST expected_1.txt
