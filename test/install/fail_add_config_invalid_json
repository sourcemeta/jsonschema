MAKE DIRECTORY project

WRITE project/jsonschema.json UNTIL EOF
NOT VALID JSON AT ALL
EOF

// Other input error
RUN install https://example.com/foo ./vendor/foo.json STDIN /dev/null IN project INTO result_0.txt EXPECTING 6
REPLACE '\\\\' WITH '/' IN result_0.txt
REPLACE '\\(?!")' WITH '/' IN result_0.txt

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: Failed to parse the JSON document
2>   at line 1
2>   at column 1
2>   at file path [CWD]/project/jsonschema.json
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Other input error
RUN install --json https://example.com/foo ./vendor/foo.json STDIN /dev/null IN project INTO result_1.txt EXPECTING 6
REPLACE '\\\\' WITH '/' IN result_1.txt
REPLACE '\\(?!")' WITH '/' IN result_1.txt

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "Failed to parse the JSON document",
1>   "line": 1,
1>   "column": 1,
1>   "filePath": "[CWD]/project/jsonschema.json"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt

TREE project INTO listing_0.txt
KEEP LINES MATCHING '^\./jsonschema\.lock\.json$' IN listing_0.txt

WRITE listing_expected_0.txt UNTIL EOF
EOF

COMPARE listing_0.txt AGAINST listing_expected_0.txt
