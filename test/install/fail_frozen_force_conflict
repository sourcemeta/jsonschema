MAKE DIRECTORY project

WRITE project/jsonschema.json UNTIL EOF
{
  "dependencies": {
    "file:///tmp/fake/schema.json": "./vendor/schema.json"
  }
}
EOF

// Invalid CLI arguments
RUN install --frozen --force STDIN /dev/null IN project INTO result_0.txt EXPECTING 5

WRITE expected_0.txt UNTIL EOF
2> error: The --frozen and --force options cannot be used together
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Invalid CLI arguments
RUN install --frozen --force --json STDIN /dev/null IN project INTO result_1.txt EXPECTING 5

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "The --frozen and --force options cannot be used together"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
