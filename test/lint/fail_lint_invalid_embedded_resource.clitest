WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test",
  "description": "Test schema",
  "examples": [ 1 ],
  "$id": "https://example.com/main",
  "$ref": "embedded",
  "$defs": {
    "embedded": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "$id": "embedded",
      "$ref": "#/definitions/foo",
      "definitions": {
        "foo": { "type": "number" }
      }
    }
  }
}
EOF

// Validation failure
RUN lint schema.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 2

WRITE expected_0.txt UNTIL EOF
1> schema.json:13:7:
1>   `definitions` was superseded by `$defs` in 2019-09 and later versions (definitions_to_defs)
1>     at location "/$defs/embedded/definitions"
1> schema.json:10:7:
1>   A `$schema` declaration without a sibling identifier (or with a sibling `$ref` in Draft 7 and older dialects), is ignored (ignored_metaschema)
1>     at location "/$defs/embedded/$schema"
EOF

COMPARE result_0.txt AGAINST expected_0.txt
