WRITE schema.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft/2020-12/schema",
  "title": "Test",
  "description": "Test schema",
  "examples": [ "foo" ],
  "type": "string"
}
EOF

// Validation failure
RUN lint schema.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 2

WRITE expected_0.txt UNTIL EOF
1> schema.json:2:3:
1>   The official dialect URI of 2019-09 and later must use "https://" instead of "http://" (modern_official_dialect_with_http)
1>     at location "/$schema"
EOF

COMPARE result_0.txt AGAINST expected_0.txt
