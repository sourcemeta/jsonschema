WRITE rule.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "enum_with_type",
  "description": "conflicting rule",
  "required": [ "type" ]
}
EOF

WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "string"
}
EOF

// Other input error
RUN lint --rule rule.json schema.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 6

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: A lint rule with this name already exists
2>   at file path [CWD]/rule.json
2>   at rule enum_with_type
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Other input error
RUN lint --rule rule.json --json schema.json STDIN /dev/null IN . INTO result_1.txt EXPECTING 6

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "A lint rule with this name already exists",
1>   "filePath": "[CWD]/rule.json",
1>   "rule": "enum_with_type"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
