WRITE rule_type.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "require_type",
  "description": "Every subschema must declare the type keyword",
  "required": [ "type" ]
}
EOF

WRITE rule_description.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "require_description",
  "description": "Every subschema must declare the description keyword",
  "required": [ "description" ]
}
EOF

WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "string"
}
EOF

// Validation failure
RUN lint --rule rule_type.json --rule rule_description.json --only require_type --only require_description --json schema.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 2

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
1> {
1>   "valid": false,
1>   "health": 0,
1>   "errors": [
1>     {
1>       "path": "[CWD]/schema.json",
1>       "id": "require_description",
1>       "message": "Every subschema must declare the description keyword",
1>       "description": "The object value was expected to define the property \"description\"",
1>       "schemaLocation": [],
1>       "position": [ 1, 1, 4, 1 ]
1>     }
1>   ]
1> }
EOF

COMPARE result_0.txt AGAINST expected_0.txt
