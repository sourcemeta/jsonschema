WRITE rule.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-06/schema#",
  "$id": "https://example.com/rule",
  "title": "my_rule",
  "description": "Test rule",
  "allOf": [
    { "$ref": "#a%2fb" }
  ],
  "definitions": {
    "target": {
      "$id": "#a-2fb",
      "not": { "type": "string" }
    }
  }
}
EOF

WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test",
  "description": "Test schema",
  "examples": [ "foo" ],
  "type": "string"
}
EOF

// Schema input error
RUN lint --rule rule.json schema.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: Could not resolve schema reference
2>   at identifier https://example.com/rule#a%2Fb
2>   at file path [CWD]/rule.json
2>   at location "/allOf/0/$ref"
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Schema input error
RUN lint --rule rule.json --json schema.json STDIN /dev/null IN . INTO result_1.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "Could not resolve schema reference",
1>   "identifier": "https://example.com/rule#a%2Fb",
1>   "filePath": "[CWD]/rule.json",
1>   "location": "/allOf/0/$ref"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
