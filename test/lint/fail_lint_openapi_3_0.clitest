// A v3.0 Schema Object is linted against its own dialect, so the rules that
// name a keyword it does not have stay quiet. There is no `const` to rewrite
// the single `enum` choice into, and no `examples` to ask the top level for

WRITE openapi.json UNTIL EOF
{
  "openapi": "3.0.3",
  "info": { "title": "Example", "version": "1.0.0" },
  "paths": {},
  "components": {
    "schemas": {
      "Pet": { "type": "string", "enum": [ "dog" ] }
    }
  }
}
EOF

// Validation failure
RUN lint openapi.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 2

WRITE expected_0.txt UNTIL EOF
1> openapi.json:7:34:
1>   Setting `type` alongside `enum` is considered an anti-pattern, as the enumeration choices already imply their respective types (enum_with_type)
1>     at location "/components/schemas/Pet/enum"
1> openapi.json:7:16:
1>   Setting `type` alongside `enum` is considered an anti-pattern, as the enumeration choices already imply their respective types (enum_with_type)
1>     at location "/components/schemas/Pet/type"
1> openapi.json:7:7:
1>   Set a concise non-empty title at the top level of the schema to explain what the definition is about (top_level_title)
1>     at location "/components/schemas/Pet"
1> openapi.json:7:7:
1>   Set a non-empty description at the top level of the schema to explain what the definition is about in detail (top_level_description)
1>     at location "/components/schemas/Pet"
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Validation failure
RUN lint openapi.json --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 2

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "valid": false,
1>   "health": 0,
1>   "errors": [
1>     {
1>       "path": "[CWD]/openapi.json",
1>       "id": "enum_with_type",
1>       "message": "Setting `type` alongside `enum` is considered an anti-pattern, as the enumeration choices already imply their respective types",
1>       "description": null,
1>       "schemaLocation": [ "components", "schemas", "Pet", "enum" ],
1>       "position": [ 7, 34, 7, 50 ]
1>     },
1>     {
1>       "path": "[CWD]/openapi.json",
1>       "id": "enum_with_type",
1>       "message": "Setting `type` alongside `enum` is considered an anti-pattern, as the enumeration choices already imply their respective types",
1>       "description": null,
1>       "schemaLocation": [ "components", "schemas", "Pet", "type" ],
1>       "position": [ 7, 16, 7, 31 ]
1>     },
1>     {
1>       "path": "[CWD]/openapi.json",
1>       "id": "top_level_title",
1>       "message": "Set a concise non-empty title at the top level of the schema to explain what the definition is about",
1>       "description": null,
1>       "schemaLocation": [ "components", "schemas", "Pet" ],
1>       "position": [ 7, 7, 7, 52 ]
1>     },
1>     {
1>       "path": "[CWD]/openapi.json",
1>       "id": "top_level_description",
1>       "message": "Set a non-empty description at the top level of the schema to explain what the definition is about in detail",
1>       "description": null,
1>       "schemaLocation": [ "components", "schemas", "Pet" ],
1>       "position": [ 7, 7, 7, 52 ]
1>     }
1>   ]
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
