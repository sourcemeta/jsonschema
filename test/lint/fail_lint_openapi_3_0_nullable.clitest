// A v3.0 schema spells its optional null with `nullable` rather than a `null`
// member of `type`, and the rules read it as such. Pinning a number between
// equal bounds leaves one value in the first schema below, but two in the
// second, so only the first is reported

WRITE openapi.json UNTIL EOF
{
  "openapi": "3.0.3",
  "info": { "title": "Example", "version": "1.0.0" },
  "paths": {},
  "components": {
    "schemas": {
      "Exact": {
        "title": "Exact",
        "description": "A quantity pinned to one number",
        "type": "integer",
        "minimum": 5,
        "maximum": 5
      },
      "ExactOrNull": {
        "title": "Exact or null",
        "description": "The same quantity, or nothing at all",
        "type": "integer",
        "nullable": true,
        "minimum": 5,
        "maximum": 5
      }
    }
  }
}
EOF

// Validation failure
RUN lint openapi.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 2

WRITE expected_0.txt UNTIL EOF
1> openapi.json:11:9:
1>   Setting `minimum` and `maximum` to the same number only leaves one possible value (equal_numeric_bounds_to_enum)
1>     at location "/components/schemas/Exact/minimum"
1> openapi.json:12:9:
1>   Setting `minimum` and `maximum` to the same number only leaves one possible value (equal_numeric_bounds_to_enum)
1>     at location "/components/schemas/Exact/maximum"
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Validation failure
RUN lint openapi.json --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 2

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "valid": false,
1>   "health": 50,
1>   "errors": [
1>     {
1>       "path": "[CWD]/openapi.json",
1>       "id": "equal_numeric_bounds_to_enum",
1>       "message": "Setting `minimum` and `maximum` to the same number only leaves one possible value",
1>       "description": null,
1>       "schemaLocation": [ "components", "schemas", "Exact", "minimum" ],
1>       "position": [ 11, 9, 11, 20 ]
1>     },
1>     {
1>       "path": "[CWD]/openapi.json",
1>       "id": "equal_numeric_bounds_to_enum",
1>       "message": "Setting `minimum` and `maximum` to the same number only leaves one possible value",
1>       "description": null,
1>       "schemaLocation": [ "components", "schemas", "Exact", "maximum" ],
1>       "position": [ 12, 9, 12, 20 ]
1>     }
1>   ]
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
