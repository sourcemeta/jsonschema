WRITE openapi.json UNTIL EOF
{
  "openapi": "3.1.1",
  "info": {
    "title": "Example",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "Pet": {
        "title": "Pet",
        "description": "A pet in the store",
        "examples": [ "dog" ],
        "type": "string",
        "const": "dog"
      }
    }
  }
}
EOF

RUN lint openapi.json --fix STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

WRITE expected_0.txt UNTIL EOF
2> .
EOF

COMPARE result_0.txt AGAINST expected_0.txt

WRITE expected_file_0.txt UNTIL EOF
{
  "openapi": "3.1.1",
  "info": {
    "title": "Example",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "Pet": {
        "title": "Pet",
        "description": "A pet in the store",
        "examples": [ "dog" ],
        "const": "dog"
      }
    }
  }
}
EOF

COMPARE openapi.json AGAINST expected_file_0.txt

WRITE openapi.json UNTIL EOF
{
  "openapi": "3.1.1",
  "info": {
    "title": "Example",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "Pet": {
        "title": "Pet",
        "description": "A pet in the store",
        "examples": [ "dog" ],
        "type": "string",
        "const": "dog"
      }
    }
  }
}
EOF

RUN lint openapi.json --fix --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 0

WRITE expected_1.txt UNTIL EOF
1> {
1>   "valid": true,
1>   "health": 100,
1>   "errors": []
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt

COMPARE openapi.json AGAINST expected_file_0.txt
