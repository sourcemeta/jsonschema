WRITE schema.json UNTIL EOF
{
  "title": "Test",
  "description": "Test schema",
  "type": "string",
  "enum": [ "foo" ]
}
EOF

WRITE jsonschema.json UNTIL EOF
{
  "defaultDialect": "http://json-schema.org/draft-04/schema#"
}
EOF

// Validation failure
RUN lint $CWD/schema.json --verbose STDIN /dev/null IN . INTO result_0.txt EXPECTING 2

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
1> schema.json:5:3:
1>   Setting `type` alongside `enum` is considered an anti-pattern, as the enumeration choices already imply their respective types (enum_with_type)
1>     at location "/enum"
1> schema.json:4:3:
1>   Setting `type` alongside `enum` is considered an anti-pattern, as the enumeration choices already imply their respective types (enum_with_type)
1>     at location "/type"
2> Using extension: .json
2> Using extension: .yaml
2> Using extension: .yml
2> Linting: [CWD]/schema.json
EOF

COMPARE result_0.txt AGAINST expected_0.txt
