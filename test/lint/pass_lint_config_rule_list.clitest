WRITE rule.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "require_type",
  "description": "Every subschema must declare the type keyword",
  "required": [ "type" ]
}
EOF

WRITE jsonschema.json UNTIL EOF
{
  "lint": {
    "rules": [
      "./rule.json"
    ]
  }
}
EOF

RUN lint --list --only require_type STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

WRITE expected_0.txt UNTIL EOF
1> require_type
1>   Every subschema must declare the type keyword
1>
1> Number of rules: 1
EOF

COMPARE result_0.txt AGAINST expected_0.txt
