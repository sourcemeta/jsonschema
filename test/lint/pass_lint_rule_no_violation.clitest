WRITE rule.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "require_type",
  "description": "Every subschema must declare the type keyword",
  "required": [ "type" ]
}
EOF

// The title, description and examples below satisfy the built-in top level
// rules, so that the custom rule is the only thing this run can trip over
WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test",
  "description": "Test schema",
  "examples": [ "foo" ],
  "type": "string"
}
EOF

RUN lint --rule rule.json schema.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

WRITE expected_0.txt UNTIL EOF
EOF

COMPARE result_0.txt AGAINST expected_0.txt
