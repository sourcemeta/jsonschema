WRITE schema.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Test",
  "description": "Test schema",
  "examples": [ "foo" ],
  "$ref": "#/definitions/string",
  "definitions": {
    "string": { "type": "string" }
  }
}
EOF

COPY schema.json TO original.json

// Schema input error
RUN lint schema.json --fix STDIN /dev/null IN . INTO result.txt EXPECTING 4

REPLACE $CWD_URI WITH '[CWD_URI]' IN result.txt
REPLACE $CWD WITH '[CWD]' IN result.txt

WRITE expected_0.txt UNTIL EOF
2> .
2> error: A schema with a top-level `$ref` in JSON Schema Draft 7 and older dialects ignores every sibling keywords (like identifiers and meta-schema declarations) and therefore many operations, like bundling, are not possible without undefined behavior
2>   at identifier [CWD_URI]/schema.json
2>   at file path [CWD]/schema.json
EOF

COMPARE result.txt AGAINST expected_0.txt

COMPARE schema.json AGAINST original.json

// Schema input error
RUN lint schema.json --fix --json STDIN /dev/null IN . INTO result_json.txt EXPECTING 4

REPLACE $CWD_URI WITH '[CWD_URI]' IN result_json.txt
REPLACE $CWD WITH '[CWD]' IN result_json.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "A schema with a top-level `$ref` in JSON Schema Draft 7 and older dialects ignores every sibling keywords (like identifiers and meta-schema declarations) and therefore many operations, like bundling, are not possible without undefined behavior",
1>   "identifier": "[CWD_URI]/schema.json",
1>   "filePath": "[CWD]/schema.json"
1> }
EOF

COMPARE result_json.txt AGAINST expected_1.txt

COMPARE schema.json AGAINST original.json
