WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test",
  "description": "Test schema",
  "examples": [ [ 1, 2, 3 ] ],
  "$id": "https://example.com",
  "items": {
    "examples": [ 1, 2, 3 ]
  }
}
EOF

RUN lint --verbose schema.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 0
