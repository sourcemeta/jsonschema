WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test",
  "description": "Test schema",
  "examples": [ "foo" ],
  "type": "string",
  "contentMediaType": "application/json",
  "enum": [ "foo" ]
}
EOF

// Validation failure
RUN lint schema.json --verbose --exclude foo_bar STDIN /dev/null IN . INTO result_0.txt EXPECTING 2
REPLACE '\\\\' WITH '/' IN result_0.txt
REPLACE '\\(?!")' WITH '/' IN result_0.txt

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
1> schema.json:7:3:
1>   The `contentMediaType` keyword is meaningless without the presence of the `contentEncoding` keyword (content_media_type_without_encoding)
1>     at location "/contentMediaType"
1> schema.json:8:3:
1>   Setting `type` alongside `enum` is considered an anti-pattern, as the enumeration choices already imply their respective types (enum_with_type)
1>     at location "/enum"
1> schema.json:6:3:
1>   Setting `type` alongside `enum` is considered an anti-pattern, as the enumeration choices already imply their respective types (enum_with_type)
1>     at location "/type"
1> schema.json:8:3:
1>   An `enum` of a single value can be expressed as `const` (enum_to_const)
1>     at location "/enum"
2> warning: Cannot exclude unknown rule: foo_bar
2> Linting: [CWD]/schema.json
EOF

COMPARE result_0.txt AGAINST expected_0.txt
