WRITE schema.json UNTIL EOF
{
  "$schema": "tag:spec.openapis.org,2024-10-18:oas/3.0/dialect",
  "type": "string"
}
EOF

// Schema input error
RUN lint schema.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: The dialect that this schema declares does not define the keyword that declares it
2>   at keyword $schema
2>   at dialect tag:spec.openapis.org,2024-10-18:oas/3.0/dialect
2>   at line 1
2>   at column 1
2>   at file path [CWD]/schema.json
2>   at location ""
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Schema input error
RUN lint schema.json --fix STDIN /dev/null IN . INTO result_1.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
2> error: The dialect that this schema declares does not define the keyword that declares it
2>   at keyword $schema
2>   at dialect tag:spec.openapis.org,2024-10-18:oas/3.0/dialect
2>   at line 1
2>   at column 1
2>   at file path [CWD]/schema.json
2>   at location ""
EOF

COMPARE result_1.txt AGAINST expected_1.txt

// Schema input error
RUN lint schema.json --json STDIN /dev/null IN . INTO result_2.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_2.txt

WRITE expected_2.txt UNTIL EOF
1> {
1>   "error": "The dialect that this schema declares does not define the keyword that declares it",
1>   "keyword": "$schema",
1>   "dialect": "tag:spec.openapis.org,2024-10-18:oas/3.0/dialect",
1>   "line": 1,
1>   "column": 1,
1>   "filePath": "[CWD]/schema.json",
1>   "location": ""
1> }
EOF

COMPARE result_2.txt AGAINST expected_2.txt

// Schema input error
RUN lint schema.json --fix --json STDIN /dev/null IN . INTO result_3.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_3.txt

WRITE expected_3.txt UNTIL EOF
1> {
1>   "error": "The dialect that this schema declares does not define the keyword that declares it",
1>   "keyword": "$schema",
1>   "dialect": "tag:spec.openapis.org,2024-10-18:oas/3.0/dialect",
1>   "line": 1,
1>   "column": 1,
1>   "filePath": "[CWD]/schema.json",
1>   "location": ""
1> }
EOF

COMPARE result_3.txt AGAINST expected_3.txt
