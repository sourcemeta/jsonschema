MAKE DIRECTORY schemas

WRITE schemas/schema1.json UNTIL EOF
{
  "title": "Schema 1",
  "description": "First schema",
  "examples": [ "foo" ],
  "type": "string",
  "$schema": "http://json-schema.org/draft-06/schema#",
  "const": "foo"
}
EOF

WRITE schemas/schema2.json UNTIL EOF
{
  "title": "Schema 2",
  "description": "Second schema",
  "examples": [ 42 ],
  "type": "number",
  "$schema": "http://json-schema.org/draft-06/schema#"
}
EOF

RUN lint schemas --fix --format STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

WRITE expected_0.txt UNTIL EOF
2> .
EOF

COMPARE result_0.txt AGAINST expected_0.txt

WRITE expected_file_1.txt UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-06/schema#",
  "title": "Schema 1",
  "description": "First schema",
  "examples": [ "foo" ],
  "const": "foo"
}
EOF

COMPARE schemas/schema1.json AGAINST expected_file_1.txt

WRITE expected_file_2.txt UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-06/schema#",
  "title": "Schema 2",
  "description": "Second schema",
  "examples": [ 42 ],
  "type": "number"
}
EOF

COMPARE schemas/schema2.json AGAINST expected_file_2.txt
