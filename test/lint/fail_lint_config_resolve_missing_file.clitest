WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test",
  "description": "Test schema",
  "examples": [ { "name": "John" } ],
  "$ref": "https://example.com/my-defs"
}
EOF

WRITE jsonschema.json UNTIL EOF
{
  "resolve": {
    "https://example.com/my-defs": "./does-not-exist.json"
  }
}
EOF

// Other input error
RUN lint schema.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 6

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: The resolve target does not exist on the filesystem
2>   at resolve path [CWD]/does-not-exist.json
2>   at line 3
2>   at column 5
2>   at file path [CWD]/jsonschema.json
2>   at location "/resolve/https:~1~1example.com~1my-defs"
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Other input error
RUN lint schema.json --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 6

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "The resolve target does not exist on the filesystem",
1>   "resolvePath": "[CWD]/does-not-exist.json",
1>   "line": 3,
1>   "column": 5,
1>   "filePath": "[CWD]/jsonschema.json",
1>   "location": "/resolve/https:~1~1example.com~1my-defs"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
