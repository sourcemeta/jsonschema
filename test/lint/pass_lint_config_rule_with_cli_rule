WRITE config_rule.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "require_type",
  "description": "Every subschema must declare the type keyword",
  "required": [ "type" ]
}
EOF

WRITE cli_rule.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "require_description",
  "description": "Every subschema must declare the description keyword",
  "required": [ "description" ]
}
EOF

WRITE jsonschema.json UNTIL EOF
{
  "lint": {
    "rules": [
      "./config_rule.json"
    ]
  }
}
EOF

WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "string",
  "description": "A string schema"
}
EOF

RUN lint --rule cli_rule.json --only require_type --only require_description schema.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

WRITE expected_0.txt UNTIL EOF
EOF

COMPARE result_0.txt AGAINST expected_0.txt
