MAKE DIRECTORY project

MAKE DIRECTORY other

WRITE project/rule.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "require_type",
  "description": "Every subschema must declare the type keyword",
  "required": [ "type" ]
}
EOF

WRITE project/jsonschema.json UNTIL EOF
{
  "lint": {
    "rules": [
      "./rule.json"
    ]
  }
}
EOF

WRITE project/schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "string"
}
EOF

RUN lint --only require_type $CWD/project/schema.json STDIN /dev/null IN other INTO result_0.txt EXPECTING 0

WRITE expected_0.txt UNTIL EOF
EOF

COMPARE result_0.txt AGAINST expected_0.txt
