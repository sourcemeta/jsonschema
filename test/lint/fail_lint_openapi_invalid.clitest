WRITE openapi.json UNTIL EOF
{
  "openapi": "3.1.1",
  "info": { "title": "Example", "version": "1.0.0" }
}
EOF

// Schema input error
RUN lint openapi.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 4

REPLACE $CWD_URI WITH '[CWD_URI]' IN result_0.txt
REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: The OpenAPI Description must declare paths, components or webhooks
2>   at line 1
2>   at column 1
2>   at file path [CWD]/openapi.json
2>   at location ""
2>   at base uri [CWD_URI]/openapi.json
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Schema input error
RUN lint openapi.json --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 4

REPLACE $CWD_URI WITH '[CWD_URI]' IN result_1.txt
REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "The OpenAPI Description must declare paths, components or webhooks",
1>   "line": 1,
1>   "column": 1,
1>   "filePath": "[CWD]/openapi.json",
1>   "location": "",
1>   "baseURI": "[CWD_URI]/openapi.json"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt

WRITE stdin_0 UNTIL EOF
{
  "openapi": "3.1.1",
  "info": { "title": "Example", "version": "1.0.0" }
}
EOF

// Schema input error
RUN lint - STDIN stdin_0 IN . INTO result_2.txt EXPECTING 4

WRITE expected_2.txt UNTIL EOF
2> error: The OpenAPI Description must declare paths, components or webhooks
2>   at line 1
2>   at column 1
2>   at file path tag:sourcemeta.com,2026:openapi/stdin
2>   at location ""
2>   at base uri tag:sourcemeta.com,2026:openapi/stdin
EOF

COMPARE result_2.txt AGAINST expected_2.txt

// Schema input error
RUN lint - --json STDIN stdin_0 IN . INTO result_3.txt EXPECTING 4

WRITE expected_3.txt UNTIL EOF
1> {
1>   "error": "The OpenAPI Description must declare paths, components or webhooks",
1>   "line": 1,
1>   "column": 1,
1>   "filePath": "tag:sourcemeta.com,2026:openapi/stdin",
1>   "location": "",
1>   "baseURI": "tag:sourcemeta.com,2026:openapi/stdin"
1> }
EOF

COMPARE result_3.txt AGAINST expected_3.txt
