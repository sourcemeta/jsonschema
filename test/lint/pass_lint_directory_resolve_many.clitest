MAKE DIRECTORY schemas

WRITE schemas/1.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Test",
  "description": "Test schema",
  "id": "https://example.com/1"
}
EOF

WRITE schemas/2.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Test",
  "description": "Test schema",
  "id": "https://example.com/2"
}
EOF

RUN lint --resolve schemas schemas --verbose STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> Linting: [CWD]/schemas/1.json
2> Linting: [CWD]/schemas/2.json
EOF

COMPARE result_0.txt AGAINST expected_0.txt
