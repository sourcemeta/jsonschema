WRITE schema.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-06/schema#",
  "title": "Test",
  "description": "Test schema",
  "examples": [ {} ],
  "properties": {
    "foo": {
      "type": "string",
      "examples": [ "foo" ]
    }
  }
}
EOF

RUN lint schema.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

WRITE expected_0.txt UNTIL EOF
EOF

COMPARE result_0.txt AGAINST expected_0.txt

WRITE expected_file_1.txt UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-06/schema#",
  "title": "Test",
  "description": "Test schema",
  "examples": [ {} ],
  "properties": {
    "foo": {
      "type": "string",
      "examples": [ "foo" ]
    }
  }
}
EOF

COMPARE schema.json AGAINST expected_file_1.txt
