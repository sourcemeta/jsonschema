WRITE jsonschema.json UNTIL EOF
{
  "lint": {
    "exclude": [ "enum_with_type" ]
  }
}
EOF

WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test",
  "description": "Test schema",
  "examples": [ "foo" ],
  "type": "string",
  "enum": [ "foo", "bar" ]
}
EOF

RUN lint --verbose --exclude enum_with_type schema.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 0
REPLACE '\\\\' WITH '/' IN result_0.txt
REPLACE '\\(?!")' WITH '/' IN result_0.txt

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> Disabling rule: enum_with_type
2> Using extension: .json
2> Using extension: .yaml
2> Using extension: .yml
2> Linting: [CWD]/schema.json
EOF

COMPARE result_0.txt AGAINST expected_0.txt
