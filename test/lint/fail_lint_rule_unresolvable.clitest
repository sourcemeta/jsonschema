WRITE rule.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "require_type",
  "description": "test",
  "$ref": "https://example.com/nonexistent"
}
EOF

WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "string"
}
EOF

// Schema input error
RUN lint --rule rule.json schema.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: Could not resolve the reference to an external schema
2>   at identifier https://example.com/nonexistent
2>   at file path [CWD]/rule.json
2>
2> This is likely because you forgot to import such schema using `--resolve/-r`
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Schema input error
RUN lint --rule rule.json --json schema.json STDIN /dev/null IN . INTO result_1.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "Could not resolve the reference to an external schema",
1>   "identifier": "https://example.com/nonexistent",
1>   "filePath": "[CWD]/rule.json"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
