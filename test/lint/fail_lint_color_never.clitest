WRITE schema.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Test",
  "description": "Test schema",
  "type": "string",
  "enum": [ "foo" ]
}
EOF

RUN lint schema.json --only enum_with_type --color never STDIN /dev/null IN . INTO result.txt EXPECTING 2

WRITE expected.txt UNTIL EOF
1> schema.json:6:3:
1>   Setting `type` alongside `enum` is considered an anti-pattern, as the enumeration choices already imply their respective types (enum_with_type)
1>     at location "/enum"
1> schema.json:5:3:
1>   Setting `type` alongside `enum` is considered an anti-pattern, as the enumeration choices already imply their respective types (enum_with_type)
1>     at location "/type"
EOF

COMPARE result.txt AGAINST expected.txt
