WRITE jsonschema.json UNTIL EOF
{
  "lint": {
    "exclude": [ "enum_with_type", "enum_to_const" ]
  }
}
EOF

WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test",
  "description": "Test schema",
  "examples": [ "foo" ],
  "type": "string",
  "enum": [ "foo" ],
  "contentMediaType": "application/json"
}
EOF

// Validation failure
RUN lint --json schema.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 2
REPLACE '\\\\' WITH '/' IN result_0.txt
REPLACE '\\(?!")' WITH '/' IN result_0.txt

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
1> {
1>   "valid": false,
1>   "health": 0,
1>   "errors": [
1>     {
1>       "path": "[CWD]/schema.json",
1>       "id": "content_media_type_without_encoding",
1>       "message": "The `contentMediaType` keyword is meaningless without the presence of the `contentEncoding` keyword",
1>       "description": null,
1>       "schemaLocation": [ "contentMediaType" ],
1>       "position": [ 8, 3, 8, 40 ]
1>     }
1>   ]
1> }
EOF

COMPARE result_0.txt AGAINST expected_0.txt
