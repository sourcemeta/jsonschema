WRITE schema.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Test",
  "description": "Test schema",
  "properties": {
    "foo": {
      "$ref": "#/definitions/object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "bar": {
      "$ref": "#/properties/foo/additionalProperties"
    }
  },
  "definitions": {
    "object": {
      "type": "object"
    }
  }
}
EOF

COPY schema.json TO original.json

// Other error
RUN lint schema.json --fix STDIN /dev/null IN . INTO result.txt EXPECTING 1

REPLACE $CWD WITH '[CWD]' IN result.txt

WRITE expected.txt UNTIL EOF
2> .
2> error: Could not autofix the schema without breaking its internal references
2>   at file path [CWD]/schema.json
2>   at location "/properties/bar/$ref"
2>
2> This is an unexpected error, as making the auto-fix functionality work in all
2> cases is tricky. We are working hard to improve the auto-fixing functionality
2> to handle all possible edge cases, but for now, try again without `--fix/-f`
2> and apply the suggestions by hand.
2>
2> Also consider consider reporting this problematic case to the issue tracker,
2> so we can add it to the test suite and fix it:
2>
2> https://github.com/sourcemeta/jsonschema/issues
EOF

COMPARE result.txt AGAINST expected.txt

// The schema must not have been modified
COMPARE schema.json AGAINST original.json
