WRITE rule.yaml UNTIL EOF
title: require_type
---
title: another
EOF

WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "string"
}
EOF

// Other input error
RUN lint --rule rule.yaml schema.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 6
REPLACE '\\\\' WITH '/' IN result_0.txt
REPLACE '\\(?!")' WITH '/' IN result_0.txt

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: Unexpected content after document
2>   at line 3
2>   at column 1
2>   at file path [CWD]/rule.yaml
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Other input error
RUN lint --rule rule.yaml --json schema.json STDIN /dev/null IN . INTO result_1.txt EXPECTING 6
REPLACE '\\\\' WITH '/' IN result_1.txt
REPLACE '\\(?!")' WITH '/' IN result_1.txt

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "Unexpected content after document",
1>   "line": 3,
1>   "column": 1,
1>   "filePath": "[CWD]/rule.yaml"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
