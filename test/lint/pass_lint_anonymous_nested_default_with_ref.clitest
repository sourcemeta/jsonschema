WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test",
  "description": "Test schema",
  "examples": [ [ "foo" ] ],
  "items": {
    "default": "foo",
    "$ref": "./other.json"
  }
}
EOF

WRITE other.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "string"
}
EOF

RUN lint schema.json --resolve other.json --verbose STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> Linting: [CWD]/schema.json
EOF

COMPARE result_0.txt AGAINST expected_0.txt
