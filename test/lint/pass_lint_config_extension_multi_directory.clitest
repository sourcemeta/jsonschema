MAKE DIRECTORY proj1/schemas

MAKE DIRECTORY proj2/schemas

WRITE proj1/jsonschema.json UNTIL EOF
{
  "extension": [ ".schema.json" ]
}
EOF

WRITE proj2/jsonschema.json UNTIL EOF
{
  "extension": [ ".spec.json" ]
}
EOF

WRITE proj1/schemas/foo.schema.json UNTIL EOF
{
  "$id": "https://example.com/foo",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Foo",
  "description": "A foo schema",
  "examples": [ "bar" ],
  "type": "string"
}
EOF

WRITE proj1/schemas/foo.test.json UNTIL EOF
{ "not": "a schema" }
EOF

WRITE proj2/schemas/bar.spec.json UNTIL EOF
{
  "$id": "https://example.com/bar",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bar",
  "description": "A bar schema",
  "examples": [ 1 ],
  "type": "integer"
}
EOF

WRITE proj2/schemas/bar.test.json UNTIL EOF
{ "not": "a schema" }
EOF

RUN lint proj1/schemas proj2/schemas --verbose STDIN /dev/null IN . INTO result_0.txt EXPECTING 0
REPLACE '\\\\' WITH '/' IN result_0.txt
REPLACE '\\(?!")' WITH '/' IN result_0.txt

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> Using extension: .schema.json
2> Using extension: .spec.json
2> Linting: [CWD]/proj1/schemas/foo.schema.json
2> Linting: [CWD]/proj2/schemas/bar.spec.json
EOF

COMPARE result_0.txt AGAINST expected_0.txt
