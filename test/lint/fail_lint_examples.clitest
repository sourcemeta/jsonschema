WRITE schema.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-06/schema#",
  "title": "Test",
  "description": "Test schema",
  "examples": [ {} ],
  "properties": {
    "foo": {
      "type": "string",
      "examples": [ 1, 2, 3 ]
    }
  }
}
EOF

// Validation failure
RUN lint schema.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 2

WRITE expected_0.txt UNTIL EOF
1> schema.json:9:21:
1>   Only include instances in the `examples` array that validate against the schema (valid_examples)
1>     at location "/properties/foo/examples/0"
1>     Invalid example instance at index 0
1>       The value was expected to be of type string but it was of type integer
1>         at instance location ""
1>         at evaluate path "/type"
EOF

COMPARE result_0.txt AGAINST expected_0.txt
