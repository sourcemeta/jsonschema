MAKE DIRECTORY schemas

WRITE schemas/foo.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-06/schema#",
  "title": "Test",
  "description": "Test schema",
  "examples": [ "foo" ],
  "type": "string",
  "enum": [ "foo", "bar", "baz" ]
}
EOF

WRITE schemas/bar.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-06/schema#",
  "title": "Test",
  "description": "Test schema",
  "examples": [ true ]
}
EOF

// Validation failure
RUN lint schemas --json STDIN /dev/null IN . INTO result_0.txt EXPECTING 2

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
1> {
1>   "valid": false,
1>   "health": 50,
1>   "errors": [
1>     {
1>       "path": "[CWD]/schemas/foo.json",
1>       "id": "enum_with_type",
1>       "message": "Setting `type` alongside `enum` is considered an anti-pattern, as the enumeration choices already imply their respective types",
1>       "description": null,
1>       "schemaLocation": [ "type" ],
1>       "position": [ 6, 3, 6, 18 ]
1>     },
1>     {
1>       "path": "[CWD]/schemas/foo.json",
1>       "id": "enum_with_type",
1>       "message": "Setting `type` alongside `enum` is considered an anti-pattern, as the enumeration choices already imply their respective types",
1>       "description": null,
1>       "schemaLocation": [ "enum" ],
1>       "position": [ 7, 3, 7, 33 ]
1>     }
1>   ]
1> }
EOF

COMPARE result_0.txt AGAINST expected_0.txt
