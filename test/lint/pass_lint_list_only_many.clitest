RUN lint --list --only then_empty --only then_without_if STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

WRITE expected_0.txt UNTIL EOF
1> then_empty
1>   Setting the `then` keyword to the empty schema does not add any further constraint
1>
1> then_without_if
1>   The `then` keyword is meaningless without the presence of the `if` keyword
1>
1> Number of rules: 2
EOF

COMPARE result_0.txt AGAINST expected_0.txt
