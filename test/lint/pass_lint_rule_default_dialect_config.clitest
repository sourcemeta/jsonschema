MAKE DIRECTORY rules

WRITE rules/jsonschema.json UNTIL EOF
{
  "defaultDialect": "https://json-schema.org/draft/2020-12/schema"
}
EOF

WRITE rules/rule.json UNTIL EOF
{
  "title": "require_type",
  "description": "Every subschema must declare the type keyword",
  "required": [ "type" ]
}
EOF

WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "string"
}
EOF

RUN lint --rule rules/rule.json --only require_type schema.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

WRITE expected_0.txt UNTIL EOF
EOF

COMPARE result_0.txt AGAINST expected_0.txt
