WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test",
  "description": "Test schema",
  "examples": [ "foo" ],
  "type": "string",
  "contentMediaType": "application/json",
  "enum": [ "foo", "bar" ]
}
EOF

// Lint violation
RUN lint schema.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 2

WRITE expected_0.txt UNTIL EOF
1> schema.json:7:3:
1>   The `contentMediaType` keyword is meaningless without the presence of the `contentEncoding` keyword (content_media_type_without_encoding)
1>     at location "/contentMediaType"
1> schema.json:8:3:
1>   Setting `type` alongside `enum` is considered an anti-pattern, as the enumeration choices already imply their respective types (enum_with_type)
1>     at location "/enum"
1> schema.json:6:3:
1>   Setting `type` alongside `enum` is considered an anti-pattern, as the enumeration choices already imply their respective types (enum_with_type)
1>     at location "/type"
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Lint violation
RUN lint schema.json --only content_media_type_without_encoding STDIN /dev/null IN . INTO result_1.txt EXPECTING 2

WRITE expected_1.txt UNTIL EOF
1> schema.json:7:3:
1>   The `contentMediaType` keyword is meaningless without the presence of the `contentEncoding` keyword (content_media_type_without_encoding)
1>     at location "/contentMediaType"
EOF

COMPARE result_1.txt AGAINST expected_1.txt
