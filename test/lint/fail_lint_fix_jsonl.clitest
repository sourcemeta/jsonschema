WRITE schemas.jsonl UNTIL EOF
{ "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "string" }
{ "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "integer" }
EOF

// Not supported
RUN lint schemas.jsonl --fix STDIN /dev/null IN . INTO result_0.txt EXPECTING 3

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: The --fix option is not supported for input with multiple documents
2>   at file path [CWD]/schemas.jsonl
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Not supported
RUN lint schemas.jsonl --fix --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 3

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "The --fix option is not supported for input with multiple documents",
1>   "filePath": "[CWD]/schemas.jsonl"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt

WRITE expected_file_0.txt UNTIL EOF
{ "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "string" }
{ "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "integer" }
EOF

COMPARE schemas.jsonl AGAINST expected_file_0.txt
