WRITE schema.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-06/schema#",
  "type": "string"
}
EOF

// Invalid CLI arguments
RUN lint schema.json --format STDIN /dev/null IN . INTO result_0.txt EXPECTING 5

WRITE expected_0.txt UNTIL EOF
2> error: The --format option requires --fix to be set
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Invalid CLI arguments
RUN lint schema.json --format --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 5

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "The --format option requires --fix to be set"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
