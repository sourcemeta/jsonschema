WRITE jsonschema.json UNTIL EOF
{
  "lint": {
    "exclude": [ "enum_with_type" ]
  }
}
EOF

WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test",
  "description": "Test schema",
  "examples": [ "foo" ],
  "type": "string",
  "enum": [ "foo", "bar" ]
}
EOF

// Validation failure
RUN lint --only enum_with_type --json schema.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 2

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
1> {
1>   "valid": false,
1>   "health": 0,
1>   "errors": [
1>     {
1>       "path": "[CWD]/schema.json",
1>       "id": "enum_with_type",
1>       "message": "Setting `type` alongside `enum` is considered an anti-pattern, as the enumeration choices already imply their respective types",
1>       "description": null,
1>       "schemaLocation": [ "type" ],
1>       "position": [ 6, 3, 6, 18 ]
1>     },
1>     {
1>       "path": "[CWD]/schema.json",
1>       "id": "enum_with_type",
1>       "message": "Setting `type` alongside `enum` is considered an anti-pattern, as the enumeration choices already imply their respective types",
1>       "description": null,
1>       "schemaLocation": [ "enum" ],
1>       "position": [ 7, 3, 7, 26 ]
1>     }
1>   ]
1> }
EOF

COMPARE result_0.txt AGAINST expected_0.txt
