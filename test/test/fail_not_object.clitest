WRITE test.json UNTIL EOF
[
  {
    "target": "https://json-schema.org/draft/2020-12/schema",
    "tests": [
      {
        "valid": true,
        "data": {}
      },
      {
        "valid": true,
        "data": { "type": 1 }
      }
    ]
  }
]
EOF

// Other input error
RUN test test.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 6

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
1> [CWD]/test.json:
2> error: The test document must be an object
2>   at line 1
2>   at column 1
2>   at file path [CWD]/test.json
2>   at location ""
2>
2> Learn more here: https://github.com/sourcemeta/jsonschema/blob/main/docs/test.markdown
EOF

COMPARE result_0.txt AGAINST expected_0.txt
