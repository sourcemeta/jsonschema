// Only the schemas of a description are reachable, so a place within it that
// holds something else reaches nothing.

WRITE openapi.json UNTIL EOF
{
  "openapi": "3.1.0",
  "info": { "title": "Example", "version": "1.0.0" },
  "paths": {},
  "components": {
    "schemas": {
      "Person": {
        "type": "object",
        "required": [ "name" ]
      }
    }
  }
}
EOF

WRITE test.json UNTIL EOF
{
  "target": "./openapi.json#/info/title",
  "tests": [
    {
      "description": "A person",
      "valid": true,
      "data": { "name": "Juan" }
    }
  ]
}
EOF

// Schema input error
RUN test test.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 4

REPLACE $CWD_URI WITH '[CWD_URI]' IN result_0.txt
REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
1> [CWD]/test.json:
2> error: This target names a place of the document that is not a schema
2>   at identifier [CWD_URI]/openapi.json#/info/title
2>   at file path [CWD]/test.json
2>
2> Use the `inspect` command to find valid schema locations
EOF

COMPARE result_0.txt AGAINST expected_0.txt
