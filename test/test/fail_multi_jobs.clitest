// The shell original ran the parallel case five times to shake out ordering
// flakes. Repetition belongs to the runner: ctest --repeat until-fail:N

WRITE schema.json UNTIL EOF
{
  "id": "https://example.com",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Test",
  "description": "Test schema",
  "type": "string"
}
EOF

MAKE DIRECTORY tests

WRITE tests/1.json UNTIL EOF
{
  "target": "https://example.com",
  "tests": [
    {
      "description": "First test",
      "valid": true,
      "data": "foo"
    }
  ]
}
EOF

WRITE tests/2.json UNTIL EOF
{
  "target": "https://example.com",
  "tests": [
    {
      "description": "First test",
      "valid": true,
      "data": "foo"
    },
    {
      "description": "First failure",
      "valid": true,
      "data": 1
    }
  ]
}
EOF

WRITE tests/3.json UNTIL EOF
{
  "target": "https://example.com",
  "tests": [
    {
      "description": "First test",
      "valid": true,
      "data": "bar"
    }
  ]
}
EOF

WRITE tests/4.json UNTIL EOF
{
  "target": "https://example.com",
  "tests": [
    {
      "description": "First test",
      "valid": true,
      "data": "baz"
    }
  ]
}
EOF

// Test assertion failure. Running in parallel, the order of the lines is not
// part of the contract
RUN test tests --resolve schema.json --jobs 3 STDIN /dev/null IN . INTO result_0.txt EXPECTING 2

REPLACE $CWD WITH '[CWD]' IN result_0.txt

SORT result_0.txt

WRITE expected_0.txt UNTIL EOF
1> [CWD]/tests/1.json: PASS 1/1
1> [CWD]/tests/2.json:
1>   2/2 FAIL First failure
1>
1> error: Schema validation failure
1>   The value was expected to be of type string but it was of type integer
1>     at instance location ""
1>     at evaluate path "/type"
1> [CWD]/tests/3.json: PASS 1/1
1> [CWD]/tests/4.json: PASS 1/1
EOF

SORT expected_0.txt

COMPARE result_0.txt AGAINST expected_0.txt

// Test assertion failure. Serially, the order is deterministic
RUN test tests --resolve schema.json --jobs 1 STDIN /dev/null IN . INTO result_1.txt EXPECTING 2

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> [CWD]/tests/1.json: PASS 1/1
1> [CWD]/tests/2.json:
1>   2/2 FAIL First failure
1>
1> error: Schema validation failure
1>   The value was expected to be of type string but it was of type integer
1>     at instance location ""
1>     at evaluate path "/type"
1> [CWD]/tests/3.json: PASS 1/1
1> [CWD]/tests/4.json: PASS 1/1
EOF

COMPARE result_1.txt AGAINST expected_1.txt
