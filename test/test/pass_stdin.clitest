WRITE schema.json UNTIL EOF
{
  "id": "https://example.com",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "string"
}
EOF

WRITE stdin_0 UNTIL EOF
{
  "target": "https://example.com",
  "tests": [
    {
      "description": "A string",
      "valid": true,
      "data": "foo"
    },
    {
      "description": "Not a string",
      "valid": false,
      "data": 1
    }
  ]
}
EOF

RUN test - --resolve schema.json STDIN stdin_0 IN . INTO result_0.txt EXPECTING 0

WRITE expected_0.txt UNTIL EOF
1> tag:sourcemeta.com,2026:jsonschema/stdin: PASS 2/2
EOF

COMPARE result_0.txt AGAINST expected_0.txt
