// An instance read from a file reports where in that file each failing value
// sits, so a nested failure can be found by line and column.

WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/person",
  "type": "object",
  "properties": {
    "address": {
      "type": "object",
      "properties": { "zip": { "type": "string" } }
    }
  }
}
EOF

WRITE instance.json UNTIL EOF
{
  "address": {
    "zip": 12345
  }
}
EOF

WRITE test.json UNTIL EOF
{
  "target": "https://example.com/person",
  "tests": [
    {
      "description": "Nested failure",
      "valid": true,
      "dataPath": "./instance.json"
    }
  ]
}
EOF

// Test assertion failure
RUN test test.json --resolve schema.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 2

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
1> [CWD]/test.json:
1>   1/1 FAIL Nested failure
1>
1> error: Schema validation failure
1>   The value was expected to be of type string but it was of type integer
1>     at instance location "/address/zip" (line 3, column 5)
1>     at evaluate path "/properties/address/properties/zip/type"
1>   The object value was expected to validate against the single defined property subschema
1>     at instance location "/address" (line 2, column 3)
1>     at evaluate path "/properties/address/properties"
1>   The object value was expected to validate against the single defined property subschema
1>     at instance location "" (line 1, column 1)
1>     at evaluate path "/properties"
EOF

COMPARE result_0.txt AGAINST expected_0.txt
