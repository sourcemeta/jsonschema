WRITE schema.json UNTIL EOF
{
  "id": "https://example.com/two",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "string"
}
EOF

WRITE test.json UNTIL EOF
{
  "target": [
    "https://example.com/missing",
    "https://example.com/two"
  ],
  "tests": [
    {
      "valid": true,
      "data": "foo"
    }
  ]
}
EOF

// Schema input error
RUN test test.json --resolve schema.json --verbose --jobs 1 STDIN /dev/null IN . INTO result_0.txt EXPECTING 4
REPLACE '\\\\' WITH '/' IN result_0.txt
REPLACE '\\(?!")' WITH '/' IN result_0.txt

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
1> [CWD]/test.json:
2> Using parallelism: 1
2> error: Could not resolve the reference to an external schema
2>   at identifier https://example.com/missing
2>   at file path [CWD]/test.json
2>
2> This is likely because you forgot to import such schema using `--resolve/-r`
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Schema input error
RUN test test.json --resolve schema.json --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 4
REPLACE '\\\\' WITH '/' IN result_1.txt
REPLACE '\\(?!")' WITH '/' IN result_1.txt

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "Could not resolve the reference to an external schema",
1>   "identifier": "https://example.com/missing",
1>   "filePath": "[CWD]/test.json"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
