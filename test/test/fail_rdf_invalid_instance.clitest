WRITE schema.json UNTIL EOF
{
  "$id": "https://example.com",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "x-jsonld-type": "https://schema.org/Person",
  "properties": {
    "name": { "type": "string", "x-jsonld-id": "https://schema.org/name" }
  }
}
EOF

WRITE test.json UNTIL EOF
{
  "target": "https://example.com",
  "tests": [
    {
      "description": "Invalid instance",
      "valid": true,
      "data": { "name": 1 },
      "rdf": []
    }
  ]
}
EOF

// Validation failure
RUN test test.json --resolve schema.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 2

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
1> [CWD]/test.json:
1>   1/1 FAIL Invalid instance
1>
1> error: Schema validation failure
1>   The value was expected to be of type string but it was of type integer
1>     at instance location "/name"
1>     at evaluate path "/properties/name/type"
1>   The object value was expected to validate against the single defined property subschema
1>     at instance location ""
1>     at evaluate path "/properties"
EOF

COMPARE result_0.txt AGAINST expected_0.txt
