// One suite may name targets living in documents of different kinds, as what a
// target resolves to is settled one target at a time.

WRITE openapi.json UNTIL EOF
{
  "openapi": "3.1.0",
  "info": { "title": "Example", "version": "1.0.0" },
  "paths": {},
  "components": {
    "schemas": {
      "Person": {
        "type": "object",
        "required": [ "name" ],
        "properties": { "name": { "type": "string" } }
      }
    }
  }
}
EOF

WRITE schema.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [ "name" ]
}
EOF

WRITE test.json UNTIL EOF
{
  "target": [
    "./openapi.json#/components/schemas/Person",
    "./schema.json"
  ],
  "tests": [
    {
      "description": "A person",
      "valid": true,
      "data": { "name": "Juan" }
    },
    {
      "description": "Missing name",
      "valid": false,
      "data": {}
    }
  ]
}
EOF

RUN test test.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
1> [CWD]/test.json: PASS 4/4
EOF

COMPARE result_0.txt AGAINST expected_0.txt
