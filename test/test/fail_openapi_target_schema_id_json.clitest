WRITE openapi.json UNTIL EOF
{
  "openapi": "3.1.0",
  "info": { "title": "Example", "version": "1.0.0" },
  "paths": {},
  "components": {
    "schemas": {
      "Person": {
        "$id": "https://example.com/person",
        "type": "object",
        "required": [ "name" ]
      }
    }
  }
}
EOF

WRITE test.json UNTIL EOF
{
  "target": "https://example.com/person",
  "tests": [
    {
      "description": "A person",
      "valid": true,
      "data": { "name": "Juan" }
    }
  ]
}
EOF

// Schema input error
RUN test test.json --resolve openapi.json --json STDIN /dev/null IN . INTO result_0.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
1> {
1>   "error": "This identifier is declared by a Schema Object of an imported OpenAPI description, so only that description can reach it",
1>   "identifier": "https://example.com/person",
1>   "line": 7,
1>   "column": 7,
1>   "filePath": "[CWD]/openapi.json",
1>   "location": "/components/schemas/Person"
1> }
EOF

COMPARE result_0.txt AGAINST expected_0.txt
