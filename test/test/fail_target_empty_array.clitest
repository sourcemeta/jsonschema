WRITE test.json UNTIL EOF
{
  "target": [],
  "tests": [
    {
      "valid": true,
      "data": {}
    }
  ]
}
EOF

// Other input error
RUN test test.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 6

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
1> [CWD]/test.json:
2> error: The test document `target` array must contain at least one URI
2>   at line 2
2>   at column 3
2>   at file path [CWD]/test.json
2>   at location "/target"
2>
2> Learn more here: https://github.com/sourcemeta/jsonschema/blob/main/docs/test.markdown
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Other input error
RUN test test.json --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 6

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "The test document `target` array must contain at least one URI",
1>   "line": 2,
1>   "column": 3,
1>   "filePath": "[CWD]/test.json",
1>   "location": "/target"
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
