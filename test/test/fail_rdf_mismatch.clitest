WRITE schema.json UNTIL EOF
{
  "$id": "https://example.com",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "x-jsonld-type": "https://schema.org/Person",
  "properties": {
    "name": { "type": "string", "x-jsonld-id": "https://schema.org/name" }
  }
}
EOF

WRITE test.json UNTIL EOF
{
  "target": "https://example.com",
  "tests": [
    {
      "description": "Wrong expectation",
      "valid": true,
      "data": { "name": "Ada" },
      "rdf": [
        {
          "@type": [ "https://schema.org/Person" ],
          "https://schema.org/name": [ { "@value": "Grace" } ]
        }
      ]
    }
  ]
}
EOF

// Validation failure
RUN test test.json --resolve schema.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 2

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
1> [CWD]/test.json:
1>   1/1 FAIL Wrong expectation
1>
1> error: RDF expansion mismatch
1>   at line 8
1>   at column 7
1>   at file path [CWD]/test.json
1>   at location "/tests/0/rdf"
1>
1> [
1>   {
1>     "@type": [ "https://schema.org/Person" ],
1>     "https://schema.org/name": [
1>       {
1>         "@value": "Ada"
1>       }
1>     ]
1>   }
1> ]
EOF

COMPARE result_0.txt AGAINST expected_0.txt
