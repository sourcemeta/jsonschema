WRITE test.json UNTIL EOF
{
  "target": "https://example.com/unknown",
  "tests": [
    {
      "valid": true,
      "data": {}
    }
  ]
}
EOF

// Schema input error
RUN test test.json --json STDIN /dev/null IN . INTO result_0.txt EXPECTING 4
REPLACE '\\\\' WITH '/' IN result_0.txt
REPLACE '\\(?!")' WITH '/' IN result_0.txt

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
1> {
1>   "error": "Could not resolve the reference to an external schema",
1>   "identifier": "https://example.com/unknown",
1>   "filePath": "[CWD]/test.json"
1> }
EOF

COMPARE result_0.txt AGAINST expected_0.txt
