WRITE schema.json UNTIL EOF
{
  "id": "https://example.com",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Test",
  "description": "Test schema",
  "allOf": [
    {
      "anyOf": [
        { "required": [ "foo" ] },
        { "required": [ "bar" ] }
      ]
    },
    {
      "type": "integer"
    }
  ]
}
EOF

WRITE test.json UNTIL EOF
{
  "target": "https://example.com",
  "tests": [
    {
      "valid": true,
      "data": { "bar": 1 }
    }
  ]
}
EOF

// Validation failure
RUN test test.json --resolve schema.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 2
REPLACE '\\\\' WITH '/' IN result_0.txt
REPLACE '\\(?!")' WITH '/' IN result_0.txt

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
1> [CWD]/test.json:
1>   1/1 FAIL <no description>
1>
1> error: Schema validation failure
1>   The value was expected to be of type integer but it was of type object
1>     at instance location ""
1>     at evaluate path "/allOf/1/type"
1>   The object value was expected to validate against the 2 given subschemas
1>     at instance location ""
1>     at evaluate path "/allOf"
EOF

COMPARE result_0.txt AGAINST expected_0.txt
