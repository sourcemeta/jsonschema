WRITE schema.yaml UNTIL EOF
id: https://example.com
$schema: http://json-schema.org/draft-04/schema#
type: string
EOF

WRITE test.yaml UNTIL EOF
target: https://example.com
tests:
- valid: true
  data: foo
- valid: false
  data: 1
EOF

RUN test test.yaml --resolve schema.yaml --verbose --jobs 1 STDIN /dev/null IN . INTO result_0.txt EXPECTING 0
REPLACE '\\\\' WITH '/' IN result_0.txt
REPLACE '\\(?!")' WITH '/' IN result_0.txt

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
1> [CWD]/test.yaml:
1>   1/2 PASS <no description>
1>   2/2 PASS <no description>
2> Using parallelism: 1
EOF

COMPARE result_0.txt AGAINST expected_0.txt
