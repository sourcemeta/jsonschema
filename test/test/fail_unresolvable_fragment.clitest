WRITE schema.json UNTIL EOF
{
  "id": "https://example.com",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Test",
  "description": "Test schema",
  "definitions": {
    "foo": { "type": "string" },
    "bar": { "type": "integer" }
  }
}
EOF

WRITE test.json UNTIL EOF
{
  "target": "https://example.com#/foo",
  "tests": [
    {
      "valid": true,
      "data": {}
    },
    {
      "valid": true,
      "data": { "type": 1 }
    }
  ]
}
EOF

// Schema input error
RUN test test.json --resolve schema.json --verbose --jobs 1 STDIN /dev/null IN . INTO result_0.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
1> [CWD]/test.json:
2> Using parallelism: 1
2> error: This target names a place that the document does not hold
2>   at identifier https://example.com#/foo
2>   at file path [CWD]/test.json
2>
2> Use the `inspect` command to find valid schema locations
EOF

COMPARE result_0.txt AGAINST expected_0.txt
