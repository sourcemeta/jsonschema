// An expected RDF expansion is asserted against a Schema Object the same way
// it is against a schema, as the annotations it needs are collected either way.

WRITE openapi.json UNTIL EOF
{
  "openapi": "3.1.0",
  "info": { "title": "Example", "version": "1.0.0" },
  "paths": {},
  "components": {
    "schemas": {
      "Person": {
        "type": "object",
        "x-jsonld-type": "https://schema.org/Person",
        "properties": {
          "name": { "type": "string", "x-jsonld-id": "https://schema.org/name" }
        }
      }
    }
  }
}
EOF

WRITE test.json UNTIL EOF
{
  "target": "./openapi.json#/components/schemas/Person",
  "tests": [
    {
      "description": "A person promotes",
      "valid": true,
      "data": { "name": "Ada" },
      "rdf": [
        {
          "@type": [ "https://schema.org/Person" ],
          "https://schema.org/name": [ { "@value": "Ada" } ]
        }
      ]
    }
  ]
}
EOF

RUN test test.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
1> [CWD]/test.json: PASS 1/1
EOF

COMPARE result_0.txt AGAINST expected_0.txt
