MAKE DIRECTORY tests

WRITE schema.json UNTIL EOF
{
  "id": "https://example.com",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Test",
  "description": "Test schema",
  "type": "string"
}
EOF

WRITE tests/1.json UNTIL EOF
{
  "target": "https://example.com",
  "tests": [
    {
      "description": "First test",
      "valid": true,
      "data": "foo"
    }
  ]
}
EOF

WRITE tests/2.json UNTIL EOF
{
  "target": "https://example.com",
  "tests": []
}
EOF

WRITE tests/3.json UNTIL EOF
{
  "target": "https://example.com",
  "tests": [
    {
      "description": "First test",
      "valid": true,
      "data": "bar"
    }
  ]
}
EOF

// Other input error
RUN test tests --resolve schema.json --json --jobs 2 STDIN /dev/null IN . INTO result_0.txt EXPECTING 6

COPY result_0.txt TO output.json
KEEP LINES MATCHING '^1>' IN output.json
REPLACE '^1> ?' WITH '' IN output.json

REPLACE $VERSION WITH '[VERSION]' IN result_0.txt
DROP LINES MATCHING '"duration":' IN result_0.txt
DROP LINES MATCHING '"start":' IN result_0.txt
DROP LINES MATCHING '"stop":' IN result_0.txt
DROP LINES MATCHING '"threadId":' IN result_0.txt
DROP LINES MATCHING '"duration":' IN result_0.txt
DROP LINES MATCHING '"start":' IN result_0.txt
DROP LINES MATCHING '"stop":' IN result_0.txt
DROP LINES MATCHING '"threadId":' IN result_0.txt
REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
1> {
1>   "reportFormat": "CTRF",
1>   "specVersion": "0.0.0",
1>   "results": {
1>     "tool": {
1>       "name": "jsonschema",
1>       "version": "[VERSION]"
1>     },
1>     "summary": {
1>       "tests": 2,
1>       "passed": 2,
1>       "failed": 0,
1>       "pending": 0,
1>       "skipped": 0,
1>       "other": 0,
1>     },
1>     "tests": [
1>       {
1>         "name": "First test",
1>         "status": "passed",
1>         "suite": [ "https://example.com" ],
1>         "type": "unit",
1>         "filePath": "[CWD]/tests/1.json",
1>         "line": 4,
1>         "retries": 0,
1>         "flaky": false,
1>       },
1>       {
1>         "name": "First test",
1>         "status": "passed",
1>         "suite": [ "https://example.com" ],
1>         "type": "unit",
1>         "filePath": "[CWD]/tests/3.json",
1>         "line": 4,
1>         "retries": 0,
1>         "flaky": false,
1>       }
1>     ]
1>   }
1> }
EOF

COMPARE result_0.txt AGAINST expected_0.txt

RUN validate $CTRF_SCHEMA output.json STDIN /dev/null IN . INTO result_1.txt EXPECTING 0

// Other input error
RUN test tests --resolve schema.json --json --jobs 1 STDIN /dev/null IN . INTO result_2.txt EXPECTING 6

COPY result_2.txt TO output.json
KEEP LINES MATCHING '^1>' IN output.json
REPLACE '^1> ?' WITH '' IN output.json

REPLACE $VERSION WITH '[VERSION]' IN result_2.txt
DROP LINES MATCHING '"duration":' IN result_2.txt
DROP LINES MATCHING '"start":' IN result_2.txt
DROP LINES MATCHING '"stop":' IN result_2.txt
DROP LINES MATCHING '"threadId":' IN result_2.txt
DROP LINES MATCHING '"duration":' IN result_2.txt
DROP LINES MATCHING '"start":' IN result_2.txt
DROP LINES MATCHING '"stop":' IN result_2.txt
DROP LINES MATCHING '"threadId":' IN result_2.txt
REPLACE $CWD WITH '[CWD]' IN result_2.txt

WRITE expected_2.txt UNTIL EOF
1> {
1>   "reportFormat": "CTRF",
1>   "specVersion": "0.0.0",
1>   "results": {
1>     "tool": {
1>       "name": "jsonschema",
1>       "version": "[VERSION]"
1>     },
1>     "summary": {
1>       "tests": 2,
1>       "passed": 2,
1>       "failed": 0,
1>       "pending": 0,
1>       "skipped": 0,
1>       "other": 0,
1>     },
1>     "tests": [
1>       {
1>         "name": "First test",
1>         "status": "passed",
1>         "suite": [ "https://example.com" ],
1>         "type": "unit",
1>         "filePath": "[CWD]/tests/1.json",
1>         "line": 4,
1>         "retries": 0,
1>         "flaky": false,
1>       },
1>       {
1>         "name": "First test",
1>         "status": "passed",
1>         "suite": [ "https://example.com" ],
1>         "type": "unit",
1>         "filePath": "[CWD]/tests/3.json",
1>         "line": 4,
1>         "retries": 0,
1>         "flaky": false,
1>       }
1>     ]
1>   }
1> }
EOF

COMPARE result_2.txt AGAINST expected_2.txt

RUN validate $CTRF_SCHEMA output.json STDIN /dev/null IN . INTO result_3.txt EXPECTING 0

WRITE expected_1.txt UNTIL EOF
EOF

COMPARE result_1.txt AGAINST expected_1.txt

WRITE expected_3.txt UNTIL EOF
EOF

COMPARE result_3.txt AGAINST expected_3.txt
