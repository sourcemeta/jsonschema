// A description that names itself answers to that name as well as to where it
// was read from, and a target may spell either to reach the schemas it holds.

WRITE openapi.json UNTIL EOF
{
  "openapi": "3.2.0",
  "$self": "https://example.com/api",
  "info": { "title": "Example", "version": "1.0.0" },
  "paths": {},
  "components": {
    "schemas": {
      "Person": {
        "$anchor": "person",
        "type": "object",
        "required": [ "name" ]
      }
    }
  }
}
EOF

WRITE test.json UNTIL EOF
{
  "target": [
    "./openapi.json#/components/schemas/Person",
    "./openapi.json#person",
    "https://example.com/api#/components/schemas/Person",
    "https://example.com/api#person"
  ],
  "tests": [
    {
      "description": "A person",
      "valid": true,
      "data": { "name": "Juan" }
    },
    {
      "description": "Missing name",
      "valid": false,
      "data": {}
    }
  ]
}
EOF

RUN test test.json --resolve openapi.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
1> [CWD]/test.json: PASS 8/8
EOF

COMPARE result_0.txt AGAINST expected_0.txt
