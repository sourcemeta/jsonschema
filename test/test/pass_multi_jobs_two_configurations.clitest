// The shell original ran the parallel case five times to shake out ordering
// flakes. Repetition belongs to the runner: ctest --repeat until-fail:N

MAKE DIRECTORY schemas

MAKE DIRECTORY alpha/tests

MAKE DIRECTORY beta/tests

WRITE schemas/alpha.json UNTIL EOF
{
  "id": "https://example.com/alpha",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "string"
}
EOF

WRITE schemas/beta.json UNTIL EOF
{
  "$id": "https://example.com/beta",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "integer"
}
EOF

WRITE alpha/jsonschema.json UNTIL EOF
{
  "defaultDialect": "http://json-schema.org/draft-04/schema#",
  "resolve": {
    "https://example.com": "https://example.com/alpha"
  }
}
EOF

WRITE alpha/tests/test.json UNTIL EOF
{
  "target": "https://example.com",
  "tests": [
    {
      "description": "First test",
      "valid": true,
      "data": "foo"
    },
    {
      "description": "Second test",
      "valid": false,
      "data": 1
    }
  ]
}
EOF

WRITE beta/jsonschema.json UNTIL EOF
{
  "defaultDialect": "https://json-schema.org/draft/2020-12/schema",
  "resolve": {
    "https://example.com": "https://example.com/beta"
  }
}
EOF

WRITE beta/tests/test.json UNTIL EOF
{
  "target": "https://example.com",
  "tests": [
    {
      "description": "First test",
      "valid": true,
      "data": 1
    },
    {
      "description": "Second test",
      "valid": false,
      "data": "foo"
    }
  ]
}
EOF

// Running in parallel, the order of the lines is not part of the contract
RUN test alpha/tests beta/tests --resolve schemas --jobs 2 STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

REPLACE $CWD WITH '[CWD]' IN result_0.txt

SORT result_0.txt

WRITE expected_0.txt UNTIL EOF
1> [CWD]/alpha/tests/test.json: PASS 2/2
1> [CWD]/beta/tests/test.json: PASS 2/2
EOF

SORT expected_0.txt

COMPARE result_0.txt AGAINST expected_0.txt

// Serially, the order is deterministic
RUN test alpha/tests beta/tests --resolve schemas --jobs 1 STDIN /dev/null IN . INTO result_1.txt EXPECTING 0

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> [CWD]/alpha/tests/test.json: PASS 2/2
1> [CWD]/beta/tests/test.json: PASS 2/2
EOF

COMPARE result_1.txt AGAINST expected_1.txt
