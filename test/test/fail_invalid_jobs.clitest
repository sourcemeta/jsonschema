WRITE test.json UNTIL EOF
{
  "target": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "string"
  },
  "tests": [
    { "valid": true, "data": "hello" }
  ]
}
EOF

// Invalid CLI arguments
RUN test test.json --jobs 0 STDIN /dev/null IN . INTO result_0.txt EXPECTING 5

WRITE expected_0.txt UNTIL EOF
2> error: The --jobs option must be a positive integer
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Invalid CLI arguments
RUN test test.json --jobs foo STDIN /dev/null IN . INTO result_1.txt EXPECTING 5

WRITE expected_1.txt UNTIL EOF
2> error: The --jobs option must be a positive integer
EOF

COMPARE result_1.txt AGAINST expected_1.txt

// Invalid CLI arguments
RUN test test.json --jobs 0 --json STDIN /dev/null IN . INTO result_2.txt EXPECTING 5

WRITE expected_2.txt UNTIL EOF
1> {
1>   "error": "The --jobs option must be a positive integer"
1> }
EOF

COMPARE result_2.txt AGAINST expected_2.txt

// Invalid CLI arguments
RUN test test.json --jobs foo --json STDIN /dev/null IN . INTO result_3.txt EXPECTING 5

WRITE expected_3.txt UNTIL EOF
1> {
1>   "error": "The --jobs option must be a positive integer"
1> }
EOF

COMPARE result_3.txt AGAINST expected_3.txt
