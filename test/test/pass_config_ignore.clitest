MAKE DIRECTORY tests

MAKE DIRECTORY tests/ignored

WRITE schema.json UNTIL EOF
{
  "id": "https://example.com",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Test",
  "description": "Test schema",
  "type": "string"
}
EOF

WRITE tests/good.json UNTIL EOF
{
  "target": "https://example.com",
  "tests": [
    {
      "description": "A string is valid",
      "valid": true,
      "data": "foo"
    }
  ]
}
EOF

WRITE tests/ignored/bad.json UNTIL EOF
{
  "target": "https://example.com",
  "tests": [
    {
      "description": "A number is not valid",
      "valid": true,
      "data": 42
    }
  ]
}
EOF

WRITE jsonschema.json UNTIL EOF
{
  "path": "./tests",
  "ignore": [
    "./tests/ignored"
  ]
}
EOF

RUN test --resolve schema.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
1> [CWD]/tests/good.json: PASS 1/1
EOF

COMPARE result_0.txt AGAINST expected_0.txt
