MAKE DIRECTORY tests

WRITE schema.json UNTIL EOF
{
  "id": "https://example.com",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Test",
  "description": "Test schema",
  "type": "string"
}
EOF

WRITE tests/1.json UNTIL EOF
{
  "target": "https://example.com",
  "tests": [
    {
      "description": "First test",
      "valid": true,
      "data": "foo"
    }
  ]
}
EOF

WRITE tests/2.json UNTIL EOF
{
  "target": "https://example.com",
  "tests": [
    {
      "description": "First test",
      "valid": true,
      "data": "bar"
    }
  ]
}
EOF

WRITE tests/3.json UNTIL EOF
{
  "target": "https://example.com"
}
EOF

WRITE tests/4.json UNTIL EOF
{
  "target": "https://example.com",
  "tests": [
    {
      "description": "First test",
      "valid": true,
      "data": "baz"
    }
  ]
}
EOF

// Other input error
RUN test tests --resolve schema.json --json --jobs 1 STDIN /dev/null IN . INTO result_0.txt EXPECTING 6
REPLACE '\\\\' WITH '/' IN result_0.txt
REPLACE '\\(?!")' WITH '/' IN result_0.txt

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
1> {
1>   "error": "The test document must contain a `tests` property",
1>   "line": 1,
1>   "column": 1,
1>   "filePath": "[CWD]/tests/3.json",
1>   "location": ""
1> }
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Other input error
RUN test tests --resolve schema.json --json --jobs 4 STDIN /dev/null IN . INTO result_1.txt EXPECTING 6
REPLACE '\\\\' WITH '/' IN result_1.txt
REPLACE '\\(?!")' WITH '/' IN result_1.txt

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "The test document must contain a `tests` property",
1>   "line": 1,
1>   "column": 1,
1>   "filePath": "[CWD]/tests/3.json",
1>   "location": ""
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
