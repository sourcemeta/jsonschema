// A description reads the same whichever format it was written in.

WRITE openapi.yaml UNTIL EOF
openapi: "3.1.0"
info:
  title: Example
  version: "1.0.0"
paths: {}
components:
  schemas:
    Person:
      type: object
      required:
        - name
      properties:
        name:
          type: string
EOF

WRITE test.json UNTIL EOF
{
  "target": "./openapi.yaml#/components/schemas/Person",
  "tests": [
    {
      "description": "A person",
      "valid": true,
      "data": { "name": "Juan" }
    },
    {
      "description": "Missing name",
      "valid": false,
      "data": {}
    }
  ]
}
EOF

RUN test test.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
1> [CWD]/test.json: PASS 2/2
EOF

COMPARE result_0.txt AGAINST expected_0.txt
