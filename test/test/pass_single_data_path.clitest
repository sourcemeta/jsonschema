WRITE schema.json UNTIL EOF
{
  "id": "https://example.com",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Test",
  "description": "Test schema",
  "type": "string"
}
EOF

WRITE data-valid.json UNTIL EOF
"Hello World"
EOF

WRITE data-invalid.json UNTIL EOF
{ "type": "Hello World" }
EOF

WRITE test.json UNTIL EOF
{
  "target": "https://example.com",
  "tests": [
    {
      "description": "First test",
      "valid": true,
      "dataPath": "./data-valid.json"
    },
    {
      "description": "Second test",
      "valid": false,
      "dataPath": "./data-invalid.json"
    }
  ]
}
EOF

RUN test test.json --resolve schema.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 0
REPLACE '\\\\' WITH '/' IN result_0.txt
REPLACE '\\(?!")' WITH '/' IN result_0.txt

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
1> [CWD]/test.json: PASS 2/2
EOF

COMPARE result_0.txt AGAINST expected_0.txt
