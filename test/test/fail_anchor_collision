WRITE schema.json UNTIL EOF
{
  "$id": "https://example.com/anchor-collision-schema",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$anchor": "foo",
  "properties": {
    "bar": {
      "$anchor": "foo"
    }
  }
}
EOF

WRITE test.json UNTIL EOF
{
  "target": "https://example.com/anchor-collision-schema",
  "tests": [
    {
      "description": "Test case",
      "valid": true,
      "data": "hello"
    }
  ]
}
EOF

// Schema input error
RUN test test.json --resolve schema.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 4
REPLACE '\\\\' WITH '/' IN result_0.txt
REPLACE '\\(?!")' WITH '/' IN result_0.txt

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
2> error: Schema anchor already exists
2>   at identifier https://example.com/anchor-collision-schema#foo
2>   at line 6
2>   at column 5
2>   at file path [CWD]/schema.json
2>   at location "/properties/bar"
2>   at other location ""
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Schema input error
RUN test test.json --resolve schema.json --json STDIN /dev/null IN . INTO result_1.txt EXPECTING 4
REPLACE '\\\\' WITH '/' IN result_1.txt
REPLACE '\\(?!")' WITH '/' IN result_1.txt

REPLACE $CWD WITH '[CWD]' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> {
1>   "error": "Schema anchor already exists",
1>   "identifier": "https://example.com/anchor-collision-schema#foo",
1>   "line": 6,
1>   "column": 5,
1>   "filePath": "[CWD]/schema.json",
1>   "location": "/properties/bar",
1>   "otherLocation": ""
1> }
EOF

COMPARE result_1.txt AGAINST expected_1.txt
