// The shell original ran the parallel case five times to shake out ordering
// flakes, and asserted only the last line of standard output. Repetition
// belongs to the runner: ctest --repeat until-fail:N

WRITE schema.json UNTIL EOF
{
  "id": "https://example.com",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Test",
  "description": "Test schema",
  "type": "string"
}
EOF

MAKE DIRECTORY tests

WRITE tests/1.json UNTIL EOF
{
  "target": "https://example.com",
  "tests": [
    {
      "description": "First test",
      "valid": true,
      "data": "foo"
    }
  ]
}
EOF

WRITE tests/2.json UNTIL EOF
{
  "target": "https://example.com",
  "tests": [
    {
      "description": "First test",
      "valid": true,
      "data": "bar"
    }
  ]
}
EOF

WRITE tests/3.json UNTIL EOF
{
  "target": "https://example.com"
}
EOF

WRITE tests/4.json UNTIL EOF
{
  "target": "https://example.com",
  "tests": [
    {
      "description": "First test",
      "valid": true,
      "data": "baz"
    }
  ]
}
EOF

// Other input error. Serially the run aborts before reaching the fourth file
RUN test tests --resolve schema.json --jobs 1 STDIN /dev/null IN . INTO result_0.txt EXPECTING 6

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
1> [CWD]/tests/1.json: PASS 1/1
1> [CWD]/tests/2.json: PASS 1/1
1> [CWD]/tests/3.json:
2> error: The test document must contain a `tests` property
2>   at line 1
2>   at column 1
2>   at file path [CWD]/tests/3.json
2>   at location ""
2>
2> Learn more here: https://github.com/sourcemeta/jsonschema/blob/main/docs/test.markdown
EOF

COMPARE result_0.txt AGAINST expected_0.txt

// Other input error. In parallel, whether each passing file finishes before
// the parse error aborts the run is a race, so drop those lines and assert
// every line that is deterministic
RUN test tests --resolve schema.json --jobs 4 STDIN /dev/null IN . INTO result_1.txt EXPECTING 6

REPLACE $CWD WITH '[CWD]' IN result_1.txt

DROP LINES MATCHING ': PASS 1/1$' IN result_1.txt

WRITE expected_1.txt UNTIL EOF
1> [CWD]/tests/3.json:
2> error: The test document must contain a `tests` property
2>   at line 1
2>   at column 1
2>   at file path [CWD]/tests/3.json
2>   at location ""
2>
2> Learn more here: https://github.com/sourcemeta/jsonschema/blob/main/docs/test.markdown
EOF

COMPARE result_1.txt AGAINST expected_1.txt
