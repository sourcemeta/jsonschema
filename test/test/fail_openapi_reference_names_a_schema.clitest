// A reference of the description itself names a place of another description,
// so one pointing at a plain schema is turned down.

WRITE plain.json UNTIL EOF
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "string"
}
EOF

WRITE openapi.json UNTIL EOF
{
  "openapi": "3.1.0",
  "info": { "title": "Example", "version": "1.0.0" },
  "paths": {
    "/people": { "$ref": "./plain.json" }
  }
}
EOF

WRITE test.json UNTIL EOF
{
  "target": "./openapi.json#/components/schemas/Person",
  "tests": [
    {
      "description": "A person",
      "valid": true,
      "data": { "name": "Juan" }
    }
  ]
}
EOF

// Schema input error
RUN test test.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 4

REPLACE $CWD_URI WITH '[CWD_URI]' IN result_0.txt
REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
1> [CWD]/test.json:
2> error: This reference must name a place within the document it points at
2>   at identifier [CWD_URI]/plain.json
2>   at file path [CWD]/test.json
2>   at location "/paths/~1people/$ref"
2>   at base uri [CWD_URI]/openapi.json
EOF

COMPARE result_0.txt AGAINST expected_0.txt
