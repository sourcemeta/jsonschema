// A Schema Object is named by a pointer into the description that holds it. The
// identifier it declares of its own names nothing on its own, as what answers
// to a URI is a document rather than a schema sitting inside one.

WRITE openapi.json UNTIL EOF
{
  "openapi": "3.1.0",
  "info": { "title": "Example", "version": "1.0.0" },
  "paths": {},
  "components": {
    "schemas": {
      "Person": {
        "$id": "https://example.com/person",
        "type": "object",
        "required": [ "name" ]
      }
    }
  }
}
EOF

WRITE test.json UNTIL EOF
{
  "target": "https://example.com/person",
  "tests": [
    {
      "description": "A person",
      "valid": true,
      "data": { "name": "Juan" }
    }
  ]
}
EOF

// Schema input error
RUN test test.json --resolve openapi.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 4

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
1> [CWD]/test.json:
2> error: This identifier is declared by a Schema Object of an imported OpenAPI description, so only that description can reach it
2>   at identifier https://example.com/person
2>   at line 7
2>   at column 7
2>   at file path [CWD]/openapi.json
2>   at location "/components/schemas/Person"
2>
2> Name a Schema Object of the description instead, as in `#/components/schemas/MySchema`
EOF

COMPARE result_0.txt AGAINST expected_0.txt
