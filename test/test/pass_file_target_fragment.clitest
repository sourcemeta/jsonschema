WRITE schema.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Test",
  "description": "Test schema",
  "items": {
    "type": "string"
  }
}
EOF

WRITE test.json UNTIL EOF
{
  "target": "./schema.json#/items",
  "$comment": "A random comment",
  "tests": [
    {
      "valid": true,
      "data": "foo"
    },
    {
      "valid": false,
      "data": 1
    }
  ]
}
EOF

RUN test test.json --resolve schema.json --verbose --jobs 1 STDIN /dev/null IN . INTO result_0.txt EXPECTING 0

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
1> [CWD]/test.json:
1>   1/2 PASS <no description>
1>   2/2 PASS <no description>
2> Using parallelism: 1
EOF

COMPARE result_0.txt AGAINST expected_0.txt
