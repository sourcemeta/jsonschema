WRITE test.json UNTIL EOF
{
  "target": "http://json-schema.org/draft-04/schema#",
  "tests": [
    {
      "valid": true,
      "dataPath": 1
    }
  ]
}
EOF

// Other input error
RUN test test.json STDIN /dev/null IN . INTO result_0.txt EXPECTING 6

REPLACE $CWD WITH '[CWD]' IN result_0.txt

WRITE expected_0.txt UNTIL EOF
1> [CWD]/test.json:
2> error: Test case documents must set the `dataPath` property to a string
2>   at line 6
2>   at column 7
2>   at file path [CWD]/test.json
2>   at location "/tests/0/dataPath"
2>
2> Learn more here: https://github.com/sourcemeta/jsonschema/blob/main/docs/test.markdown
EOF

COMPARE result_0.txt AGAINST expected_0.txt
